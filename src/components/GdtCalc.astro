---
// GD&T arithmetic in three tabs: bonus tolerance and virtual condition for a feature of size (with a measured position
// check), the fastener formulas with and without a projected tolerance zone, and the radial gland of an O-ring groove
// when its runout to the pilot is added. Maths in src/lib/gdt.ts (unit-tested); UI only here.
const TABS = [{ key: 'bonus', name: 'Bonus tolerance' }, { key: 'fast', name: 'Fastener patterns' }, { key: 'gland', name: 'Seal gland' }];
---

<div class="calc gdcalc" data-gdcalc>
  <div class="calc-head"><span>GD&amp;T</span><span class="head-btns"><span>bonus · fasteners · gland</span></span></div>
  <div class="hc-tabs" role="tablist" aria-label="GD&T check">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="bonus">
        <legend>Feature of size with a position tolerance</legend>
        <div class="row2">
          <label>Feature<select name="b_kind"><option value="hole">Hole</option><option value="pin">Pin or boss</option></select></label>
          <label>Material condition<select name="b_mod"><option value="MMC">MMC</option><option value="LMC">LMC</option><option value="RFS">RFS (none)</option></select></label>
          <label>Smallest size (mm)<input name="b_min" type="number" step="any" value="11.0" /></label>
          <label>Largest size (mm)<input name="b_max" type="number" step="any" value="11.2" /></label>
          <label>Position tolerance ⌀ (mm)<input name="b_tol" type="number" min="0" step="any" value="0.5" /></label>
          <label>Actual size (mm)<input name="b_act" type="number" step="any" value="11.15" /></label>
          <label>Measured Δx (mm)<input name="b_dx" type="number" step="any" value="0.18" /></label>
          <label>Measured Δy (mm)<input name="b_dy" type="number" step="any" value="0.21" /></label>
        </div>
        <p class="hint">Δx and Δy: the measured axis from its true position, in the datum reference frame.</p>
      </fieldset>

      <fieldset data-panel="fast" hidden>
        <legend>Fastener pattern</legend>
        <div class="row2">
          <label>Fastening<select name="f_type"><option value="fixed">Fixed — one part threaded</option><option value="floating">Floating — clearance holes in both</option></select></label>
          <label>Fastener, largest ⌀ (mm)<input name="f_F" type="number" min="0" step="any" value="10" /></label>
          <label>Clearance hole at MMC ⌀ (mm)<input name="f_H" type="number" min="0" step="any" value="11.0" /></label>
          <label>Clearance holes' tolerance ⌀ (mm)<input name="f_t1" type="number" min="0" step="any" value="0.5" /></label>
          <label>Projection: clamped part (mm)<input name="f_P" type="number" min="0" step="any" value="24" /></label>
          <label>Thread engagement, least (mm)<input name="f_D" type="number" min="0.1" step="any" value="15" /></label>
        </div>
        <p class="hint">Fixed: the projection is the thickness of the part with clearance holes — how far the fastener stands out of its threaded hole.</p>
      </fieldset>

      <fieldset data-panel="gland" hidden>
        <legend>Radial O-ring gland</legend>
        <div class="row2">
          <label>Bore, smallest (mm)<input name="g_bmin" type="number" step="any" value="150.000" /></label>
          <label>Bore, largest (mm)<input name="g_bmax" type="number" step="any" value="150.063" /></label>
          <label>Pilot, smallest (mm)<input name="g_pmin" type="number" step="any" value="149.860" /></label>
          <label>Pilot, largest (mm)<input name="g_pmax" type="number" step="any" value="149.900" /></label>
          <label>Groove root, smallest (mm)<input name="g_rmin" type="number" step="any" value="141.45" /></label>
          <label>Groove root, largest (mm)<input name="g_rmax" type="number" step="any" value="141.55" /></label>
          <label>Groove runout to the pilot (mm)<input name="g_run" type="number" min="0" step="any" value="0.05" /></label>
          <label>Ring section, smallest (mm)<input name="g_cmin" type="number" min="0" step="any" value="5.20" /></label>
          <label>Ring section, largest (mm)<input name="g_cmax" type="number" min="0" step="any" value="5.46" /></label>
        </div>
        <p class="hint">Runout as full indicator movement, or a diametral position tolerance — either moves the groove off its pilot by half. Defaults: the O-ring page's nozzle-to-case seal.</p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected GD&T check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    ASME Y14.5 conventions. Bonus tolerance and virtual condition for an MMC- or LMC-modified feature of size; fastener
    formulas from the standard's appendix; gland depth over every combination of limits, with squeeze from the ring section
    alone.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .gdcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .gdcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { featureOfSize, positionFromXY, floatingTolerance, fixedTotal, holeWithoutProjection, glandRange, type FeatureKind, type Modifier } from '../lib/gdt';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 3) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const pc = (v: number) => `${f(100 * v, 1)}%`;
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-gdcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const halo = { stroke: 'var(--rd-panel)', 'stroke-width': 4, 'paint-order': 'stroke', 'stroke-linejoin': 'round' };
    let mode = 'bonus';
    let draw: (() => void) | null = null;

    // ---- chart helpers (as in the hand-calc calculator) ----
    const nice = (span: number) => { const m = 10 ** Math.floor(Math.log10(span / 5)); return [1, 2, 2.5, 5, 10].map((x) => x * m).find((x) => span / x <= 6)!; };
    function frame(o: { x0: number; x1: number; y0: number; y1: number; xl: string; yl: string; noY?: boolean }) {
      svg.replaceChildren();
      const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 250, L = 64, R = 20, T = 30, B = 40;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const X = (v: number) => L + ((v - o.x0) / (o.x1 - o.x0)) * (W - L - R), Y = (v: number) => T + ((o.y1 - v) / (o.y1 - o.y0)) * (H - T - B);
      let sx = nice(o.x1 - o.x0);
      while ((o.x1 - o.x0) / sx > (W - L - R) / 46) sx *= 2; // keep tick labels apart on narrow charts
      const sy = nice(o.y1 - o.y0), dp = (s: number) => (s >= 1 ? 0 : s >= 0.1 ? 1 : s >= 0.01 ? 2 : 3);
      const z = (v: number) => (Math.abs(v) < 1e-12 ? 0 : v), xFirst = Math.ceil(o.x0 / sx - 1e-9) * sx;
      for (let v = xFirst; v <= o.x1 + 1e-9; v += sx) {
        el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: 'var(--rd-line)' });
        el('text', { x: X(v), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sx)));
      }
      for (let v = Math.ceil(o.y0 / sy - 1e-9) * sy; v <= o.y1 + 1e-9; v += sy) {
        if (o.noY || (Math.abs(v - o.y0) < 1e-9 && Math.abs(xFirst - o.x0) < 1e-9)) continue;
        el('text', { x: L - 6, y: Y(v) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sy)));
      }
      el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, o.xl);
      el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, o.yl);
      return { X, Y, W, H, L, R, T, B };
    }
    const poly = (pts: [number, number][], color: string, w = 2.2, dash = '') =>
      el('polyline', { points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), fill: 'none', stroke: color, 'stroke-width': w, ...(dash ? { 'stroke-dasharray': dash } : {}) });
    const legend = (items: [string, string, string?][]) => {
      let x = 8;
      for (const [name, color, dash] of items) {
        el('line', { x1: x, x2: x + 18, y1: 13, y2: 13, stroke: color, 'stroke-width': 2.2, ...(dash ? { 'stroke-dasharray': dash } : {}) });
        el('text', { x: x + 23, y: 17, 'font-size': 12, fill: 'var(--rd-ink)' }, name);
        x += 37 + name.length * 7.2;
      }
    };
    const dot = (x: number, y: number, color: string, r = 4.5) => el('circle', { cx: x, cy: y, r, fill: color, stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });

    // ---- bonus tolerance ----
    function runBonus(rows: Row[], notes: [string, string][]) {
      const kind = field('b_kind').value as FeatureKind, mod = field('b_mod').value as Modifier;
      const lo = num('b_min'), hi = num('b_max'), tol = num('b_tol'), act = num('b_act'), dx = num('b_dx'), dy = num('b_dy');
      if (!(hi > lo && tol >= 0 && Number.isFinite(act))) { notes.push(['bad', 'Enter size limits (largest above smallest), a tolerance and the actual size.']); return null; }
      const r = featureOfSize(kind, lo, hi, tol, mod, act);
      const measured = Number.isFinite(dx) && Number.isFinite(dy) ? positionFromXY(dx, dy) : NaN;
      rows.push({ dt: 'Allowed position tolerance', dd: `⌀${f(r.allowed)} <small>${r.inLimits ? `stated ⌀${f(tol)} + bonus ${f(r.bonus)} at ⌀${f(act)}` : `the size ⌀${f(act)} is outside its limits — the feature is rejected on size`}</small>`, primary: true, cls: r.inLimits ? '' : 'bad' });
      if (Number.isFinite(measured)) {
        const ok = r.inLimits && measured <= r.allowed + 1e-12;
        rows.push({ dt: 'Measured position', dd: `⌀${f(measured)} <small>2√(Δx² + Δy²) · ${ok ? 'conforms' : 'does not conform'}${ok && measured > tol ? ' — only because of the bonus' : ''}</small>`, cls: ok ? 'ok' : 'bad' });
      }
      rows.push(
        { dt: 'Virtual condition', dd: `⌀${f(r.virtual)} <small>${mod === 'RFS' ? 'the boundary at MMC; without a modifier no fixed gauge can check it' : `the worst-case boundary — a functional gauge ${kind === 'hole' ? 'pin' : 'ring'} of this size`}</small>` },
        { dt: 'Resultant condition', dd: `⌀${f(r.resultant)} <small>the opposite extreme — what wall thickness and edge distance must allow for</small>` },
      );
      if (mod === 'MMC') notes.push(['', `At MMC the feature fits with the least clearance, so it gets the least tolerance. As it departs towards LMC the clearance grows, and so may the position error — up to ⌀${f(r.maxAllowed)} at LMC, with the mating part still assembling.`]);
      if (mod === 'RFS') notes.push(['', 'Regardless of feature size: the tolerance never grows. Use it where the feature locates something precisely, not just clears it.']);
      if (mod === 'LMC') notes.push(['', 'LMC protects a minimum wall or edge distance — the bonus grows as the feature moves towards MMC, where there is more material.']);
      return () => {
        const span = hi - lo, x0 = lo - 0.25 * span, x1 = hi + 0.25 * span;
        const ys = [r.maxAllowed, tol, Number.isFinite(measured) ? measured : 0];
        const c = frame({ x0, x1, y0: 0, y1: Math.max(...ys) * 1.25, xl: 'actual size ⌀ (mm)', yl: 'position tolerance ⌀ (mm)' });
        const allow = (s: number) => featureOfSize(kind, lo, hi, tol, mod, s).allowed;
        const pts: [number, number][] = [[c.X(lo), c.Y(0)], ...[lo, hi].map((s) => [c.X(s), c.Y(allow(s))] as [number, number]), [c.X(hi), c.Y(0)]];
        el('polygon', { points: pts.map(([x, y]) => `${x},${y}`).join(' '), fill: 'var(--rd-ok)', 'fill-opacity': 0.12 });
        poly([[c.X(lo), c.Y(allow(lo))], [c.X(hi), c.Y(allow(hi))]], 'var(--rd-blue)');
        [lo, hi].forEach((s) => el('line', { x1: c.X(s), x2: c.X(s), y1: c.T, y2: c.H - c.B, stroke: 'var(--rd-warn)', 'stroke-dasharray': '3 3' }));
        el('text', { x: c.X(r.mmc) + (r.mmc === lo ? 4 : -4), y: c.T + 12, 'text-anchor': r.mmc === lo ? 'start' : 'end', 'font-size': 12, fill: 'var(--rd-warn)', ...halo }, 'MMC');
        el('text', { x: c.X(r.lmc) + (r.lmc === lo ? 4 : -4), y: c.T + 12, 'text-anchor': r.lmc === lo ? 'start' : 'end', 'font-size': 12, fill: 'var(--rd-warn)', ...halo }, 'LMC');
        if (Number.isFinite(measured)) dot(c.X(Math.max(x0, Math.min(x1, act))), c.Y(measured), r.inLimits && measured <= r.allowed + 1e-12 ? 'var(--rd-ok)' : 'var(--rd-accent)', 5);
        legend([['allowed', 'var(--rd-blue)']]);
      };
    }

    // ---- fasteners ----
    function runFast(rows: Row[], notes: [string, string][]) {
      const type = field('f_type').value, F = num('f_F'), H = num('f_H'), t1 = num('f_t1'), P = num('f_P') || 0, D = num('f_D');
      if (!(H > F && F > 0)) { notes.push(['bad', 'The clearance hole at MMC must be larger than the fastener.']); return null; }
      let segs: { name: string; parts: [string, number, string][] }[] = [];
      if (type === 'floating') {
        const T = floatingTolerance(H, F);
        rows.push({ dt: 'Each part', dd: `⌀${f(T)} at MMC <small>T = H − F, for the clearance holes in both parts</small>`, primary: true });
        notes.push(['', 'Floating fasteners pass through clearance holes in both parts, held by nuts: each part can use the whole clearance.']);
        segs = [{ name: 'each part', parts: [['F', F, 'var(--rd-line)'], ['T', T, 'var(--rd-blue)']] }];
      } else {
        const T = fixedTotal(H, F), t2 = T - (Number.isFinite(t1) ? t1 : T / 2), t1v = T - t2;
        const k = 1 + (2 * P) / D, t2no = t2 / k, Hno = holeWithoutProjection(F, t1v, t2, P, D);
        rows.push(
          { dt: 'Shared between the parts', dd: `⌀${f(T)} <small>T₁ + T₂ = H − F</small>` },
          { dt: 'Threaded holes, projected zone', dd: `⌀${f(t2)} <small>with a projected tolerance zone ${f(P, 0)} mm high — the zone sits where the fastener actually is</small>`, primary: true, cls: t2 > 0 ? 'ok' : 'bad' },
          { dt: 'Without a projected zone', dd: `⌀${f(t2no)} <small>for the same hole — or keep ⌀${f(t2)} and open the clearance hole to ⌀${f(Hno)}</small>`, cls: 'warn' },
        );
        if (t2 <= 0) notes.push(['bad', 'The clearance holes take all the tolerance: nothing is left for the threaded holes. Tighten the clearance holes or open them up.']);
        notes.push(['', `A threaded hole that leans carries the fastener with it, and the error grows over the ${f(P, 0)} mm the fastener stands out. Specify the projected tolerance zone on threaded holes, press-fit pins and studs.`]);
        segs = [
          { name: 'zone', parts: [['F', F, 'var(--rd-line)'], ['T₁', t1v, 'var(--rd-blue)'], ['T₂', t2, 'var(--rd-ok)']] },
          { name: 'no zone', parts: [['F', F, 'var(--rd-line)'], ['T₁', t1v, 'var(--rd-blue)'], ['T₂', t2 * k, 'var(--rd-accent)']] },
        ];
      }
      return () => {
        const tops = segs.map((s) => s.parts.reduce((a, p) => a + p[1], 0)), x1 = Math.max(H, ...tops) * 1.04, x0 = F * 0.9;
        const c = frame({ x0, x1, y0: 0, y1: segs.length + 0.6, xl: 'diameter (mm)', yl: '', noY: true });
        segs.forEach((s, i) => {
          let x = x0; const y = c.Y(segs.length - i - 0.15), h = c.Y(0) - c.Y(0.6);
          s.parts.forEach(([name, v, color]) => {
            const a = Math.max(x, x0), b = name === 'F' ? F : x + v;
            if (b > a) el('rect', { x: c.X(a), y, width: Math.max(1, c.X(b) - c.X(a)), height: h, fill: color, 'fill-opacity': name === 'F' ? 0.5 : 0.8 });
            if (name !== 'F' && c.X(b) - c.X(a) > 22) el('text', { x: (c.X(a) + c.X(b)) / 2, y: y + h / 2 + 4, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-panel)' }, name);
            x = name === 'F' ? F : x + v;
          });
          el('text', { x: c.L - 6, y: y + h / 2 + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)' }, s.name);
        });
        el('line', { x1: c.X(H), x2: c.X(H), y1: c.T, y2: c.H - c.B, stroke: 'var(--rd-ink)', 'stroke-width': 1.6 });
        el('text', { x: c.X(H) - 4, y: c.T + 12, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)', ...halo }, 'hole at MMC');
      };
    }

    // ---- seal gland ----
    function runGland(rows: Row[], notes: [string, string][]) {
      const g = { boreMin: num('g_bmin'), boreMax: num('g_bmax'), plugMin: num('g_pmin'), plugMax: num('g_pmax'), rootMin: num('g_rmin'), rootMax: num('g_rmax'), runout: num('g_run') || 0, csMin: num('g_cmin'), csMax: num('g_cmax') };
      if (!(g.boreMax >= g.boreMin && g.plugMax >= g.plugMin && g.rootMax >= g.rootMin && g.csMax >= g.csMin && g.boreMin > g.plugMax && g.plugMin > g.rootMax && g.csMin > 0)) { notes.push(['bad', 'Check the limits: bore larger than pilot, pilot larger than groove root, smallest below largest.']); return null; }
      const r = glandRange(g), r0 = glandRange({ ...g, runout: 0 });
      rows.push(
        { dt: 'Minimum squeeze', dd: `${pc(r.squeezeMin)} <small>smallest ring in the deepest local gland · ${pc(r0.squeezeMin)} with the groove coaxial</small>`, primary: true, cls: r.squeezeMin < r0.squeezeMin - 1e-9 ? 'warn' : '' },
        { dt: 'Maximum squeeze', dd: `${pc(r.squeezeMax)} <small>largest ring in the shallowest local gland</small>` },
        { dt: 'Gland depth', dd: `${f(r.gMin)} – ${f(r.gMax)} mm <small>nominal ${f(r.gNom)} mm, round the circumference and over every limit</small>` },
        { dt: 'Largest offset', dd: `${f(r.eMax)} mm <small>half the pilot clearance plus half the runout</small>` },
        { dt: 'What the runout costs', dd: `${f(100 * (r0.squeezeMin - r.squeezeMin), 2)} points <small>of minimum squeeze, from ${f(g.runout)} mm of runout</small>` },
      );
      notes.push(['', 'Geometric squeeze only: stretch onto the groove, temperature, swell and compression set come off this — see <a href="../../seals/o-ring-design/">O-ring design</a>. The runout adds to the eccentricity exactly as a looser pilot would.']);
      notes.push(['', 'A groove with no runout or position on the drawing falls to the title block\'s general tolerance — often far looser than the seal can take.']);
      return () => {
        const th = Array.from({ length: 73 }, (_, i) => i * 5);
        const low = (run: number) => { const e = (g.boreMax - g.plugMin) / 2 + run / 2, m = (g.boreMax - g.rootMin) / 2; return th.map((t) => (g.csMin - (m + e * Math.cos((t * Math.PI) / 180))) / g.csMin); };
        const high = (run: number) => { const e = (g.boreMax - g.plugMin) / 2 + run / 2, m = (g.boreMax - g.rootMax) / 2; return th.map((t) => (g.csMax - (m - e * Math.cos((t * Math.PI) / 180))) / g.csMax); };
        const L1 = low(g.runout), H1 = high(g.runout), L0 = low(0), H0 = high(0);
        const all = [...L1, ...H1], lo = Math.min(...all), hi = Math.max(...all), pad = 0.1 * (hi - lo);
        const c = frame({ x0: 0, x1: 360, y0: 100 * (lo - pad), y1: 100 * (hi + pad), xl: 'position round the groove (°)', yl: 'squeeze (%)' });
        poly(th.map((t, i) => [c.X(t), c.Y(100 * H0[i])]), 'var(--rd-blue)', 1.4, '4 3');
        poly(th.map((t, i) => [c.X(t), c.Y(100 * L0[i])]), 'var(--rd-blue)', 1.4, '4 3');
        poly(th.map((t, i) => [c.X(t), c.Y(100 * H1[i])]), 'var(--rd-accent)');
        poly(th.map((t, i) => [c.X(t), c.Y(100 * L1[i])]), 'var(--rd-accent)');
        dot(c.X(0), c.Y(100 * r.squeezeMin), 'var(--rd-accent)', 4);
        legend([['with runout', 'var(--rd-accent)'], ['coaxial', 'var(--rd-blue)', '4 3']]);
      };
    }

    const RUN: Record<string, typeof runBonus> = { bonus: runBonus, fast: runFast, gland: runGland };
    const CAPS: Record<string, string> = {
      bonus: 'The tolerance allowed at each actual size — the dynamic tolerance diagram. Anything in the shaded area conforms; the dot is the measured feature.',
      fast: 'How the clearance between hole and fastener is spent: the fastener, the clearance holes\' tolerance, and the threaded holes\' — magnified when there is no projected zone.',
      gland: 'Squeeze round the circumference for the two worst combinations of limits — the upper curve with the largest ring in the shallowest gland, the lower with the smallest ring in the deepest. Dashed: the same with the groove coaxial to its pilot.',
    };

    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 120); });
    form.addEventListener('change', run);
    run();
  });
</script>
