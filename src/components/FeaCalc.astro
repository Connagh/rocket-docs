---
// Checking a finite-element model, in four tabs: mesh convergence (on a small built-in model of the case's clamped edge,
// or on your own three results), equilibrium and far-field checks, stress at details (singular corners, averaged and
// unaveraged peaks, weld hot spots), and strain-gauge rosettes for comparing with a test.
// Maths in src/lib/fea.ts (unit-tested); UI only here.
const TABS = [{ key: 'conv', name: 'Mesh convergence' }, { key: 'free', name: 'Equilibrium & far field' }, { key: 'detail', name: 'Stress at details' }, { key: 'gauge', name: 'Strain gauges' }];
---

<div class="calc fecalc" data-fecalc>
  <div class="calc-head"><span>Model checks</span><span class="head-btns"><span>before the report</span></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Model check">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="conv">
        <legend>Three meshes</legend>
        <label>Results from<select name="v_mode"><option value="model">The case-edge model on this page</option><option value="yours">Your own model</option></select></label>
        <div class="row2" data-sub="model">
          <label>Pressure (MPa)<input name="m_p" type="number" min="0" step="any" value="10" /></label>
          <label>Mean radius (mm)<input name="m_r" type="number" min="1" step="any" value="150.69" /></label>
          <label>Wall (mm)<input name="m_t" type="number" min="0.01" step="any" value="1.377" /></label>
          <label>E (MPa)<input name="m_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Poisson's ratio<input name="m_nu" type="number" min="0" max="0.49" step="any" value="0.29" /></label>
          <label>Coarsest element (mm)<input name="m_h" type="number" min="0.1" step="any" value="16" /></label>
          <label>Refinement ratio<input name="m_rr" type="number" min="1.2" max="4" step="any" value="2" /></label>
        </div>
        <div class="row2" data-sub="yours" hidden>
          <label>Finest result<input name="y_f1" type="number" step="any" value="2205.4" /></label>
          <label>Element size (mm)<input name="y_h1" type="number" min="0" step="any" value="4" /></label>
          <label>Medium result<input name="y_f2" type="number" step="any" value="2108.5" /></label>
          <label>Element size (mm)<input name="y_h2" type="number" min="0" step="any" value="8" /></label>
          <label>Coarsest result<input name="y_f3" type="number" step="any" value="1811.1" /></label>
          <label>Element size (mm)<input name="y_h3" type="number" min="0" step="any" value="16" /></label>
        </div>
        <p class="hint" data-sub="model">A real model: the case wall as cubic elements on an elastic foundation, clamped at a rigid flange, solved in your browser. Its exact answer is known.</p>
        <p class="hint" data-sub="yours" hidden>The same quantity, at the same point, from three meshes refined everywhere it matters — ideally by a constant ratio of about 1.3 or more.</p>
      </fieldset>

      <fieldset data-panel="free" hidden>
        <legend>What the model reports, against what it must</legend>
        <div class="row2">
          <label>Pressure (MPa)<input name="q_p" type="number" min="0" step="any" value="10" /></label>
          <label>End seal or bore ⌀ (mm)<input name="q_D" type="number" min="0" step="any" value="300" /></label>
          <label>Model's axial reaction (kN)<input name="q_R" type="number" step="any" value="0" /></label>
          <label>Mean radius (mm)<input name="q_r" type="number" min="1" step="any" value="150.69" /></label>
          <label>Wall (mm)<input name="q_t" type="number" min="0.01" step="any" value="1.377" /></label>
          <label>E (MPa)<input name="q_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Poisson's ratio<input name="q_nu" type="number" min="0" max="0.5" step="any" value="0.29" /></label>
          <label>Model's hoop stress (MPa)<input name="q_s" type="number" step="any" value="1094.3" /></label>
          <label>Model's radial growth (mm)<input name="q_w" type="number" step="any" value="0.804" /></label>
        </div>
        <p class="hint">Far-field values: read them well away from ends, joints and openings. A closed vessel's reaction must equal pressure times the area inside the end seal.</p>
      </fieldset>

      <fieldset data-panel="detail" hidden>
        <legend>Peaks and corners</legend>
        <div class="row2">
          <label>Corner's interior angle (°)<input name="d_ang" type="number" min="90" max="360" step="any" value="270" /></label>
          <label>Mesh halvings<input name="d_n" type="number" min="1" max="8" step="1" value="5" /></label>
          <label>Peak, nodal-averaged (MPa)<input name="d_avg" type="number" step="any" value="410" /></label>
          <label>Peak, element value (MPa)<input name="d_un" type="number" step="any" value="455" /></label>
          <label>Weld: stress 0.4t from toe (MPa)<input name="d_s04" type="number" step="any" value="300" /></label>
          <label>Weld: stress 1.0t from toe (MPa)<input name="d_s10" type="number" step="any" value="250" /></label>
        </div>
        <p class="hint">270° is a sharp 90° internal corner; 360° is a crack; up to 180° is not singular. Peaks and weld stresses here are illustrative.</p>
      </fieldset>

      <fieldset data-panel="gauge" hidden>
        <legend>Rectangular rosette, 0°/45°/90°</legend>
        <div class="row2">
          <label>Gauge a, 0° (µε)<input name="g_a" type="number" step="any" value="1260" /></label>
          <label>Gauge b, 45° (µε)<input name="g_b" type="number" step="any" value="3170" /></label>
          <label>Gauge c, 90° (µε)<input name="g_c" type="number" step="any" value="4950" /></label>
          <label>E (MPa)<input name="g_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Poisson's ratio<input name="g_nu" type="number" min="0" max="0.5" step="any" value="0.29" /></label>
          <label>Model σ<sub>1</sub> (MPa)<input name="g_m1" type="number" step="any" value="1204" placeholder="optional" /></label>
          <label>Model σ<sub>2</sub> (MPa)<input name="g_m2" type="number" step="any" value="602" placeholder="optional" /></label>
        </div>
        <p class="hint">Readings are illustrative. Compare with the model's value averaged over the gauge length, on the same surface.</p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected model check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Convergence: Richardson extrapolation and the grid convergence index (Roache; Celik et al.). Edge model: thin-shell
    axisymmetric bending as a beam on an elastic foundation, Hermite elements. Corners: Williams' opening-mode exponent.
    Weld hot spot: IIW fine-mesh extrapolation. Rosettes: plane stress.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .fecalc .readout dd small { display: block; margin-top: 0.15rem; }
  .fecalc .nc { text-transform: none; } /* uppercase labels would turn σ and λ into capitals */
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .fecalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { edgeModel, edgeExact, richardson, williamsLambda, hotSpot, rosette } from '../lib/fea';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const g3 = (v: number) => (Math.abs(v) >= 100 ? f(v, 0) : Math.abs(v) >= 10 ? f(v, 1) : Math.abs(v) >= 1 ? f(v, 2) : f(v, 3));
  const g4 = (v: number) => (Math.abs(v) >= 1000 ? f(v, 1) : Math.abs(v) >= 100 ? f(v, 2) : f(v, 3));
  const pc = (v: number) => (Math.abs(v) < 5e-5 ? '0.00%' : `${v >= 0 ? '+' : '−'}${f(Math.abs(100 * v), Math.abs(v) < 0.1 ? 2 : 1)}%`);
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-fecalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const halo = { stroke: 'var(--rd-panel)', 'stroke-width': 4, 'paint-order': 'stroke', 'stroke-linejoin': 'round' };
    let mode = 'conv';
    let draw: (() => void) | null = null;

    // ---- chart helpers (as in the hand-calc calculator) ----
    const nice = (span: number) => { const m = 10 ** Math.floor(Math.log10(span / 5)); return [1, 2, 2.5, 5, 10].map((x) => x * m).find((x) => span / x <= 6)!; };
    function frame(o: { x0: number; x1: number; y0: number; y1: number; xl: string; yl: string }) {
      svg.replaceChildren();
      const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 250, L = 64, R = 20, T = 30, B = 40;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const X = (v: number) => L + ((v - o.x0) / (o.x1 - o.x0)) * (W - L - R), Y = (v: number) => T + ((o.y1 - v) / (o.y1 - o.y0)) * (H - T - B);
      let sx = nice(o.x1 - o.x0);
      while ((o.x1 - o.x0) / sx > (W - L - R) / 46) sx *= 2; // keep tick labels apart on narrow charts
      const sy = nice(o.y1 - o.y0), dp = (s: number) => (s >= 1 ? 0 : s >= 0.1 ? 1 : s >= 0.01 ? 2 : 3);
      const z = (v: number) => (Math.abs(v) < 1e-12 ? 0 : v), xFirst = Math.ceil(o.x0 / sx - 1e-9) * sx;
      for (let v = xFirst; v <= o.x1 + 1e-9; v += sx) {
        el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: 'var(--rd-line)' });
        el('text', { x: X(v), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sx)));
      }
      for (let v = Math.ceil(o.y0 / sy - 1e-9) * sy; v <= o.y1 + 1e-9; v += sy) {
        if (Math.abs(v - o.y0) < 1e-9 && Math.abs(xFirst - o.x0) < 1e-9) continue;
        el('text', { x: L - 6, y: Y(v) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sy)));
      }
      if (o.y0 < 0 && o.y1 > 0) el('line', { x1: L, x2: W - R, y1: Y(0), y2: Y(0), stroke: 'var(--rd-ink)', 'stroke-opacity': 0.5 });
      el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, o.xl);
      el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, o.yl);
      return { X, Y, W, H, L, R, T, B };
    }
    const poly = (pts: [number, number][], color: string, w = 2.2, dash = '') =>
      el('polyline', { points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), fill: 'none', stroke: color, 'stroke-width': w, ...(dash ? { 'stroke-dasharray': dash } : {}) });
    const legend = (items: [string, string, string?][]) => {
      let x = 8;
      for (const [name, color, dash] of items) {
        el('line', { x1: x, x2: x + 18, y1: 13, y2: 13, stroke: color, 'stroke-width': 2.2, ...(dash ? { 'stroke-dasharray': dash } : {}) });
        el('text', { x: x + 23, y: 17, 'font-size': 12, fill: 'var(--rd-ink)' }, name);
        x += 37 + name.length * 7.2;
      }
    };
    const dot = (x: number, y: number, color: string, r = 4.5) => el('circle', { cx: x, cy: y, r, fill: color, stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });

    // ---- mesh convergence ----
    function runConv(rows: Row[], notes: [string, string][]) {
      const model = field('v_mode').value === 'model';
      root.querySelectorAll<HTMLElement>('[data-sub]').forEach((e) => (e.hidden = e.dataset.sub !== (model ? 'model' : 'yours')));
      let f1: number, f2: number, f3: number, h1: number, h2: number, h3: number, exact = NaN, zone = NaN, solve: ((h: number) => number) | null = null;
      if (model) {
        const p = num('m_p'), r = num('m_r'), t = num('m_t'), E = num('m_E'), nu = num('m_nu'), hc = num('m_h'), rr = num('m_rr');
        if (!(p > 0 && r > 0 && t > 0 && E > 0 && nu >= 0 && nu < 0.5 && hc > 0 && rr >= 1.2)) { notes.push(['bad', 'Check the shell, the coarsest element size and a refinement ratio of at least 1.2.']); return null; }
        zone = Math.PI / ((3 * (1 - nu * nu)) ** 0.25 / Math.sqrt(r * t));
        const L = hc * Math.max(4, Math.ceil((6 * zone) / hc)), nmax = 300; // six edge zones, a whole number of coarse elements
        const ns = [hc, hc / rr, hc / (rr * rr)].map((h) => Math.max(1, Math.round(L / h)));
        if (ns[2] > nmax) { notes.push(['bad', `The finest mesh would need ${ns[2]} elements; keep it under ${nmax} here — use a coarser start or a smaller ratio.`]); return null; }
        solve = (h: number) => edgeModel(p, r, t, E, nu, L, Math.max(1, Math.round(L / h))).sigmaEdge;
        [h3, h2, h1] = ns.map((n) => L / n);
        [f3, f2, f1] = [h3, h2, h1].map(solve);
        exact = edgeExact(p, r, t, E, nu);
      } else {
        [f1, f2, f3, h1, h2, h3] = ['y_f1', 'y_f2', 'y_f3', 'y_h1', 'y_h2', 'y_h3'].map(num);
        if (![f1, f2, f3].every(Number.isFinite) || !(h1 > 0 && h2 > h1 && h3 > h2)) { notes.push(['bad', 'Enter three results, with element sizes growing from the finest to the coarsest.']); return null; }
      }
      const R = richardson(f1, f2, f3, h1, h2, h3);
      const inRange = R.kind === 'monotonic' && Math.abs(R.asymptotic - 1) < 0.1;
      const kindText: Record<string, string> = { monotonic: inRange ? 'monotonic, in the asymptotic range — the study can be used' : 'monotonic, but not yet in the asymptotic range — refine further', oscillatory: 'oscillatory — refine further before trusting it', divergent: 'diverging — a singularity, or meshes too coarse to start converging', converged: 'identical results — already converged' };
      rows.push({ dt: 'Convergence', dd: `${R.kind} <small>${kindText[R.kind]} · ${g4(f3)} → ${g4(f2)} → ${g4(f1)} at ${g3(h3)}, ${g3(h2)}, ${g3(h1)} mm</small>`, primary: true, cls: inRange || R.kind === 'converged' ? 'ok' : R.kind === 'monotonic' ? 'warn' : 'bad' });
      if (R.kind === 'monotonic') {
        rows.push(
          { dt: 'Observed order', dd: `${f(R.p, 2)} <small>should be near the element's theoretical order for this quantity</small>` },
          { dt: 'Extrapolated', dd: `${g4(R.ext)} <small>Richardson, to zero element size</small>` },
          { dt: 'Grid convergence index', dd: `${f(100 * R.gci, 2)}% <small>a band on the finest result, with a factor of safety of 1.25 on the estimate</small>` },
          { dt: 'Asymptotic range', dd: `${f(R.asymptotic, 3)} <small>${inRange ? 'close to 1: the three meshes behave as theory says' : 'far from 1: the meshes are not yet in the asymptotic range — extrapolation unreliable'}</small>`, cls: inRange ? 'ok' : 'warn' },
        );
        if (!inRange) notes.push(['warn', 'The asymptotic-range check is well away from 1, so the observed order and the extrapolation are not yet reliable. Refine further.']);
      }
      if (model) {
        rows.push(
          { dt: 'Exact answer', dd: `${g4(exact)} <small>the finest mesh is ${pc(f1 / exact - 1)}${R.kind === 'monotonic' ? ` · extrapolation ${pc(R.ext / exact - 1)}` : ''}</small>`, cls: Math.abs(f1 / exact - 1) < 0.02 ? 'ok' : 'warn' },
          { dt: 'Elements across the edge zone', dd: `${f(zone / h3, 1)} → ${f(zone / h2, 1)} → ${f(zone / h1, 1)} <small>edge zone π/β = ${g3(zone)} mm</small>` },
        );
        notes.push(['warn', 'Converged is not the same as right: this peak is an artefact of clamping the end. A real flange grows and rotates with the case — model it, or its stiffness.']);
      }
      if (R.kind === 'divergent') notes.push(['bad', 'The result keeps changing faster as the mesh is refined. Either the coarse meshes are far too coarse, or the point is singular — a sharp corner, a point load or a point constraint — and has no converged value.']);
      notes.push(['', 'Converge the quantity you will report, at the point you will report it — a peak stress needs a much finer mesh than a displacement.']);
      return () => {
        const hs = [h1, h2, h3], fs = [f1, f2, f3];
        const ys = [...fs, ...(Number.isFinite(exact) ? [exact] : []), ...(R.kind === 'monotonic' ? [R.ext] : [])];
        let lo = Math.min(...ys), hi = Math.max(...ys); const pad = 0.12 * (hi - lo || Math.abs(hi) * 0.05 || 1); lo -= pad; hi += pad;
        const c = frame({ x0: 0, x1: h3 * 1.1, y0: lo, y1: hi, xl: 'element size (mm)', yl: 'result' });
        if (Number.isFinite(exact)) {
          el('line', { x1: c.L, x2: c.W - c.R, y1: c.Y(exact), y2: c.Y(exact), stroke: 'var(--rd-ok)', 'stroke-dasharray': '5 3' });
          el('text', { x: c.W - c.R - 4, y: c.Y(exact) - 5, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ok)', ...halo }, 'exact');
        }
        if (R.kind === 'monotonic') {
          const curve = Array.from({ length: 61 }, (_, i) => (h3 * 1.1 * i) / 60).map((h) => [c.X(h), c.Y(R.ext + (f1 - R.ext) * (h / h1) ** R.p)] as [number, number]).filter(([, y]) => y >= c.T && y <= c.H - c.B);
          poly(curve, 'var(--rd-blue)', 1.6, '4 3');
          dot(c.X(0), c.Y(R.ext), 'var(--rd-blue)', 4);
        }
        if (solve && h1 > 0.4) {
          const extra = [h1 / 2, h1 / 4].filter((h) => Math.round((h3 * Math.max(4, Math.ceil((6 * zone) / h3))) / h) <= 300);
          extra.forEach((h) => dot(c.X(h), c.Y(solve!(h)), 'var(--rd-muted)', 3));
        }
        hs.forEach((h, i) => dot(c.X(h), c.Y(fs[i]), 'var(--rd-accent)'));
        legend([['three meshes', 'var(--rd-accent)'], ['Richardson', 'var(--rd-blue)', '4 3']]);
      };
    }

    // ---- equilibrium and far field ----
    function runFree(rows: Row[], notes: [string, string][]) {
      const p = num('q_p'), D = num('q_D'), Rm = num('q_R') * 1000, r = num('q_r'), t = num('q_t'), E = num('q_E'), nu = num('q_nu'), sm = num('q_s'), wm = num('q_w');
      if (!(p > 0 && D > 0 && r > 0 && t > 0 && E > 0)) { notes.push(['bad', 'Enter the pressure, end diameter and shell.']); return null; }
      const Rx = (p * Math.PI * D * D) / 4, sh = (p * r) / t, wc = ((p * r * r) / (E * t)) * (1 - nu / 2), wo = (p * r * r) / (E * t);
      const checks: { name: string; u: number }[] = [];
      if (Number.isFinite(Rm)) {
        const d = Rm / Rx - 1;
        rows.push({ dt: 'Axial reaction', dd: `${g4(Rm / 1000)} kN <small>must be ${g4(Rx / 1000)} kN — ${pc(d)}</small>`, primary: true, cls: Math.abs(d) < 0.001 ? 'ok' : 'bad' });
        checks.push({ name: 'reaction', u: Rm / Rx });
        if (Math.abs(d) >= 0.001) notes.push(['bad', Math.abs(Rm) < 0.01 * Rx ? 'No axial reaction: the pressure on the closures is missing, so the case carries no end load. Hoop stress alone will not show it.' : 'A static model is in equilibrium to round-off: a reaction that differs from the applied load means a load is missing, doubled, or applied to the wrong faces.']);
      }
      if (Number.isFinite(sm)) {
        const d = sm / sh - 1;
        rows.push({ dt: 'Far-field hoop stress', dd: `${g4(sm)} MPa <small>pr/t = ${g4(sh)} MPa — ${pc(d)}</small>`, cls: Math.abs(d) < 0.02 ? 'ok' : 'warn' });
        checks.push({ name: 'hoop', u: sm / sh });
      }
      if (Number.isFinite(wm)) {
        const d = wm / wc - 1, open = Math.abs(wm / wo - 1) < 0.02 && Math.abs(d) > 0.05;
        rows.push({ dt: 'Far-field radial growth', dd: `${g4(wm)} mm <small>closed ends ${g4(wc)} mm — ${pc(d)}${open ? ' · matches open ends' : ''}</small>`, cls: Math.abs(d) < 0.02 ? 'ok' : 'bad' });
        checks.push({ name: 'growth', u: wm / wc });
        if (open) notes.push(['bad', `The growth matches an open-ended cylinder (${g4(wo)} mm): the end load is missing. With it, the axial stress pr/2t and Poisson's effect cut the growth by ν/2.`]);
      }
      notes.push(['', 'Check reactions on every run, before looking at a single stress. Then far-field stresses and displacements against the hand calc — see <a href="../../fundamentals/hand-calcs/">Hand calcs</a>.']);
      return () => {
        svg.replaceChildren();
        const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 250, Lx = 98, R = 20, T = 30, B = 34;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const top = Math.max(1.3, ...checks.map((c) => c.u)) * 1.05, X = (u: number) => Lx + (Math.max(0, Math.min(u, top)) / top) * (W - Lx - R), row = (H - T - B) / Math.max(1, checks.length);
        for (let u = 0; u <= top + 1e-9; u += 0.25) {
          el('line', { x1: X(u), x2: X(u), y1: T, y2: H - B, stroke: Math.abs(u - 1) < 1e-9 ? 'var(--rd-ink)' : 'var(--rd-line)', 'stroke-opacity': Math.abs(u - 1) < 1e-9 ? 0.7 : 1 });
          el('text', { x: X(u), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, `${f(100 * u, 0)}%`);
        }
        checks.forEach((ch, i) => {
          const y = T + i * row + row * 0.2, off = Math.abs(ch.u - 1) > 0.02;
          el('rect', { x: Lx, y, width: Math.max(1, X(ch.u) - Lx), height: row * 0.6, rx: 2, fill: off ? 'var(--rd-accent)' : 'var(--rd-ok)', 'fill-opacity': 0.8 });
          el('text', { x: Lx - 6, y: y + row * 0.3 + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)' }, ch.name);
        });
        el('text', { x: W / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'model / expected');
      };
    }

    // ---- stress at details ----
    function runDetail(rows: Row[], notes: [string, string][]) {
      const ang = num('d_ang'), n = Math.round(num('d_n')) || 5, avg = num('d_avg'), un = num('d_un'), s04 = num('d_s04'), s10 = num('d_s10');
      if (!(ang >= 90 && ang <= 360)) { notes.push(['bad', 'Enter an interior angle between 90° and 360°.']); return null; }
      const lam = williamsLambda(ang), g = 2 ** (1 - lam);
      rows.push({ dt: `Williams exponent <span class="nc">λ</span>`, dd: `${f(lam, 4)} <small>${lam < 1 ? `stress grows as r<sup>${f(lam - 1, 3)}</sup> towards the corner` : 'not singular'}</small>`, primary: true, cls: lam < 1 ? 'bad' : 'ok' });
      if (lam < 1) rows.push({ dt: 'Each mesh halving', dd: `×${f(g, 3)} <small>×${f(g ** n, 2)} after ${n} halvings — no converged value</small>`, cls: 'bad' });
      if (Number.isFinite(avg) && Number.isFinite(un) && avg !== 0) {
        const j = Math.abs(un / avg - 1);
        rows.push({ dt: 'Averaged against element', dd: `${pc(un / avg - 1)} <small>${g3(un)} against ${g3(avg)} MPa — ${j > 0.1 ? 'a large jump: the mesh is too coarse here' : 'small: the field is resolved here'}</small>`, cls: j > 0.1 ? 'warn' : 'ok' });
      }
      if (Number.isFinite(s04) && Number.isFinite(s10)) rows.push({ dt: 'Weld hot-spot stress', dd: `${g3(hotSpot(s04, s10))} MPa <small>1.67 σ<sub>0.4t</sub> − 0.67 σ<sub>1.0t</sub> (IIW, fine mesh) — for hot-spot S-N curves only</small>` });
      if (lam < 1) notes.push(['bad', 'At a singular point the stress the model reports is set by the mesh, not the part. Model the real radius and converge it, read stresses at a distance with a method that defines one, or use fracture mechanics for cracks.']);
      notes.push(['', 'Point loads and single-node constraints are singular too. Spread loads over a realistic area, and introduce them with a coupling that does not stiffen the part (Nastran RBE3, Abaqus distributing coupling) unless the real part is rigid.']);
      notes.push(['', 'Nodal averaging smooths stress across element boundaries and hides how far apart the elements disagree. Compare the unaveraged values at the peak.']);
      return () => {
        const ks = Array.from({ length: n + 1 }, (_, i) => i);
        const c = frame({ x0: 0, x1: n, y0: 0, y1: Math.max(2, g ** n * 1.15), xl: 'mesh halvings', yl: 'peak / coarsest mesh' });
        el('line', { x1: c.L, x2: c.W - c.R, y1: c.Y(1), y2: c.Y(1), stroke: 'var(--rd-ok)', 'stroke-dasharray': '5 3' });
        poly(ks.map((k) => [c.X(k), c.Y(g ** k)]), 'var(--rd-accent)');
        ks.forEach((k) => dot(c.X(k), c.Y(g ** k), 'var(--rd-accent)', 3.5));
        legend([[`${f(ang, 0)}° corner`, 'var(--rd-accent)'], ['converged', 'var(--rd-ok)', '5 3']]);
      };
    }

    // ---- rosettes ----
    function runGauge(rows: Row[], notes: [string, string][]) {
      const a = num('g_a'), b = num('g_b'), c3 = num('g_c'), E = num('g_E'), nu = num('g_nu'), m1 = num('g_m1'), m2 = num('g_m2');
      if (![a, b, c3].every(Number.isFinite) || !(E > 0)) { notes.push(['bad', 'Enter three gauge readings and E.']); return null; }
      const r = rosette(a, b, c3, E, nu);
      rows.push(
        { dt: 'Principal stresses', dd: `${g3(r.s1)} / ${g3(r.s2)} MPa <small><span class="nc">σ</span>1 / <span class="nc">σ</span>2, plane stress · von Mises ${g3(r.vm)}</small>`, primary: true },
        { dt: 'Principal strains', dd: `${f(r.e1, 0)} / ${f(r.e2, 0)} µε <small>first principal at ${f(r.theta, 1)}° from gauge a</small>` },
      );
      if (Number.isFinite(m1)) rows.push({ dt: 'Against the model', dd: `${pc(r.s1 / m1 - 1)}${Number.isFinite(m2) ? ` / ${pc(r.s2 / m2 - 1)}` : ''} <small>test / model − 1, for σ1${Number.isFinite(m2) ? ' and σ2' : ''}</small>`, cls: Math.abs(r.s1 / m1 - 1) < 0.05 ? 'ok' : 'warn' });
      notes.push(['', 'Place gauges where the model shows a gentle gradient, and compare with the model\'s strain averaged over the gauge length. A gauge in a steep gradient measures the gauge as much as the part.']);
      notes.push(['', 'Gauge both surfaces where the part bends. A single surface cannot separate membrane from bending.']);
      return () => {
        // equal scales on both axes, so the circle is a circle
        const mean = (r.e1 + r.e2) / 2, rad = (r.e1 - r.e2) / 2;
        const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), pw = W - 64 - 20, ph = 250 - 30 - 40;
        const xa = Math.min(0, r.e2 - rad * 0.2), xb = Math.max(0, r.e1 + rad * 0.2);
        const yhalf = Math.max(rad * 1.2, ((xb - xa) * ph) / (2 * pw)), xhalf = (yhalf * pw) / ph, cx = (xa + xb) / 2;
        const c = frame({ x0: cx - xhalf, x1: cx + xhalf, y0: -yhalf, y1: yhalf, xl: 'normal strain (µε)', yl: 'shear strain / 2 (µε)' });
        const pts = Array.from({ length: 121 }, (_, i) => (2 * Math.PI * i) / 120).map((t) => [c.X(mean + rad * Math.cos(t)), c.Y(rad * Math.sin(t))] as [number, number]);
        poly(pts, 'var(--rd-blue)', 1.8);
        el('line', { x1: c.X(r.e2), x2: c.X(r.e1), y1: c.Y(0), y2: c.Y(0), stroke: 'var(--rd-ink)', 'stroke-opacity': 0.5 });
        // gauge points: a at 2θ = −2θp from the principal direction, b and c at 90° and 180° further round
        const t0 = (-2 * r.theta * Math.PI) / 180;
        [['a', 0], ['b', Math.PI / 2], ['c', Math.PI]].forEach(([name, add]) => {
          const t = t0 + (add as number), x = c.X(mean + rad * Math.cos(t)), y = c.Y(rad * Math.sin(t));
          dot(x, y, 'var(--rd-accent)', 4);
          el('text', { x: x + 7, y: y - 6, 'font-size': 12, fill: 'var(--rd-accent)', ...halo }, name as string);
        });
        dot(c.X(r.e1), c.Y(0), 'var(--rd-ink)', 3.5); dot(c.X(r.e2), c.Y(0), 'var(--rd-ink)', 3.5);
        legend([["Mohr's circle", 'var(--rd-blue)']]);
      };
    }

    const RUN: Record<string, typeof runConv> = { conv: runConv, free: runFree, detail: runDetail, gauge: runGauge };
    const CAPS: Record<string, string> = {
      conv: 'Results against element size, with the Richardson curve through them to zero size. For the built-in model, grey dots are two further halvings and the dashed green line the exact answer.',
      free: 'Each check as the model\'s value over the value it must have. Equilibrium must hold to round-off; far-field values to a few per cent.',
      detail: 'Peak stress at a corner of this interior angle as the mesh is halved, relative to the coarsest mesh. A smooth or obtuse corner stays flat; a sharp one climbs for ever.',
      gauge: 'Mohr\'s circle of strain from the three gauges: a, b and c sit 90° apart round it; the principal strains are where it crosses the axis.',
    };

    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    run();
  });
</script>
