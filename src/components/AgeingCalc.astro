---
// Service life from accelerated ageing tests, a storage temperature record and an Arrhenius fit.
// Maths in src/lib/ageing.ts (unit-tested); this file is UI only.
const ROWS = [
  { t: 80, life: 1400 }, { t: 100, life: 330 }, { t: 120, life: 90 }, { t: '', life: '' }, { t: '', life: '' },
];
const PRESETS = {
  hot: { label: 'Hot unconditioned store', log: [12, 18, 24, 31, 38, 29, 21, 15] },
  temperate: { label: 'Temperate, monthly means', log: [4, 5, 8, 11, 15, 18, 20, 20, 17, 13, 8, 5] },
  conditioned: { label: 'Conditioned store', log: [20, 20, 20, 20] },
};
---

<div class="calc agcalc" data-agcalc>
  <div class="calc-head"><span>Service life from accelerated ageing</span><span>single-mechanism Arrhenius · mean kinetic temperature</span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>1 · Accelerated tests</legend>
        <div class="ag-rows">
          <span class="ag-h">Test temp (°C)</span><span class="ag-h">Life (hours)</span>
          {ROWS.map((r, k) => (
            <>
              <input name={`t${k}`} type="number" step="any" value={r.t} aria-label={`Test ${k + 1} temperature`} />
              <input name={`l${k}`} type="number" min="0" step="any" value={r.life} aria-label={`Test ${k + 1} life`} />
            </>
          ))}
        </div>
        <p class="hint">Life = time to reach your end-of-life criterion at that temperature: compression set reaching its limit, bond strength falling to its minimum. At least three temperatures. Defaults are illustrative, not data for any real compound.</p>
        <label>Activation energy override (kJ/mol)<input name="ea" type="number" min="1" step="any" placeholder="from the fit" /></label>
      </fieldset>
      <fieldset>
        <legend>2 · Storage record</legend>
        <div class="ag-presets">
          {Object.entries(PRESETS).map(([k, p]) => <button type="button" class="chip" data-preset={k}>{p.label}</button>)}
        </div>
        <label>Readings, °C: equal intervals, one per line
          <textarea name="log" rows="5">{PRESETS.hot.log.join('\n')}</textarea>
        </label>
      </fieldset>
      <fieldset>
        <legend>3 · Test plan</legend>
        <div class="row2">
          <label>Test temperature (°C)<input name="tt" type="number" step="any" value="80" /></label>
          <label>Test duration (days)<input name="td" type="number" min="0" step="any" value="30" /></label>
        </div>
      </fieldset>
      <script type="application/json" data-presets set:html={JSON.stringify(PRESETS)}></script>
    </form>
    <div>
      <dl class="readouts">
        <div class="readout primary"><dt>Predicted life in this store</dt><dd data-r="life">—</dd></div>
        <div class="readout"><dt>Using the plain average instead</dt><dd data-r="lifeMean">—</dd></div>
      </dl>
      <p class="pv-sub">The chemistry</p>
      <dl class="readouts">
        <div class="readout"><dt>Activation energy E<sub>a</sub></dt><dd data-r="ea">—</dd></div>
        <div class="readout"><dt>Rate doubles every</dt><dd data-r="dbl">—</dd></div>
        <div class="readout"><dt>Extrapolation from the coolest test</dt><dd data-r="gap">—</dd></div>
      </dl>
      <p class="pv-sub">The store</p>
      <dl class="readouts">
        <div class="readout"><dt>Mean kinetic temperature</dt><dd data-r="mkt">—</dd></div>
        <div class="readout"><dt>Arithmetic mean</dt><dd data-r="mean">—</dd></div>
      </dl>
      <p class="pv-sub">The test plan</p>
      <dl class="readouts">
        <div class="readout"><dt>Acceleration factor</dt><dd data-r="af">—</dd></div>
        <div class="readout"><dt>Equivalent time in this store</dt><dd data-r="eq">—</dd></div>
      </dl>
      <figure class="ag-fig">
        <svg viewBox="0 0 480 250" data-arr role="img" aria-label="Arrhenius plot of life against temperature"></svg>
        <figcaption>Arrhenius plot: life (log scale) against temperature on a 1/T scale, so a single mechanism is a straight line. Solid: fitted over the tests. Dashed: the extrapolation to the store.</figcaption>
      </figure>
      <figure class="ag-fig">
        <svg viewBox="0 0 480 170" data-log role="img" aria-label="Storage temperature record with its mean and mean kinetic temperature"></svg>
        <figcaption>The storage record. The mean kinetic temperature sits above the plain average, because hot readings age the hardware far more than cold ones slow it down.</figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    One degradation mechanism with a constant activation energy across the whole range, life defined by one property
    reaching one limit, and a storage record that is representative of the whole service life. ISO 11346 describes the
    full method for rubbers, including fitting by time–temperature shifting.
  </div>
</div>

<style is:global>
  .agcalc .pv-sub { font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--rd-muted); margin: 1rem 0 0.4rem !important; }
  .agcalc .ag-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.6rem; }
  .agcalc .ag-rows > * { margin: 0 !important; }
  .agcalc .ag-h { font-size: var(--sl-text-sm); color: var(--rd-muted); }
  .agcalc .ag-presets { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .agcalc .ag-presets > * { margin: 0 !important; }
  .agcalc textarea { width: 100%; display: block; margin-top: 0.2rem; font-family: var(--sl-font-mono); background: var(--rd-panel2); color: var(--rd-ink); border: 1px solid var(--rd-line); border-radius: 4px; padding: 0.4rem; }
  .ag-fig { margin: 0.9rem 0 0 !important; }
  .ag-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .ag-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .agcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { arrheniusFit, meanKineticTemperature, accelerationFactor, doublingInterval, kelvin } from '../lib/ageing';

  const NS = 'http://www.w3.org/2000/svg';
  const HOURS_PER_YEAR = 8766;
  const f = (v: number, d = 1) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const deg = (c: number, d = 1) => `${f(c, d).replace('-', '−')} °C`;
  const span = (h: number) => (h < 48 ? `${f(h, 0)} h` : h < 24 * 60 ? `${f(h / 24, 0)} days` : `${f(h / HOURS_PER_YEAR, h < 100 * HOURS_PER_YEAR ? 1 : 0)} years`);

  document.querySelectorAll<HTMLElement>('[data-agcalc]').forEach((root) => {
    const PRESETS: Record<string, { label: string; log: number[] }> = JSON.parse(root.querySelector('[data-presets]')!.textContent!);
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };

    function run() {
      const notes = root.querySelector('[data-notes]')!;
      const pts = [0, 1, 2, 3, 4].map((k) => ({ t: field(`t${k}`).value, life: field(`l${k}`).value }))
        .filter((p) => p.t.trim() !== '' && p.life.trim() !== '').map((p) => ({ t: +p.t, life: +p.life }))
        .filter((p) => Number.isFinite(p.t) && p.life > 0 && p.t > -273);
      const readings = field('log').value.split(/[\s,;]+/).filter((s) => s.trim() !== '').map(Number).filter(Number.isFinite);
      if (pts.length < 2 || new Set(pts.map((p) => p.t)).size < 2 || readings.length < 1) {
        notes.innerHTML = '<li class="bad">Enter at least two test temperatures (three or more for a credible fit) and at least one storage reading.</li>';
        return;
      }
      const fit = arrheniusFit(pts);
      const eaIn = field('ea').value.trim();
      const ea = eaIn !== '' && +eaIn > 0 ? +eaIn : fit.eaKJ;
      if (!(ea > 0)) { notes.innerHTML = '<li class="bad">Life gets longer as temperature rises in these results, so they cannot be one thermally activated mechanism. Check the data.</li>'; return; }
      // With an override, keep the fit's line through the test data's centroid but use the given slope.
      const B = (ea * 1000) / 8.314462618;
      const xs = pts.map((p) => 1 / kelvin(p.t)), ys = pts.map((p) => Math.log(p.life));
      const A = ys.reduce((s, y) => s + y, 0) / ys.length - B * (xs.reduce((s, x) => s + x, 0) / xs.length);
      const lifeAt = (c: number) => Math.exp(A + B / kelvin(c));
      const mean = readings.reduce((s, v) => s + v, 0) / readings.length;
      const mkt = meanKineticTemperature(ea, readings);
      const tLow = Math.min(...pts.map((p) => p.t));
      const tt = +field('tt').value, td = +field('td').value;
      const af = accelerationFactor(ea, mkt, tt);

      r('life').innerHTML = span(lifeAt(mkt));
      r('lifeMean').innerHTML = `${span(lifeAt(mean))} <small>${lifeAt(mean) > lifeAt(mkt) ? '+' : ''}${f((lifeAt(mean) / lifeAt(mkt) - 1) * 100, 0)}%</small>`;
      r('ea').innerHTML = `${f(ea, 1)} <small>kJ/mol${eaIn !== '' ? ' · override' : ` · r² ${f(fit.r2, 3)}`}</small>`;
      r('dbl').innerHTML = `${f(doublingInterval(ea, mkt), 1)} <small>K at ${deg(mkt, 0)}</small>`;
      r('gap').innerHTML = `${f(tLow - mkt, 0)} <small>K</small>`;
      r('mkt').textContent = deg(mkt);
      r('mean').textContent = deg(mean);
      r('af').textContent = `${f(af, af < 10 ? 2 : af < 100 ? 1 : 0)}×`;
      r('eq').innerHTML = span(td * 24 * af);

      const out: [string, string][] = [];
      out.push(['', `The store ages hardware like a constant ${deg(mkt)}, not its ${deg(mean)} average. Judging life by the average would overstate it by ${f((lifeAt(mean) / lifeAt(mkt) - 1) * 100, 0)}%.`]);
      const errFactor = Math.exp(0.1 * B * Math.abs(1 / kelvin(mkt) - 1 / kelvin(tLow)));
      out.push(['', `A 10% error in E<sub>a</sub> changes the predicted life by a factor of ${f(errFactor, 2)} over this ${f(tLow - mkt, 0)} K extrapolation. The further the coolest test is from the store, the more the answer rests on E<sub>a</sub>.`]);
      if (pts.length < 3) out.push(['warn', 'Two temperatures always fit a straight line. Three or more show whether one mechanism really governs.']);
      else if (fit.r2 < 0.95) out.push(['warn', `The points do not line up well (r² = ${f(fit.r2, 3)}). The mechanism may change between test temperatures: the highest-temperature result is the usual suspect.`]);
      if (tt > Math.max(...pts.map((p) => p.t))) out.push(['warn', `The planned test at ${deg(tt, 0)} is hotter than any temperature the activation energy was measured at. Above that range a different mechanism may take over.`]);
      if (td > 0) out.push(['', `${f(td, 0)} days at ${deg(tt, 0)} ≈ ${span(td * 24 * af)} in this store, if, and only if, the same mechanism governs at both temperatures.`]);
      notes.innerHTML = out.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      arrPlot(pts, lifeAt, mkt, mean);
      logPlot(readings, mean, mkt);
    }

    function arrPlot(pts: { t: number; life: number }[], lifeAt: (c: number) => number, mkt: number, mean: number) {
      const svg = root.querySelector<SVGSVGElement>('[data-arr]')!;
      svg.replaceChildren();
      const W = 480, H = 250, L = 56, R = 12, T = 22, B = 36;
      const tHot = Math.max(...pts.map((p) => p.t)) + 10, tCold = Math.min(mkt, mean, ...pts.map((p) => p.t)) - 8;
      const x1 = 1000 / kelvin(tHot), x2 = 1000 / kelvin(tCold);
      const lifeMin = Math.min(...pts.map((p) => p.life), lifeAt(tHot)), lifeMax = Math.max(lifeAt(tCold), ...pts.map((p) => p.life));
      const y1 = Math.floor(Math.log10(lifeMin)), y2 = Math.ceil(Math.log10(lifeMax));
      const X = (c: number) => L + ((1000 / kelvin(c) - x1) / (x2 - x1)) * (W - L - R);
      const Y = (h: number) => H - B - ((Math.log10(h) - y1) / (y2 - y1)) * (H - T - B);
      for (let e = y1; e <= y2; e++) {
        svg.append(el('line', { x1: L, x2: W - R, y1: Y(10 ** e), y2: Y(10 ** e), stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: L - 6, y: Y(10 ** e) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, e < 4 ? `${10 ** e} h` : `10${String(e).replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])} h`));
      }
      for (const yr of [1, 10, 100]) {
        const h = yr * HOURS_PER_YEAR;
        if (Math.log10(h) <= y1 || Math.log10(h) >= y2) continue;
        svg.append(el('line', { x1: L, x2: W - R, y1: Y(h), y2: Y(h), stroke: 'var(--rd-blue)', 'stroke-opacity': 0.5, 'stroke-dasharray': '2 3' }));
        svg.append(el('text', { x: L + 4, y: Y(h) - 3, 'font-size': 9.5, fill: 'var(--rd-blue)' }, `${yr} yr`));
      }
      const step = tHot - tCold > 120 ? 40 : 20;
      for (let c = Math.ceil(tCold / step) * step; c <= tHot; c += step) {
        svg.append(el('line', { x1: X(c), x2: X(c), y1: T, y2: H - B, stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: X(c), y: H - B + 14, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, `${c}`));
      }
      svg.append(el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'temperature, °C (1/T scale: colder to the right)'));
      svg.append(el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, 'life'));
      const tLow = Math.min(...pts.map((p) => p.t)), tHi = Math.max(...pts.map((p) => p.t));
      svg.append(el('line', { x1: X(tHi), y1: Y(lifeAt(tHi)), x2: X(tLow), y2: Y(lifeAt(tLow)), stroke: 'var(--rd-ok)', 'stroke-width': 2.5 }));
      svg.append(el('line', { x1: X(tLow), y1: Y(lifeAt(tLow)), x2: X(tCold), y2: Y(lifeAt(tCold)), stroke: 'var(--rd-ok)', 'stroke-width': 2, 'stroke-dasharray': '6 4' }));
      for (const p of pts) svg.append(el('circle', { cx: X(p.t), cy: Y(p.life), r: 5, fill: 'var(--rd-panel)', stroke: 'var(--rd-ink)', 'stroke-width': 2 }));
      for (const [c, col, lab, dy] of [[mkt, 'var(--rd-accent)', 'MKT', -8], [mean, 'var(--rd-muted)', 'mean', 14]] as const) {
        svg.append(el('line', { x1: X(c), x2: X(c), y1: T, y2: H - B, stroke: col, 'stroke-dasharray': '3 3' }));
        svg.append(el('circle', { cx: X(c), cy: Y(lifeAt(c)), r: 5, fill: col }));
        svg.append(el('text', { x: X(c) - 6, y: Y(lifeAt(c)) + dy, 'text-anchor': 'end', 'font-size': 10, fill: col }, lab));
      }
    }

    function logPlot(readings: number[], mean: number, mkt: number) {
      const svg = root.querySelector<SVGSVGElement>('[data-log]')!;
      svg.replaceChildren();
      const W = 480, H = 170, L = 40, R = 60, T = 12, B = 24;
      const lo = Math.min(...readings, mean) - 3, hi = Math.max(...readings, mkt) + 3;
      const X = (k: number) => L + (readings.length > 1 ? k / (readings.length - 1) : 0.5) * (W - L - R);
      const Y = (c: number) => H - B - ((c - lo) / (hi - lo)) * (H - T - B);
      const step = hi - lo > 40 ? 10 : 5;
      for (let c = Math.ceil(lo / step) * step; c <= hi; c += step) {
        svg.append(el('line', { x1: L, x2: W - R, y1: Y(c), y2: Y(c), stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: L - 6, y: Y(c) + 3, 'text-anchor': 'end', 'font-size': 10, fill: 'var(--rd-muted)' }, `${c}`));
      }
      svg.append(el('text', { x: (L + W - R) / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 10, fill: 'var(--rd-muted)' }, 'reading (equal intervals) · °C'));
      svg.append(el('path', { d: readings.map((c, k) => `${k ? 'L' : 'M'}${X(k).toFixed(1)},${Y(c).toFixed(1)}`).join(''), fill: 'none', stroke: 'var(--rd-hot)', 'stroke-width': 2 }));
      readings.forEach((c, k) => svg.append(el('circle', { cx: X(k), cy: Y(c), r: 3, fill: 'var(--rd-hot)' })));
      svg.append(el('line', { x1: L, x2: W - R, y1: Y(mean), y2: Y(mean), stroke: 'var(--rd-muted)', 'stroke-dasharray': '5 4' }));
      svg.append(el('text', { x: W - R + 4, y: Y(mean) + 4, 'font-size': 10, fill: 'var(--rd-muted)' }, `mean ${f(mean, 1)}`));
      svg.append(el('line', { x1: L, x2: W - R, y1: Y(mkt), y2: Y(mkt), stroke: 'var(--rd-accent)', 'stroke-width': 2 }));
      svg.append(el('text', { x: W - R + 4, y: Y(mkt) + 4 - (Math.abs(Y(mkt) - Y(mean)) < 12 ? 6 : 0), 'font-size': 10, fill: 'var(--rd-accent)' }, `MKT ${f(mkt, 1)}`));
    }

    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      field('log').value = PRESETS[b.dataset.preset!].log.join('\n');
      run();
    }));
    form.addEventListener('input', run);
    run();
  });
</script>
