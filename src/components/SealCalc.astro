---
// Seal at pressure and leak check (Cast UI island: src/tools/Seal.tsx).
import Seal from '../tools/Seal';
import { materialGroups } from '../tools/materialOptions';
import { DEFAULTS as D } from '../lib/materials';
import { MATERIALS } from '../lib/bolts';
---

<Seal client:visible groups={materialGroups(MATERIALS)} mats={Object.fromEntries(MATERIALS.map((m) => [m.key, { key: m.key, E: m.E, nu: m.nu }]))} defaultMat={D.caseSteel} />
