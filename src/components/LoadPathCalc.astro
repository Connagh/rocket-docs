---
// A motor's load path at MEOP: pressure end loads, thrust, nozzle and closure loads, acceleration and the load passed
// to the payload through the forward skirt, the skirt's running load and the attach-ring bolt loads under bending.
// Maths in src/lib/loadpath.ts (unit-tested); UI only here.
---

<div class="calc lpcalc" data-lpcalc>
  <div class="calc-head"><span>Motor load path</span><span class="head-btns"><span>pressure · thrust · skirt · attach ring</span></span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Pressure and thrust</legend>
        <div class="row2">
          <label>Chamber pressure (MPa)<input name="p" type="number" min="0" step="any" value="10" /></label>
          <label>Case bore ⌀ (mm)<input name="D" type="number" min="1" step="any" value="300" /></label>
          <label>Throat ⌀ (mm)<input name="dt" type="number" min="0" step="any" value="50" /></label>
          <label>Thrust coefficient C<sub>F</sub><input name="cf" type="number" min="0" step="any" value="1.5" /></label>
          <label>Nozzle attach seal ⌀ (mm)<input name="dn" type="number" min="0" step="any" value="110" /></label>
          <label>Aft closure seal ⌀ (mm)<input name="ds" type="number" min="0" step="any" value="260" /></label>
          <label>Closure bolts<input name="nc" type="number" min="1" step="1" value="30" /></label>
        </div>
        <p class="hint">MEOP gives the largest loads. C<sub>F</sub> is the value at the altitude you are checking.</p>
      </fieldset>
      <fieldset>
        <legend>Masses</legend>
        <div class="row2">
          <label>Motor at ignition (kg)<input name="m0" type="number" min="0" step="any" value="137.81" /></label>
          <label>Motor at burnout (kg)<input name="m1" type="number" min="0" step="any" value="26.61" /></label>
          <label>Mass ahead of the skirt (kg)<input name="ma" type="number" min="0" step="any" value="50" /></label>
          <label>Grain bond length (mm)<input name="lg" type="number" min="1" step="any" value="1000" /></label>
        </div>
        <p class="hint">Mass ahead of the skirt is everything the motor pushes through it — payload, upper stages. Thrust alone: no drag or weight.</p>
      </fieldset>
      <fieldset>
        <legend>Skirt and attach ring</legend>
        <div class="row2">
          <label>Bending moment (kN·m)<input name="M" type="number" min="0" step="any" value="3" /></label>
          <label>Skirt mean ⌀ (mm)<input name="dk" type="number" min="1" step="any" value="301.4" /></label>
          <label>Skirt wall (mm)<input name="tk" type="number" min="0.1" step="any" value="2" /></label>
          <label>Attach bolts<input name="nb" type="number" min="3" step="1" value="16" /></label>
          <label>Bolt circle ⌀ (mm)<input name="db" type="number" min="1" step="any" value="280" /></label>
        </div>
        <p class="hint">The bending moment at the joint comes from your vehicle loads analysis. Bolt loads assume the joint stays closed.</p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts">
        <div class="readout primary"><dt>Pressure end load</dt><dd data-r="end">—</dd></div>
        <div class="readout"><dt>Thrust</dt><dd data-r="thr">—</dd></div>
        <div class="readout"><dt>Nozzle load</dt><dd data-r="noz">—</dd></div>
        <div class="readout"><dt>Aft closure</dt><dd data-r="clo">—</dd></div>
        <div class="readout"><dt>Acceleration</dt><dd data-r="acc">—</dd></div>
        <div class="readout"><dt>Through the forward skirt</dt><dd data-r="skirt">—</dd></div>
        <div class="readout"><dt>Skirt running load</dt><dd data-r="line">—</dd></div>
        <div class="readout primary"><dt>Attach-bolt load</dt><dd data-r="bolt">—</dd></div>
        <div class="readout"><dt>Grain bond shear</dt><dd data-r="bond">—</dd></div>
      </dl>
      <figure class="lp-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Load in each attach bolt around the bolt circle, at ignition, at burnout and with no thrust"></svg>
        <figcaption>Load in each attach bolt around the circle. Bending adds tension on one side and compression on the other; the thrust pushing the payload shifts the whole curve towards compression.</figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Rigid-body flight loads from thrust alone. Pressure end loads over the stated diameters; the nozzle attach plane at chamber
    pressure. Skirt: thin cylinder, beam bending. Attach ring: equally spaced bolts, neutral axis at the centre, joint closed.
  </div>
</div>

<style is:global>
  .lpcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .lp-fig { margin: 0.9rem 0 0 !important; }
  .lp-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .lp-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .lpcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { pressureLoads, flightLoads, bondInertiaShear, lineLoad, ringBoltLoads } from '../lib/loadpath';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const kN = (v: number) => f(v / 1000, Math.abs(v) < 10000 ? 2 : Math.abs(v) < 100000 ? 1 : 0);

  document.querySelectorAll<HTMLElement>('[data-lpcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };
    let last: Parameters<typeof chart> | null = null;

    function run() {
      const notes: [string, string][] = [];
      const p = num('p'), D = num('D'), dt = num('dt'), cf = num('cf'), dn = num('dn'), ds = num('ds'), nc = Math.round(num('nc'));
      const m0 = num('m0'), m1 = num('m1'), ma = num('ma'), lg = num('lg');
      const M = num('M') * 1e6, dk = num('dk'), tk = num('tk'), nb = Math.round(num('nb')), db = num('db');
      const ok = [p, D, dt, cf, dn, ds, m0, m1, ma, lg, M, dk, tk, db].every(Number.isFinite) && nc >= 1 && nb >= 3 && m0 + ma > 0 && m1 + ma > 0;
      if (!ok) {
        for (const k of ['end', 'thr', 'noz', 'clo', 'acc', 'skirt', 'line', 'bolt', 'bond']) r(k).textContent = '—';
        root.querySelector('[data-notes]')!.innerHTML = '<li class="bad">Enter every value — masses and diameters above zero, at least three attach bolts.</li>';
        chart(null);
        return;
      }

      const pl = pressureLoads(p, D, cf, dt, dn, ds);
      r('end').innerHTML = `${kN(pl.fwd)} kN <small>on the forward dome · ${f(pl.ratio, 0)}× the thrust</small>`;
      r('thr').innerHTML = `${kN(pl.F)} kN <small>C<sub>F</sub>·p·A<sub>t</sub> · the aft end is pushed back by ${kN(pl.aft)} kN</small>`;
      r('noz').innerHTML = pl.nozzle >= 0
        ? `${kN(pl.nozzle)} kN <small>pushing the nozzle off its attachment</small>`
        : `${kN(-pl.nozzle)} kN <small>pulling the nozzle into the motor — thrust exceeds the pressure over its attachment</small>`;
      r('clo').innerHTML = `${kN(pl.closureStatic)} kN <small>in a static pressure test, ${kN(pl.closureStatic / nc)} kN per bolt · ${kN(pl.closureFiring)} kN firing, ${kN(pl.closureFiring / nc)} kN per bolt</small>`;

      const ig = flightLoads(pl.F, m0, ma), bo = flightLoads(pl.F, m1, ma);
      r('acc').innerHTML = `${f(bo.g, 1)} g <small>at burnout · ${f(ig.g, 1)} g at ignition</small>`;
      r('skirt').innerHTML = `${kN(bo.skirt)} kN <small>at burnout · ${kN(ig.skirt)} kN at ignition · the motor's own inertia takes the rest: ${kN(bo.motor)} and ${kN(ig.motor)} kN</small>`;

      const lI = lineLoad(ig.skirt, M, dk), lB = lineLoad(bo.skirt, M, dk), l0 = lineLoad(0, M, dk);
      const comp = Math.max(lI.maxComp, lB.maxComp), tens = Math.max(lI.maxTens, lB.maxTens);
      r('line').innerHTML = `${f(comp, 1)} N/mm <small>peak compression · ${f(comp / tk, 0)} MPa in the wall · tension side ${tens > 0 ? `${f(tens, 1)} N/mm` : 'stays in compression'}</small>`;

      const bI = ringBoltLoads(ig.skirt, M, nb, db), bB = ringBoltLoads(bo.skirt, M, nb, db), b0 = ringBoltLoads(0, M, nb, db);
      const peakT = Math.max(bI.maxTension, bB.maxTension), when = bI.maxTension >= bB.maxTension ? 'ignition' : 'burnout';
      r('bolt').innerHTML = peakT > 0
        ? `${kN(peakT)} kN <small>peak tension, at ${when} · ${kN(b0.maxTension)} kN with no thrust · ${kN(Math.max(bI.maxCompression, bB.maxCompression))} kN peak compression</small>`
        : `in compression <small>the thrust holds every bolt's share in compression · ${kN(b0.maxTension)} kN with no thrust</small>`;

      const tau = bondInertiaShear(m0 - m1, ig.a, D, lg);
      r('bond').innerHTML = `${f(tau * 1000, 1)} kPa <small>mean, from the grain's inertia at ignition</small>`;

      notes.push(['', `The pressure end load is ${f(pl.ratio, 0)} times the thrust, but it closes inside the case: the closures, their joints and the case wall carry it — the attachments to the vehicle never see it.`]);
      if (pl.closureStatic > pl.closureFiring) notes.push(['', `A static pressure test loads the aft closure with the full ${kN(pl.closureStatic)} kN — no flow, so no thrust to relieve it. Size the closure joint for the test as well as for firing.`]);
      if (bo.skirt > ig.skirt) notes.push(['', `The forward skirt load rises from ${kN(ig.skirt)} kN at ignition to ${kN(bo.skirt)} kN at burnout: as the propellant burns away, the same thrust pushes less motor and more payload.`]);
      notes.push(['', `Bending with no thrust — coast, handling, or before ignition — puts ${kN(b0.maxTension)} kN into the most loaded bolt. Take the largest bolt tension of all load cases to <a href="../bolted-joints/">Bolted joints</a> as the external load per bolt.`]);
      if (l0.maxComp > 0) notes.push(['', `The skirt's peak running load in compression goes to the <a href="../../verify/shell-buckling/">shell-buckling</a> check wherever the skirt or case is unpressurised.`]);
      if (m1 > m0) notes.push(['bad', 'The burnout mass is larger than the ignition mass — check the masses.']);

      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      chart({ I: bI, B: bB, Z: b0 });
    }

    type Ring = ReturnType<typeof ringBoltLoads>;
    function chart(d: { I: Ring; B: Ring; Z: Ring } | null) {
      const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
      svg.replaceChildren();
      last = [d];
      if (!d) return;
      const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 250, L = 50, R = 20, T = 34, B = 40;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const n = d.I.each.length, all = [d.I, d.B, d.Z].flatMap((x) => [x.maxTension, -x.maxCompression]).map((v) => v / 1000);
      const span = Math.max(...all.map(Math.abs)) * 1.15 || 1;
      const X = (deg: number) => L + (deg / 360) * (W - L - R), Y = (v: number) => T + ((span - v) / (2 * span)) * (H - T - B);
      const halo = { stroke: 'var(--rd-panel)', 'stroke-width': 4, 'paint-order': 'stroke', 'stroke-linejoin': 'round' };
      svg.append(el('rect', { x: L, y: T, width: W - L - R, height: Y(0) - T, fill: 'var(--rd-accent)', 'fill-opacity': 0.06 }));
      svg.append(el('rect', { x: L, y: Y(0), width: W - L - R, height: H - B - Y(0), fill: 'var(--rd-blue)', 'fill-opacity': 0.06 }));
      for (const deg of [0, 90, 180, 270, 360]) {
        svg.append(el('line', { x1: X(deg), x2: X(deg), y1: T, y2: H - B, stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: X(deg), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, `${deg}°`));
      }
      const step = span > 6 ? 2 : span > 3 ? 1 : span > 1.2 ? 0.5 : 0.2;
      for (let v = -Math.floor(span / step) * step; v <= span; v += step) svg.append(el('text', { x: L - 6, y: Y(v) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, f(v, step < 1 ? 1 : 0)));
      svg.append(el('line', { x1: L, x2: W - R, y1: Y(0), y2: Y(0), stroke: 'var(--rd-ink)', 'stroke-opacity': 0.6 }));
      svg.append(el('text', { x: W - R - 4, y: T + 14, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-accent)', ...halo }, 'tension'));
      svg.append(el('text', { x: W - R - 4, y: H - B - 6, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-blue)', ...halo }, 'compression'));
      const series: [Ring, string, string, string][] = [[d.Z, 'var(--rd-muted)', 'no thrust', '5 4'], [d.I, 'var(--rd-accent)', 'ignition', ''], [d.B, 'var(--rd-blue)', 'burnout', '']];
      series.forEach(([ring, color, name, dash], s) => {
        const amp = ring.bend / 1000, mid = -ring.axial / 1000;
        const pts = Array.from({ length: 73 }, (_, i) => `${X(i * 5).toFixed(1)},${Y(mid + amp * Math.cos((i * 5 * Math.PI) / 180)).toFixed(1)}`).join(' ');
        svg.append(el('polyline', { points: pts, fill: 'none', stroke: color, 'stroke-width': 2, ...(dash ? { 'stroke-dasharray': dash } : {}) }));
        if (s > 0) ring.each.forEach((v, i) => svg.append(el('circle', { cx: X((360 * i) / n), cy: Y(v / 1000), r: 3, fill: color })));
        const lx = 8 + series.slice(0, s).reduce((x, [, , nm]) => x + 37 + nm.length * 7.2, 0);
        svg.append(el('line', { x1: lx, x2: lx + 18, y1: 14, y2: 14, stroke: color, 'stroke-width': 2, ...(dash ? { 'stroke-dasharray': '4 3' } : {}) }));
        svg.append(el('text', { x: lx + 23, y: 18, 'font-size': 12, fill: 'var(--rd-ink)' }, name));
      });
      svg.append(el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'position round the bolt circle'));
      svg.append(el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, 'bolt load (kN)'));
    }

    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (last && Math.abs(nw - w) > 8) { w = nw; chart(...last); } }).observe(root.querySelector('[data-chart]')!);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 120); });
    form.addEventListener('change', run);
    run();
  });
</script>
