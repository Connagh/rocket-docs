---
// Material specification builder: v1's 25 spec sheets plus the v2 case steels.
// Callout assembly lives in src/lib/callout.ts (unit-tested).
import data from '../data/specs.json';
import { SPECS_V2 } from '../data/specs-v2.mjs';

const FAM: Record<string, string> = { steel: 'Steels', ss: 'Stainless & PH steels', ti: 'Titanium', al: 'Aluminium', ni: 'Nickel alloys', cu: 'Copper' };
const sheets = [...SPECS_V2, ...data.specs];
const groups = Object.entries(FAM).map(([k, n]) => ({ n, items: sheets.map((s, i) => ({ s, i })).filter(({ s }) => s.family === k) })).filter((g) => g.items.length);
---

<div class="calc specb" data-specb>
  <div class="calc-head"><span>Material specification builder</span><button type="button" class="chip" data-copy>Copy callout</button></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Material</legend>
        <label>Specification sheet
          <select name="sheet">
            {groups.map((g) => (
              <optgroup label={g.n}>{g.items.map(({ s, i }) => <option value={i} selected={s.name === 'D6AC'}>{s.name}</option>)}</optgroup>
            ))}
          </select>
        </label>
        <p class="hint" data-base></p>
      </fieldset>
      <fieldset>
        <legend>1 · Product form</legend>
        <label>Form<select name="form"></select></label>
        <label>Governing standard<select name="std"></select></label>
        <p class="hint" data-formnote></p>
      </fieldset>
      <fieldset>
        <legend>2 · Condition</legend>
        <label>Temper / heat treatment<select name="temper"></select></label>
        <p class="hint" data-tempnote></p>
      </fieldset>
      <fieldset>
        <legend>3 · Finish</legend>
        <label>Finish<select name="finish"></select></label>
        <p class="hint" data-finnote></p>
      </fieldset>
      <fieldset>
        <legend>Extra lines</legend>
        <label class="inline"><input type="checkbox" name="cert" checked /> Inspection certificate (BS EN 10204 3.1)</label>
        <label class="inline"><input type="checkbox" name="trace" /> Batch marking and traceability</label>
        <label class="inline"><input type="checkbox" name="after" checked /> Dimensions apply after finish</label>
      </fieldset>
    </form>
    <div>
      <p class="pv-sub">Your callout</p>
      <pre class="sb-out" data-out></pre>
      <p class="hint">Placeholders in &lt;angle brackets&gt; are yours to fill. Check every standard is the issue your programme invokes.</p>
      <p class="pv-sub">How v1 wrote it for this material</p>
      <pre class="sb-out sb-ex" data-ex></pre>
      <p class="pv-sub">Practical tips</p>
      <ul class="sb-tips" data-tips></ul>
    </div>
  </div>
  <script type="application/json" data-data set:html={JSON.stringify(sheets)}></script>
</div>

<style>
  .specb .inline { display: flex; align-items: center; gap: 0.4rem; }
  .specb .inline input { width: auto; }
  .specb .pv-sub { font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--rd-muted); margin: 0.9rem 0 0.4rem !important; }
  .specb .pv-sub:first-child { margin-top: 0 !important; }
  .sb-out {
    margin: 0 !important; padding: 0.8rem 0.9rem; white-space: pre; overflow-x: auto; font-family: var(--sl-font-mono); font-size: 0.74rem; line-height: 1.55;
    color: var(--sl-color-white); background: color-mix(in srgb, var(--rd-blue) 6%, transparent);
    border: 1px dashed var(--hud-edge-strong); border-left: 3px solid var(--pc, var(--sl-color-accent)); border-radius: 0 4px 4px 0;
  }
  .sb-ex { color: var(--sl-color-gray-2); border-left-color: var(--hud-edge-strong); }
  .sb-tips { font-size: var(--sl-text-sm); padding-left: 1.1rem; margin: 0 !important; }
</style>

<script>
  import { parseStandard, buildCallout, type SpecSheet } from '../lib/callout';

  document.querySelectorAll<HTMLElement>('[data-specb]').forEach((root) => {
    const sheets = JSON.parse(root.querySelector('[data-data]')!.textContent!) as SpecSheet[];
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLSelectElement | HTMLInputElement;
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`)!;
    const opts = (sel: HTMLSelectElement, items: string[], none?: string) => {
      sel.innerHTML = (none ? `<option value="-1">${none}</option>` : '') + items.map((t, i) => `<option value="${i}">${t}</option>`).join('');
    };
    const sheet = () => sheets[+field('sheet').value];

    function loadSheet() {
      const s = sheet();
      opts(field('form') as HTMLSelectElement, s.forms.map((f) => f.form));
      opts(field('temper') as HTMLSelectElement, s.tempers.map((t) => t.code), '— not stated —');
      (field('temper') as HTMLSelectElement).value = '0';
      opts(field('finish') as HTMLSelectElement, s.finishes.map((f) => f.name), '— none —');
      (field('finish') as HTMLSelectElement).value = s.finishes.length ? '0' : '-1';
      q('base').textContent = `${s.base}${s.composition ? ` · ${s.composition}` : ''}`;
      q('ex').textContent = s.callout || '—';
      q('tips').innerHTML = s.tips.map((t) => `<li>${t}</li>`).join('');
      loadForm();
    }
    function loadForm() {
      const f = sheet().forms[+field('form').value];
      const { alternatives } = parseStandard(f.standard);
      opts(field('std') as HTMLSelectElement, alternatives);
      run();
    }
    function run() {
      const s = sheet();
      const fi = +field('form').value, ti = +field('temper').value, ni = +field('finish').value;
      const f = s.forms[fi];
      const std = parseStandard(f.standard).alternatives[+field('std').value] ?? '';
      q('formnote').textContent = `${f.standard}${f.note ? ': ' + f.note : ''}`;
      q('tempnote').textContent = ti >= 0 ? s.tempers[ti].note : 'Leaving the condition off the drawing leaves it to the supplier.';
      q('finnote').textContent = ni >= 0 ? `${s.finishes[ni].spec}: ${s.finishes[ni].note}` : 'No finish called up.';
      q('out').textContent = buildCallout({
        sheet: s, formIndex: fi, standard: std, temperIndex: ti, finishIndex: ni,
        afterFinish: (field('after') as HTMLInputElement).checked, traceability: (field('trace') as HTMLInputElement).checked,
        certificate: (field('cert') as HTMLInputElement).checked,
      });
    }

    field('sheet').addEventListener('change', loadSheet);
    field('form').addEventListener('change', loadForm);
    form.addEventListener('change', (e) => { if (!['sheet', 'form'].includes((e.target as HTMLElement).getAttribute('name') ?? '')) run(); });
    root.querySelector('[data-copy]')!.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(q('out').textContent ?? ''); b.textContent = 'Copied'; }
      catch { b.textContent = 'Select and copy'; }
      setTimeout(() => (b.textContent = 'Copy callout'), 1800);
    });
    loadSheet();
  });
</script>
