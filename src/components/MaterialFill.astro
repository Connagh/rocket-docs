---
// "Fill from library": a material dropdown that copies library values into a calculator's own inputs. It starts blank,
// so the worked-example values stay until a material is picked; the inputs stay editable after the fill.
// Units: E, Fty, Ftu in MPa; kic in MPa√m. A material added to src/data/materials.json appears here when it has every
// property that the fill needs.
import MaterialSelect from './MaterialSelect.astro';
import { withProps, type Prop, type Kind } from '../lib/materials';

interface Props { fields: Partial<Record<'E' | 'nu' | 'Fty' | 'Ftu' | 'kic', string>>; kinds?: Kind[]; label?: string }
const { fields, kinds = ['metal'], label = 'Fill from the material library' } = Astro.props;
const props = Object.keys(fields) as Prop[];
const list = withProps(props, kinds);
const data = Object.fromEntries(list.map((m) => [m.key, Object.fromEntries(props.map((p) => [p, m[p as keyof typeof m]]))]));
---

<label class="mat-fill" data-mat-fill={JSON.stringify(fields)}>
  {label}
  <MaterialSelect name={`fill_${Object.values(fields).join('_')}`} list={list} blank="— keep the values below —" />
  <script type="application/json" set:html={JSON.stringify(data)}></script>
</label>

<style>
  .mat-fill { display: block; margin-bottom: 0.6rem; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mat-fill]').forEach((box) => {
    const fields: Record<string, string> = JSON.parse(box.dataset.matFill!);
    const data: Record<string, Record<string, number>> = JSON.parse(box.querySelector('script')!.textContent!);
    const select = box.querySelector('select')!;
    select.addEventListener('change', () => {
      const m = data[select.value];
      const form = select.form;
      if (!m || !form) return;
      for (const [prop, name] of Object.entries(fields)) {
        const input = form.elements.namedItem(name) as HTMLInputElement | null;
        if (!input || m[prop] === undefined) continue;
        input.value = String(Number(m[prop].toPrecision(6)));
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  });
</script>
