---
// Interactive "mass in vs mass out" chart: why a solid motor settles at one
// chamber pressure, and why the burn-rate exponent n must be below 1.
---

<div class="calc peq" data-peq>
  <div class="calc-head"><span>Chamber pressure balance</span><span>0-D model · AP/HTPB-like values</span></div>
  <div class="calc-body">
    <div>
      <fieldset>
        <legend>Motor</legend>
        <label>K<sub>n</sub> = burning area ÷ throat area: <output data-o="kn"></output>
          <input type="range" min="80" max="600" step="5" value="250" data-i="kn" />
        </label>
        <label>Pressure exponent n: <output data-o="n"></output>
          <input type="range" min="0.1" max="1.2" step="0.01" value="0.35" data-i="n" />
        </label>
        <label>Burn-rate coefficient a (mm/s at 1 MPa): <output data-o="a"></output>
          <input type="range" min="1.5" max="10" step="0.05" value="4.05" data-i="a" />
        </label>
        <p class="hint">Held fixed: propellant density 1770 kg/m³, c* 1540 m/s. Burn rate r = a·pⁿ with p in MPa.</p>
      </fieldset>
      <dl class="readouts">
        <div class="readout primary"><dt>Equilibrium p<sub>c</sub></dt><dd data-r="p">—</dd></div>
        <div class="readout"><dt>Burn rate there</dt><dd data-r="r">—</dd></div>
        <div class="readout"><dt>Amplification 1/(1−n)</dt><dd data-r="amp">—</dd></div>
        <div class="readout"><dt>K<sub>n</sub> +10% gives p<sub>c</sub></dt><dd data-r="kn10">—</dd></div>
      </dl>
      <p class="verdict" data-r="verdict"></p>
    </div>
    <figure class="peq-fig">
      <svg viewBox="0 0 520 340" role="img" aria-label="Mass generation and mass discharge versus chamber pressure">
        <g data-g="grid"></g>
        <path data-g="fillUp" fill="var(--rd-ok)" fill-opacity="0.12"></path>
        <path data-g="fillDn" fill="var(--rd-accent)" fill-opacity="0.10"></path>
        <path data-g="out" fill="none" stroke="var(--rd-blue)" stroke-width="2.5"></path>
        <path data-g="in" fill="none" stroke="var(--rd-hot)" stroke-width="2.5"></path>
        <g data-g="eq"></g>
        <g data-g="arrows"></g>
        <g data-g="legend" font-size="12">
          <line x1="70" y1="22" x2="92" y2="22" stroke="var(--rd-hot)" stroke-width="2.5"></line>
          <text x="98" y="26" fill="var(--rd-ink)">gas made by burning  ∝ pⁿ</text>
          <line x1="70" y1="42" x2="92" y2="42" stroke="var(--rd-blue)" stroke-width="2.5"></line>
          <text x="98" y="46" fill="var(--rd-ink)">gas leaving the throat  ∝ p</text>
        </g>
      </svg>
    </figure>
  </div>
  <div class="calc-foot">Drag n towards 1 and watch the two curves become parallel: the balance point runs away to very high pressure, and any disturbance is amplified instead of corrected.</div>
</div>

<style>
  .peq-fig { margin: 0; }
  .peq-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .peq label output { color: var(--rd-ink); font-family: var(--sl-font-mono); }
</style>

<script>
  import { equilibriumPressure, massIn, massOut, pressureSensitivity } from '../lib/ballistics';

  const NS = 'http://www.w3.org/2000/svg';
  const W = 520, H = 340, L = 62, R = 16, T = 60, B = 44;
  const fmt = (v: number, d = 2) => (Number.isFinite(v) ? v.toFixed(d) : '—');

  document.querySelectorAll<HTMLElement>('[data-peq]').forEach((root) => {
    const inp = (k: string) => root.querySelector<HTMLInputElement>(`[data-i="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const g = (k: string) => root.querySelector<SVGElement>(`[data-g="${k}"]`)!;
    const el = (tag: string, attrs: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (text) e.textContent = text;
      return e;
    };

    function draw() {
      const b = { rhoP: 1770, cStar: 1540, kn: +inp('kn').value, n: +inp('n').value, a: +inp('a').value };
      out('kn').textContent = String(b.kn);
      out('n').textContent = b.n.toFixed(2);
      out('a').textContent = b.a.toFixed(2);

      const peq = equilibriumPressure(b);
      const pMax = Number.isFinite(peq) && peq < 40 ? Math.max(8, peq * 1.8) : 20;
      // flux in kg/s per cm² of throat
      const fin = (p: number) => massIn(b, p) / 1e4;
      const fout = (p: number) => massOut(b, p) / 1e4;
      const yMax = fout(pMax) * 1.15;
      const X = (p: number) => L + (p / pMax) * (W - L - R);
      const Y = (f: number) => H - B - (Math.min(f, yMax * 1.05) / yMax) * (H - B - T);

      const N = 80;
      const ps = Array.from({ length: N + 1 }, (_, i) => (i / N) * pMax);
      const line = (f: (p: number) => number) => ps.map((p, i) => `${i ? 'L' : 'M'}${X(p).toFixed(1)},${Y(f(p)).toFixed(1)}`).join('');
      g('in').setAttribute('d', line(fin));
      g('out').setAttribute('d', line(fout));

      // shade the gap: green where gas accumulates (pressure rises), red where it drains
      const band = (cond: (p: number) => boolean) => {
        const sel = ps.filter(cond);
        if (sel.length < 2) return '';
        const top = sel.map((p, i) => `${i ? 'L' : 'M'}${X(p).toFixed(1)},${Y(Math.max(fin(p), fout(p))).toFixed(1)}`).join('');
        const bot = [...sel].reverse().map((p) => `L${X(p).toFixed(1)},${Y(Math.min(fin(p), fout(p))).toFixed(1)}`).join('');
        return top + bot + 'Z';
      };
      g('fillUp').setAttribute('d', band((p) => p > 0 && fin(p) >= fout(p)));
      g('fillDn').setAttribute('d', band((p) => p > 0 && fin(p) < fout(p)));

      // axes + grid
      const grid = g('grid');
      grid.replaceChildren();
      const step = pMax > 24 ? 5 : pMax > 12 ? 2 : 1;
      for (let p = 0; p <= pMax + 1e-9; p += step) {
        grid.append(el('line', { x1: X(p), x2: X(p), y1: T, y2: H - B, stroke: 'var(--rd-line)', 'stroke-width': 1 }));
        grid.append(el('text', { x: X(p), y: H - B + 16, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, String(p)));
      }
      grid.append(el('line', { x1: L, x2: W - R, y1: H - B, y2: H - B, stroke: 'var(--rd-muted)' }));
      grid.append(el('line', { x1: L, x2: L, y1: T, y2: H - B, stroke: 'var(--rd-muted)' }));
      grid.append(el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'chamber pressure, MPa'));
      grid.append(el('text', { x: 16, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 16 ${(T + H - B) / 2})` }, 'mass flow, kg/s per cm² throat'));

      const eq = g('eq');
      const arrows = g('arrows');
      eq.replaceChildren();
      arrows.replaceChildren();
      const stable = Number.isFinite(peq) && peq <= pMax;
      if (stable) {
        eq.append(el('line', { x1: X(peq), x2: X(peq), y1: Y(fout(peq)), y2: H - B, stroke: 'var(--rd-ink)', 'stroke-dasharray': '4 4' }));
        eq.append(el('circle', { cx: X(peq), cy: Y(fout(peq)), r: 6, fill: 'var(--rd-panel)', stroke: 'var(--rd-ink)', 'stroke-width': 2.5 }));
        eq.append(el('text', { x: X(peq) + 10, y: Y(fout(peq)) - 10, 'font-size': 12, fill: 'var(--rd-ink)' }, `balance ${peq.toFixed(1)} MPa`));
        // restoring arrows on the axis
        const ay = H - B - 14;
        const a1 = Math.max(L + 4, X(peq * 0.45)), a2 = Math.min(W - R - 4, X(peq * 1.5));
        arrows.append(el('path', { d: `M${a1},${ay} L${X(peq) - 10},${ay} m-7,-5 l7,5 l-7,5`, stroke: 'var(--rd-ok)', fill: 'none', 'stroke-width': 2 }));
        arrows.append(el('path', { d: `M${a2},${ay} L${X(peq) + 10},${ay} m7,-5 l-7,5 l7,5`, stroke: 'var(--rd-ok)', fill: 'none', 'stroke-width': 2 }));
      }

      const rate = stable ? b.a * Math.pow(peq, b.n) : NaN;
      r('p').innerHTML = stable ? `${fmt(peq)} <small>MPa · ${fmt(peq * 10, 0)} bar</small>` : '—';
      r('r').innerHTML = stable ? `${fmt(rate, 1)} <small>mm/s</small>` : '—';
      r('amp').textContent = b.n < 1 ? `×${fmt(pressureSensitivity(b.n))}` : '∞';
      r('kn10').textContent = stable ? `+${fmt((Math.pow(1.1, 1 / (1 - b.n)) - 1) * 100, 1)} %` : '—';

      const v = r('verdict');
      if (b.n >= 1) {
        v.className = 'verdict bad';
        v.textContent = 'n ≥ 1: no stable balance. A small pressure rise makes gas faster than the throat can pass it, which raises pressure further: the motor either over-pressurises or extinguishes.';
      } else if (!stable) {
        v.className = 'verdict warn';
        v.textContent = 'Balance is off the chart at an unrealistically high pressure. Lower Kn or n.';
      } else if (b.n > 0.7) {
        v.className = 'verdict warn';
        v.textContent = `Stable, but very sensitive: any 1% change in burning area, burn rate or throat area moves pressure by ${fmt(pressureSensitivity(b.n), 1)}%. Real propellants are usually chosen with n around 0.3–0.5.`;
      } else {
        v.className = 'verdict ok';
        v.textContent = 'Stable. Left of the balance point the motor makes gas faster than it can escape, so pressure rises; right of it, gas drains faster than it is made, so pressure falls. Either way it returns to the balance point.';
      }
    }

    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', draw));
    draw();
  });
</script>
