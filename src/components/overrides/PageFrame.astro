---
// Wraps Starlight's frame with the deep-field sky, the phase colour tokens
// (generated from the zone plan, so they can never drift), and scroll telemetry.
import Default from '@astrojs/starlight/components/PageFrame.astro';
import SpaceSky from '../hud/SpaceSky.astro';
import BlackHole from '../hud/BlackHole.astro';
import { PHASES, route, toSlug } from '../../data/zones.mjs';

const tokens =
  `:root{${PHASES.map((p) => `--ph-${p.k}:${p.dark};`).join('')}}` +
  `:root[data-theme='light']{${PHASES.map((p) => `--ph-${p.k}:${p.light};`).join('')}}`;
const here = route().find((r) => r.slug !== null && r.slug === toSlug(Astro.url.pathname, import.meta.env.BASE_URL));
const pc = here ? `var(--ph-${here.phase})` : 'var(--sl-color-accent)';
---

<style is:inline set:html={tokens + `:root{--pc:${pc};}`}></style>
<SpaceSky />
<BlackHole />
<div id="scrollTelemetry" aria-hidden="true"><i></i></div>
<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>

<script>
  const bar = document.querySelector<HTMLElement>('#scrollTelemetry i');
  const update = () => {
    if (!bar) return;
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    bar.style.transform = `scaleX(${Math.min(1, scrollY / max)})`;
  };
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();

  // 3D tilt and a cursor glow on the home cards: fine pointers only, never under PAUSE MOTION or reduced motion
  const root = document.documentElement;
  const calm = () => root.classList.contains('motion-off') || matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.mh-way, .mh-task, .mh-station').forEach((el) => {
      el.classList.add('tilt');
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        el.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
        el.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
        el.style.transform = calm() ? '' : `perspective(700px) rotateX(${((0.5 - y) * 7).toFixed(2)}deg) rotateY(${((x - 0.5) * 9).toFixed(2)}deg) translateZ(6px)`;
      });
      el.addEventListener('pointerleave', () => { el.style.transform = ''; });
    });
  }
</script>
