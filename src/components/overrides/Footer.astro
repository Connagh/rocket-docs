---
// Route footer: what comes next on the route, and the rest of this phase.
// Replaces Starlight's pagination, which followed the sidebar config instead of the zone plan.
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import { PHASES, route, hrefOf, toSlug } from '../../data/zones.mjs';

const base = import.meta.env.BASE_URL;
const slug = toSlug(Astro.url.pathname, base);
const items = route();
const here = items.find((r) => r.slug !== null && r.slug === slug);
const v2 = items.filter((z) => z.slug !== null);
const at = here ? v2.findIndex((z) => z.key === here.key) : -1;
const prev = at > 0 ? v2[at - 1] : null;
const next = at >= 0 && at < v2.length - 1 ? v2[at + 1] : null;
const ph = here ? PHASES.find((p) => p.k === here.phase)! : null;
const phaseRest = here ? items.filter((z) => z.phase === here.phase && z.key !== here.key) : [];
const phaseOfItem = (k: string) => PHASES.find((p) => p.k === k)!;
---

<footer class="route-foot">
  <div class="rf-meta"><LastUpdated /></div>
  {(prev || next) && (
    <nav class="rf-pager" aria-label="Previous and next on the route">
      {prev ? (
        <a class="rf-card prev" href={hrefOf(prev, base)} style={`--pc: var(--ph-${prev.phase})`}>
          <span class="rf-k">‹ PREVIOUS · {phaseOfItem(prev.phase).n} · {prev.tag}</span>
          <span class="rf-t">{prev.label}</span>
        </a>
      ) : <span></span>}
      {next && (
        <a class="rf-card next" href={hrefOf(next, base)} style={`--pc: var(--ph-${next.phase})`}>
          <span class="rf-k">NEXT ON THE ROUTE · {phaseOfItem(next.phase).n} · {next.tag} ›</span>
          <span class="rf-t">{next.label}</span>
        </a>
      )}
    </nav>
  )}
  {ph && phaseRest.length > 0 && (
    <section class="rf-phase" style={`--pc: var(--ph-${ph.k})`}>
      <p class="rf-k">ALSO IN {ph.n} — {ph.sub.toUpperCase()}</p>
      <div class="rf-chips">
        {phaseRest.map((z) => (
          <a href={hrefOf(z, base)} class:list={['rf-chip', z.slug !== null ? 'v2' : 'v1']}
            title={z.slug === null ? 'Opens in the v1 archive' : undefined}>
            <span class="zn">{z.tag}</span>{z.label}{z.slug === null && <span class="tag">v1</span>}
          </a>
        ))}
      </div>
    </section>
  )}
  <p class="rf-disclaimer">
    Reference aid for learning and early design. Values are typical published data and screening methods — verify against the
    current issue of the governing standard, your organisation's approved data and programme requirements before release.
  </p>
</footer>
