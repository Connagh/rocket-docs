---
// Zone banner + title. Derived entirely from the zone plan (src/data/zones.mjs):
// phase planet, PHASE x OF 8 · STEP y OF z, a dot per zone in the phase (filled =
// rebuilt in v2, hollow = v1 archive), and prev/next through the v2 pages.
// The home page gets the mission-control hero instead.
const PAGE_TITLE_ID = '_top'; // Starlight's title anchor (the table of contents links to it)
import { PHASES, ZONE_PLAN, BRIEFING, route, hrefOf, toSlug } from '../../data/zones.mjs';

const base = import.meta.env.BASE_URL;
const title = Astro.locals.starlightRoute.entry.data.title;
const slug = toSlug(Astro.url.pathname, base);
const items = route();
const here = items.find((r) => r.slug !== null && r.slug === slug);
const isHome = slug === '';
const briefing = BRIEFING.find((b) => b.slug === slug);

const ph = here ? PHASES.find((p) => p.k === here.phase)! : null;
const inPhase = here ? items.filter((z) => z.phase === here.phase) : [];
const step = here ? inPhase.filter((z) => !z.primer).findIndex((z) => z.key === here.key) + 1 : 0;
const v2 = items.filter((z) => z.slug !== null);
const at = here ? v2.findIndex((z) => z.key === here.key) : -1;
const prev = at > 0 ? v2[at - 1] : null;
const next = at >= 0 && at < v2.length - 1 ? v2[at + 1] : null;
const v2Count = items.filter((z) => !z.primer && z.slug !== null).length;
const rev = new Date().toISOString().slice(0, 10);
---

{isHome ? (
  <header class="hero-hud">
    <p class="hero-kicker"><span class="dot" aria-hidden="true"></span>MISSION REFERENCE · SOLID ROCKET MOTOR &amp; MECHANICAL DESIGN</p>
    <h1 id={PAGE_TITLE_ID} class="hero-title">REF<span class="stamp">·</span>DB</h1>
    <p class="hero-tag">
      Learn the concept, see it, then run the numbers. A working reference for solid rocket motor hardware — cases,
      grains, insulation, seals, materials — built so a newcomer can learn it and an engineer can use it.
    </p>
    <dl class="hero-meta">
      <div><dt>REV</dt><dd>v2 · {rev}</dd></div>
      <div><dt>ZONES</dt><dd>{v2Count}/{ZONE_PLAN.length} rebuilt</dd></div>
      <div><dt>PHASES</dt><dd>{PHASES.length}</dd></div>
      <div><dt>SCALE</dt><dd>NTS · THIRD ANGLE</dd></div>
    </dl>
  </header>
) : (
  <>
    {here && ph && (
      <nav class="zone-banner" style={`--pc: var(--ph-${ph.k})`} aria-label="Where this page sits in the route">
        <svg class="zb-planet" viewBox="0 0 40 40" aria-hidden="true">
          <defs>
            <radialGradient id="zbGrad" cx=".35" cy=".35" r=".75">
              <stop offset="0" stop-color="#fff" stop-opacity=".9"></stop><stop offset=".38" stop-color={`var(--ph-${ph.k})`}></stop><stop offset="1" stop-color="#000"></stop>
            </radialGradient>
          </defs>
          <ellipse cx="20" cy="20" rx="19" ry="6" fill="none" stroke={`var(--ph-${ph.k})`} stroke-width="1" opacity=".55" transform="rotate(-18 20 20)"></ellipse>
          <circle cx="20" cy="20" r="11.5" fill="url(#zbGrad)"></circle>
        </svg>
        <div class="zb-txt">
          <span class="zb-phase">
            PHASE {PHASES.indexOf(ph) + 1} OF {PHASES.length} · {ph.n} · {here.primer ? 'PRIMER' : `STEP ${step} OF ${inPhase.filter((z) => !z.primer).length}`} · {here.tag}
          </span>
          <span class="zb-sub">{ph.sub} — {ph.d}</span>
          <span class="zb-steps">
            {inPhase.map((z) => (
              <a href={hrefOf(z, base)} class:list={[z.slug !== null ? 'v2' : 'v1', { here: z.key === here.key, primer: z.primer }]}
                title={`${z.tag} ${z.label}${z.slug === null ? ' (v1 archive)' : ''}`}
                aria-label={`${z.tag} ${z.label}${z.key === here.key ? ' (this page)' : ''}${z.slug === null ? ', v1 archive' : ''}`}></a>
            ))}
          </span>
        </div>
        <div class="zb-nav">
          {prev ? <a href={hrefOf(prev, base)} title={`${prev.tag} ${prev.label}`}><span>‹ PREV</span><small>{prev.tag}</small></a>
                : <span class="off">‹ PREV</span>}
          {next ? <a href={hrefOf(next, base)} title={`${next.tag} ${next.label}`}><span>NEXT ›</span><small>{next.tag}</small></a>
                : <span class="off">NEXT ›</span>}
        </div>
      </nav>
    )}
    {briefing && (
      <p class="brief-kicker"><span class="dot" aria-hidden="true"></span>MISSION BRIEFING</p>
    )}
    <h1 id={PAGE_TITLE_ID} class="page-title">{title}</h1>
  </>
)}
