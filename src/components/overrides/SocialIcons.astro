---
// Header HUD: mission elapsed time, the PAUSE MOTION switch, and the source link.
---

<span class="hud-met" aria-hidden="true"><span class="k">MET</span><span data-met>T+00:00:00</span></span>
<button type="button" class="hud-chip" data-motion-switch aria-pressed="false" title="Pause the background and all animation">
  <span class="v" data-motion-label>PAUSE MOTION</span>
</button>
<a class="hud-icon" href="https://github.com/dashroyy/ref-db" rel="me" title="Source on GitHub">
  <span class="sr-only">Source on GitHub</span>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
    <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/>
  </svg>
</a>

<script>
  const root = document.documentElement;
  const KEY = 'refdb-motion';
  const sync = () => {
    const off = root.classList.contains('motion-off');
    document.querySelectorAll('[data-motion-label]').forEach((el) => (el.textContent = off ? 'RESUME MOTION' : 'PAUSE MOTION'));
    document.querySelectorAll('[data-motion-switch]').forEach((el) => el.setAttribute('aria-pressed', String(off)));
  };
  document.querySelectorAll('[data-motion-switch]').forEach((b) =>
    b.addEventListener('click', () => {
      const off = !root.classList.contains('motion-off');
      root.classList.toggle('motion-off', off);
      try { localStorage.setItem(KEY, off ? 'off' : 'on'); } catch {}
      sync();
    }),
  );
  sync();
  // Mission elapsed time since the page opened.
  const t0 = performance.now();
  const pad = (n: number) => String(n).padStart(2, '0');
  const tick = () => {
    const s = Math.floor((performance.now() - t0) / 1000);
    const txt = `T+${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
    document.querySelectorAll('[data-met]').forEach((el) => (el.textContent = txt));
  };
  setInterval(tick, 1000);
</script>
