---
// Dark is the default (REF·DB rule): only an explicit 'light' choice changes it.
// Motion preference is applied here too, before first paint. Storage is guarded:
// it throws in opaque origins and some file:// contexts.
---

<script is:inline>
  (() => {
    const get = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
    const root = document.documentElement;
    root.dataset.theme = get('starlight-theme') === 'light' ? 'light' : 'dark';
    if (get('refdb-motion') === 'off') root.classList.add('motion-off');
    // Starlight components call this; our theme switch keeps its own state.
    window.StarlightThemeProvider = { updatePickers() {} };
  })();
</script>
