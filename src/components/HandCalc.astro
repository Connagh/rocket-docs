---
// Hand calcs in five tabs — beam, flat plate, thin shell, lug and pin, column — each with its readouts, margins once the
// programme's factors are entered, and a chart. Maths in src/lib/handcalc.ts (unit-tested); UI only here.
import { BEAM_CASES } from '../lib/handcalc';

const TABS = [
  { key: 'beam', name: 'Beam' }, { key: 'plate', name: 'Plate' }, { key: 'shell', name: 'Shell' },
  { key: 'lug', name: 'Lug & pin' }, { key: 'column', name: 'Column' },
];
const SECTIONS = [
  { key: 'tube', name: 'Round tube' }, { key: 'round', name: 'Solid round' },
  { key: 'rect', name: 'Rectangle' }, { key: 'rhs', name: 'Rectangular tube' },
];
---

<div class="calc hccalc" data-hccalc>
  <div class="calc-head"><span>Hand calcs</span><span class="head-btns"><span>first-cut checks</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Hand calc">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="beam">
        <legend>Beam</legend>
        <label>Supports and load<select name="b_case">{BEAM_CASES.map((c) => <option value={c.key} selected={c.key === 'ss-udl'}>{c.name}</option>)}</select></label>
        <div class="row2">
          <label>Load, or total uniform load (N)<input name="b_W" type="number" min="0" step="any" value="4054" /></label>
          <label>Span (mm)<input name="b_L" type="number" min="0.1" step="any" value="1000" /></label>
        </div>
        <label>Section<select name="b_kind">{SECTIONS.map((s) => <option value={s.key}>{s.name}</option>)}</select></label>
        <div class="row2">
          <label data-dim="b_d1"><span>Outside ⌀ (mm)</span><input name="b_d1" type="number" min="0" step="any" value="302.754" /></label>
          <label data-dim="b_d2"><span>Wall (mm)</span><input name="b_d2" type="number" min="0" step="any" value="1.377" /></label>
          <label data-dim="b_d3"><span>Wall (mm)</span><input name="b_d3" type="number" min="0" step="any" value="2" /></label>
          <label>E (MPa)<input name="b_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Yield F<sub>ty</sub> (MPa)<input name="b_fty" type="number" min="0" step="any" value="1450" /></label>
          <label>Ultimate F<sub>tu</sub> (MPa)<input name="b_ftu" type="number" min="0" step="any" value="1520" /></label>
        </div>
      </fieldset>

      <fieldset data-panel="plate" hidden>
        <legend>Flat plate, uniform pressure</legend>
        <div class="row2">
          <label>Shape<select name="p_shape"><option value="circ">Circular</option><option value="rect">Rectangular</option></select></label>
          <label>Edges<select name="p_edge"><option value="ss">Simply supported</option><option value="clamped">Clamped</option></select></label>
          <label>Pressure (MPa)<input name="p_q" type="number" min="0" step="any" value="11" /></label>
          <label data-dim="p_a"><span>Radius (mm)</span><input name="p_a" type="number" min="0.1" step="any" value="142.5" /></label>
          <label data-dim="p_b"><span>Short side (mm)</span><input name="p_b" type="number" min="0.1" step="any" value="200" /></label>
          <label>Thickness (mm)<input name="p_t" type="number" min="0.01" step="any" value="25" /></label>
          <label>E (MPa)<input name="p_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Poisson's ratio<input name="p_nu" type="number" min="0" max="0.5" step="0.01" value="0.29" /></label>
          <label>Yield F<sub>ty</sub> (MPa)<input name="p_fty" type="number" min="0" step="any" value="655" /></label>
          <label>Ultimate F<sub>tu</sub> (MPa)<input name="p_ftu" type="number" min="0" step="any" value="860" /></label>
        </div>
        <p class="hint">Rectangular-plate coefficients are for ν = 0.3. A bolted cover sits between simply supported and clamped — run both.</p>
      </fieldset>

      <fieldset data-panel="shell" hidden>
        <legend>Thin cylinder, internal pressure</legend>
        <div class="row2">
          <label>Pressure (MPa)<input name="s_p" type="number" min="0" step="any" value="10" /></label>
          <label>Mean radius (mm)<input name="s_r" type="number" min="0.1" step="any" value="150.69" /></label>
          <label>Wall (mm)<input name="s_t" type="number" min="0.01" step="any" value="1.377" /></label>
          <label>Ends<select name="s_end"><option value="closed">Closed</option><option value="open">Open</option></select></label>
          <label>E (MPa)<input name="s_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Poisson's ratio<input name="s_nu" type="number" min="0" max="0.5" step="0.01" value="0.29" /></label>
          <label>Yield F<sub>ty</sub> (MPa)<input name="s_fty" type="number" min="0" step="any" value="1450" /></label>
          <label>Ultimate F<sub>tu</sub> (MPa)<input name="s_ftu" type="number" min="0" step="any" value="1520" /></label>
        </div>
        <p class="hint">Margins are on the hoop stress, away from the ends. The clamped edge is a bound: a real flange also grows and rotates.</p>
      </fieldset>

      <fieldset data-panel="lug" hidden>
        <legend>Lug in a double-shear clevis</legend>
        <div class="row2">
          <label>Load along the lug (N)<input name="l_P" type="number" min="0" step="any" value="29452" /></label>
          <label>Lug thickness (mm)<input name="l_t" type="number" min="0.1" step="any" value="10" /></label>
          <label>Lug width (mm)<input name="l_W" type="number" min="0.1" step="any" value="36" /></label>
          <label>Hole centre to end (mm)<input name="l_e" type="number" min="0.1" step="any" value="18" /></label>
          <label>Hole ⌀ (mm)<input name="l_D" type="number" min="0.1" step="any" value="12.2" /></label>
          <label>Pin ⌀ (mm)<input name="l_d" type="number" min="0.1" step="any" value="12" /></label>
          <label>Each clevis plate (mm)<input name="l_t2" type="number" min="0" step="any" value="6" /></label>
          <label>Gap, lug to clevis (mm)<input name="l_g" type="number" min="0" step="any" value="0.5" /></label>
          <label>Lug F<sub>tu</sub> (MPa)<input name="l_ftu" type="number" min="0" step="any" value="470" /></label>
          <label>Lug F<sub>su</sub> (MPa)<input name="l_fsu" type="number" min="0" step="any" value="282" /></label>
          <label>Lug F<sub>bru</sub> (MPa)<input name="l_fbru" type="number" min="0" step="any" value="705" /></label>
          <label>Pin F<sub>tu</sub> (MPa)<input name="l_pftu" type="number" min="0" step="any" value="1000" /></label>
          <label>Pin F<sub>su</sub> (MPa)<input name="l_pfsu" type="number" min="0" step="any" value="600" /></label>
        </div>
        <p class="hint">Use your allowables: bearing F<sub>bru</sub> depends on the edge distance ratio e/D. Check the clevis plates the same way with half the load each.</p>
      </fieldset>

      <fieldset data-panel="column" hidden>
        <legend>Column, end load</legend>
        <div class="row2">
          <label>Load (N)<input name="c_P" type="number" min="0" step="any" value="29452" /></label>
          <label>Length (mm)<input name="c_L" type="number" min="0.1" step="any" value="600" /></label>
          <label>Effective-length factor K<input name="c_K" type="number" min="0.1" step="any" value="1" /></label>
          <label>Eccentricity (mm)<input name="c_e" type="number" min="0" step="any" value="0.6" /></label>
        </div>
        <p class="hint">K: 1.0 pinned–pinned; design values 2.1 fixed–free, 0.8 fixed–pinned, 0.65 fixed–fixed. Eccentricity can stand in for crookedness — L/1000 is a common assumption.</p>
        <label>Section<select name="c_kind">{SECTIONS.map((s) => <option value={s.key}>{s.name}</option>)}</select></label>
        <div class="row2">
          <label data-dim="c_d1"><span>Outside ⌀ (mm)</span><input name="c_d1" type="number" min="0" step="any" value="25" /></label>
          <label data-dim="c_d2"><span>Wall (mm)</span><input name="c_d2" type="number" min="0" step="any" value="2.5" /></label>
          <label data-dim="c_d3"><span>Wall (mm)</span><input name="c_d3" type="number" min="0" step="any" value="2" /></label>
          <label>E (MPa)<input name="c_E" type="number" min="1" step="any" value="205000" /></label>
          <label>Yield F<sub>ty</sub> (MPa)<input name="c_fty" type="number" min="1" step="any" value="355" /></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Your programme's factors</legend>
        <div class="row2">
          <label>Yield factor<input name="fy" type="number" min="1" step="0.01" placeholder="your value" autocomplete="off" /></label>
          <label>Ultimate factor<input name="fu" type="number" min="1" step="0.01" placeholder="your value" autocomplete="off" /></label>
        </div>
        <p class="hint">Each multiplies the load you enter. Buckling and the lug checks use the ultimate factor; first yield uses the yield factor.</p>
        <p class="hint example-note" data-example-note hidden></p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected hand calc"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Linear elastic, small deflection, closed-form idealisations: beam theory, Roark's plate solutions, thin-shell membrane
    and edge bending, first-cut lug and pin checks, Euler and Johnson columns with the secant formula. First answers, to
    size a part and to check a finite-element model — not a substitute for either.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .hccalc .readout dd small { display: block; margin-top: 0.15rem; }
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .hccalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { BEAM_CASES, section, shearStress, beam, circularPlate, rectPlate, rectCoefficients, shell, lugChecks, column, secantStress, type SectionKind, type BeamCase } from '../lib/handcalc';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const g3 = (v: number) => (Math.abs(v) >= 100 ? f(v, 0) : Math.abs(v) >= 10 ? f(v, 1) : Math.abs(v) >= 1 ? f(v, 2) : f(v, 3));
  const sci = (v: number) => { const e = Math.floor(Math.log10(Math.abs(v))); return e >= -2 && e < 5 ? g3(v) : `${f(v / 10 ** e, 2)}×10<sup>${e}</sup>`; };
  const sgn = (v: number) => `${v >= 0 ? '+' : ''}${f(v, 2)}`;
  const DIMS: Record<SectionKind, (string | null)[]> = {
    tube: ['Outside ⌀ (mm)', 'Wall (mm)', null], round: ['Diameter (mm)', null, null],
    rect: ['Width (mm)', 'Depth (mm)', null], rhs: ['Width (mm)', 'Depth (mm)', 'Wall (mm)'],
  };
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-hccalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const halo = { stroke: 'var(--rd-panel)', 'stroke-width': 4, 'paint-order': 'stroke', 'stroke-linejoin': 'round' };
    let mode = 'beam';
    let draw: (() => void) | null = null;

    // ---- chart helpers ----
    const nice = (span: number) => { const m = 10 ** Math.floor(Math.log10(span / 5)); return [1, 2, 2.5, 5, 10].map((x) => x * m).find((x) => span / x <= 6)!; };
    function frame(o: { x0: number; x1: number; y0: number; y1: number; xl: string; yl: string; fx?: (v: number) => string }) {
      svg.replaceChildren();
      const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 250, L = 56, R = 20, T = 30, B = 40;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const X = (v: number) => L + ((v - o.x0) / (o.x1 - o.x0)) * (W - L - R), Y = (v: number) => T + ((o.y1 - v) / (o.y1 - o.y0)) * (H - T - B);
      const sx = nice(o.x1 - o.x0), sy = nice(o.y1 - o.y0), dp = (s: number) => (s >= 1 ? 0 : s >= 0.1 ? 1 : 2);
      const z = (v: number) => (Math.abs(v) < 1e-9 ? 0 : v), xFirst = Math.ceil(o.x0 / sx - 1e-9) * sx;
      for (let v = xFirst; v <= o.x1 + 1e-9; v += sx) {
        el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: 'var(--rd-line)' });
        el('text', { x: X(v), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, o.fx ? o.fx(z(v)) : f(z(v), dp(sx)));
      }
      // the bottom y label would sit on the first x label when both axes start on a tick
      for (let v = Math.ceil(o.y0 / sy - 1e-9) * sy; v <= o.y1 + 1e-9; v += sy) {
        if (Math.abs(v - o.y0) < 1e-9 && Math.abs(xFirst - o.x0) < 1e-9) continue;
        el('text', { x: L - 6, y: Y(v) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, f(z(v), dp(sy)));
      }
      if (o.y0 < 0 && o.y1 > 0) el('line', { x1: L, x2: W - R, y1: Y(0), y2: Y(0), stroke: 'var(--rd-ink)', 'stroke-opacity': 0.5 });
      el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, o.xl);
      el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, o.yl);
      return { X, Y, W, H, L, R, T, B };
    }
    const poly = (pts: [number, number][], color: string, w = 2.2, dash = '') =>
      el('polyline', { points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), fill: 'none', stroke: color, 'stroke-width': w, ...(dash ? { 'stroke-dasharray': dash } : {}) });
    const legend = (items: [string, string, string?][]) => {
      let x = 8;
      for (const [name, color, dash] of items) {
        el('line', { x1: x, x2: x + 18, y1: 13, y2: 13, stroke: color, 'stroke-width': 2.2, ...(dash ? { 'stroke-dasharray': dash } : {}) });
        el('text', { x: x + 23, y: 17, 'font-size': 12, fill: 'var(--rd-ink)' }, name);
        x += 37 + name.length * 7.2;
      }
    };
    const span = (vals: number[], pad = 0.1) => { let lo = Math.min(...vals), hi = Math.max(...vals); const p = (hi - lo || Math.abs(hi) || 1) * pad; return [lo - p, hi + p]; };

    // ---- margins ----
    const factors = () => ({ fy: readFactor(field('fy').value), fu: readFactor(field('fu').value) });
    const msRow = (dt: string, factor: number | null, name: string, allow: number, stress: number): Row => {
      if (factor === null) return { dt, dd: `<small>${awaitingMessage([name], 'this margin')}</small>` };
      if (!(allow > 0)) return { dt, dd: '— <small>enter the allowable</small>' };
      const ms = allow / (factor * stress) - 1;
      return { dt, dd: `MS ${sgn(ms)} <small>${f(factor, 2)} × ${g3(stress)} MPa against ${g3(allow)} MPa</small>`, cls: ms < 0 ? 'bad' : 'ok' };
    };

    function dims(prefix: string) {
      const kind = field(`${prefix}_kind`).value as SectionKind;
      DIMS[kind].forEach((lab, i) => {
        const l = root.querySelector<HTMLElement>(`[data-dim="${prefix}_d${i + 1}"]`)!;
        l.hidden = lab === null;
        if (lab) l.querySelector('span')!.textContent = lab;
      });
      return section(kind, num(`${prefix}_d1`), num(`${prefix}_d2`), num(`${prefix}_d3`));
    }

    // ---- the five calcs ----
    function runBeam(rows: Row[], notes: [string, string][]) {
      const kind = field('b_case').value as BeamCase, W = num('b_W'), L = num('b_L'), E = num('b_E');
      const s = dims('b');
      if (!s || !(W >= 0 && L > 0 && E > 0)) { notes.push(['bad', 'Check the section dimensions, span, load and modulus.']); return null; }
      const b = beam(kind, W, L, E * s.I), sigma = b.M / s.Z, tau = shearStress(b.V, s);
      const where = kind.startsWith('cant') ? 'at the root' : kind === 'ff-udl' ? 'at the ends' : kind === 'ff-point' ? 'at the ends and mid-span' : 'at mid-span';
      const { fy, fu } = factors();
      rows.push(
        { dt: 'Bending stress', dd: `${g3(sigma)} MPa <small>M = ${g3(b.M / 1e6)} kN·m, ${where}</small>`, primary: true },
        { dt: 'Shear stress', dd: `${g3(tau)} MPa <small>peak, at the neutral axis · V = ${g3(b.V / 1000)} kN</small>` },
        { dt: 'Deflection', dd: `${g3(b.delta)} mm <small>span / ${f(L / b.delta, 0)}</small>` },
        { dt: 'Section', dd: `Z = ${sci(s.Z)} mm³ <small>I = ${sci(s.I)} mm⁴ · A = ${sci(s.A)} mm²</small>` },
        msRow('Yield margin', fy, 'yield factor', num('b_fty'), sigma),
        msRow('Ultimate margin', fu, 'ultimate factor', num('b_ftu'), sigma),
      );
      if (L / s.c < 10) notes.push(['warn', `A short, deep beam (span ${f(L / (2 * s.c), 1)} × its depth): shear deflection and local effects at the supports matter, and beam theory is only approximate.`]);
      if (field('b_kind').value === 'tube' && 2 * s.c / num('b_d2') > 50) notes.push(['', `A thin tube (D/t = ${f((2 * s.c) / num('b_d2'), 0)}): beam bending is rarely what fails it. Check local loads where it is supported, and buckling under bending — see <a href="../../verify/shell-buckling/">Shell buckling</a>.`]);
      return () => {
        const xs = Array.from({ length: 121 }, (_, i) => (L * i) / 120);
        const Ms = xs.map((x) => b.Mx(x) / 1e6), [lo, hi] = span([...Ms, 0], 0.15);
        const c = frame({ x0: 0, x1: L, y0: lo, y1: hi, xl: 'position along the span (mm)', yl: 'moment (kN·m)' });
        el('path', { d: `M${c.X(0)},${c.Y(0)} ` + xs.map((x, i) => `L${c.X(x).toFixed(1)},${c.Y(Ms[i]).toFixed(1)}`).join(' ') + ` L${c.X(L)},${c.Y(0)} Z`, fill: 'var(--rd-blue)', 'fill-opacity': 0.18, stroke: 'none' });
        poly(xs.map((x, i) => [c.X(x), c.Y(Ms[i])]), 'var(--rd-blue)');
        // deflected shape, scaled to a third of the plot height, drawn downwards from the top
        const ws = xs.map(b.wx), wmax = Math.max(...ws) || 1, h = (c.H - c.T - c.B) / 3;
        poly(xs.map((x, i) => [c.X(x), c.T + 6 + (ws[i] / wmax) * h]), 'var(--rd-accent)', 1.8, '5 3');
        legend([['moment', 'var(--rd-blue)'], ['deflected shape', 'var(--rd-accent)', '5 3']]);
      };
    }

    function runPlate(rows: Row[], notes: [string, string][]) {
      const circ = field('p_shape').value === 'circ', edge = field('p_edge').value as 'ss' | 'clamped';
      root.querySelector<HTMLElement>('[data-dim="p_a"] span')!.textContent = circ ? 'Radius (mm)' : 'Long side (mm)';
      root.querySelector<HTMLElement>('[data-dim="p_b"]')!.hidden = circ;
      const q = num('p_q'), a = num('p_a'), b = num('p_b'), t = num('p_t'), E = num('p_E'), nu = num('p_nu');
      if (!(q >= 0 && a > 0 && t > 0 && E > 0 && nu >= 0 && nu < 0.5 && (circ || b > 0))) { notes.push(['bad', 'Check the plate dimensions, pressure and material.']); return null; }
      const { fy, fu } = factors();
      const res = circ ? circularPlate(edge, q, a, t, E, nu) : rectPlate(edge, q, a, b, t, E);
      rows.push({ dt: 'Peak stress', dd: `${g3(res.sigma)} MPa <small>at the ${res.where}${circ && edge === 'clamped' ? ` · ${g3((3 * (1 + nu) * q * a * a) / (8 * t * t))} MPa at the centre` : ''}</small>`, primary: true });
      rows.push({ dt: 'Deflection', dd: `${g3(res.w)} mm <small>at the centre · ${f(res.w / t, 2)} of the thickness</small>`, cls: res.w > 0.5 * t ? 'warn' : '' });
      if (circ && edge === 'ss') rows.push({ dt: 'Edge slope', dd: `${f(((res as ReturnType<typeof circularPlate>).slope * 180) / Math.PI, 2)}° <small>the edge rotates — it can open a face seal</small>` });
      if (!circ) rows.push({ dt: 'Coefficients', dd: `β ${f((res as ReturnType<typeof rectPlate>).beta, 3)} <small>α ${f((res as ReturnType<typeof rectPlate>).alpha, 4)} · sides ${f((res as ReturnType<typeof rectPlate>).ratio, 2)} : 1</small>` });
      rows.push(msRow('Yield margin', fy, 'yield factor', num('p_fty'), res.sigma), msRow('Ultimate margin', fu, 'ultimate factor', num('p_ftu'), res.sigma));
      if (fy !== null && fu !== null && num('p_fty') > 0 && num('p_ftu') > 0) {
        const need = t * Math.sqrt(Math.max((fy * res.sigma) / num('p_fty'), (fu * res.sigma) / num('p_ftu')));
        const dome = circ ? Math.max((fy * q * a) / (2 * num('p_fty')), (fu * q * a) / (2 * num('p_ftu'))) : NaN;
        rows.push({ dt: 'Thickness needed', dd: `${g3(need)} mm <small>stress goes as 1/t²${circ ? ` · a hemispherical head of the same radius needs ${g3(dome)} mm` : ''}</small>` });
      } else rows.push({ dt: 'Thickness needed', dd: `<small>${awaitingMessage(['yield and ultimate factors'], 'the thickness needed')}</small>` });
      if (res.w > 0.5 * t) notes.push(['warn', `The deflection is ${f(res.w / t, 2)} of the thickness. Beyond about half, the plate also stretches like a membrane and these small-deflection formulas over-predict the stress — use a large-deflection solution or a finite-element model.`]);
      notes.push(['', edge === 'ss' ? 'Simply supported gives the largest centre stress and deflection; clamped gives the largest edge stress. A bolted or welded edge lies between — check both.' : 'Clamped assumes the edge cannot rotate at all. A flange or bolt pattern that can rotate moves the stress toward the centre — check simply supported too.']);
      return () => {
        if (circ) {
          const p = res as ReturnType<typeof circularPlate>, rs = Array.from({ length: 81 }, (_, i) => (a * i) / 80);
          const sr = rs.map(p.sr), st = rs.map(p.st), [lo, hi] = span([...sr, ...st, 0], 0.12);
          const c = frame({ x0: 0, x1: 1, y0: lo, y1: hi, xl: 'radius / plate radius', yl: 'surface stress (MPa)' });
          poly(rs.map((r, i) => [c.X(r / a), c.Y(sr[i])]), 'var(--rd-blue)');
          poly(rs.map((r, i) => [c.X(r / a), c.Y(st[i])]), 'var(--rd-accent)', 2.2, '6 3');
          legend([['radial', 'var(--rd-blue)'], ['tangential', 'var(--rd-accent)', '6 3']]);
        } else {
          const ratios = Array.from({ length: 61 }, (_, i) => 1 + (4 * i) / 60);
          const c = frame({ x0: 1, x1: 5, y0: 0, y1: 0.8, xl: 'long side / short side', yl: 'β  (σ = βqb²/t²)' });
          poly(ratios.map((k) => [c.X(k), c.Y(rectCoefficients('ss', k, 1).beta)]), 'var(--rd-blue)');
          poly(ratios.map((k) => [c.X(k), c.Y(rectCoefficients('clamped', k, 1).beta)]), 'var(--rd-accent)', 2.2, '6 3');
          const k = Math.min(5, (res as ReturnType<typeof rectPlate>).ratio);
          el('circle', { cx: c.X(k), cy: c.Y((res as ReturnType<typeof rectPlate>).beta), r: 5, fill: 'var(--rd-ink)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
          legend([['simply supported', 'var(--rd-blue)'], ['clamped', 'var(--rd-accent)', '6 3']]);
        }
      };
    }

    function runShell(rows: Row[], notes: [string, string][]) {
      const p = num('s_p'), r = num('s_r'), t = num('s_t'), E = num('s_E'), nu = num('s_nu'), closed = field('s_end').value === 'closed';
      if (!(p >= 0 && r > 0 && t > 0 && E > 0 && nu >= 0 && nu < 0.5)) { notes.push(['bad', 'Check the radius, wall, pressure and material.']); return null; }
      const s = shell(p, r, t, E, nu, closed), { fy, fu } = factors();
      rows.push(
        { dt: 'Hoop stress', dd: `${g3(s.hoop)} MPa <small>pr/t · axial ${g3(s.axial)} · von Mises ${g3(s.vm)}</small>`, primary: true },
        { dt: 'Radial growth', dd: `${g3(s.growth)} mm <small>${f((100 * s.growth) / r, 2)}% of the radius</small>` },
        { dt: 'Edge zone', dd: `${g3(s.decayLength)} mm <small>π/β, where edge bending dies away · √(rt) = ${g3(s.sqrtRT)} mm</small>` },
        { dt: 'At a clamped edge', dd: `${g3(s.peakAxial)} MPa <small>axial, inner surface: ${f(s.edgeBend / s.hoop, 2)} × hoop in bending · a land of ${g3((t * s.peakAxial) / s.hoop)} mm holds it to the hoop stress</small>`, cls: 'warn' },
        { dt: 'Sphere or hemisphere', dd: `${g3(s.sphere)} MPa <small>pr/2t — half the cylinder's hoop stress</small>` },
        msRow('Yield margin', fy, 'yield factor', num('s_fty'), s.hoop),
        msRow('Ultimate margin', fu, 'ultimate factor', num('s_ftu'), s.hoop),
      );
      if (s.thick) notes.push(['warn', `r/t = ${f(r / t, 1)}: below about 10 the wall is thick and thin-shell theory under-predicts the inner-surface stress. Use Lamé's thick-cylinder solution — see <a href="../../motor/case-sizing/">Case sizing</a>.`]);
      notes.push(['', `Membrane stresses hold only away from edges, closures, rings and openings. Within about ${g3(s.decayLength)} mm of a stiff edge the wall bends; a fully clamped edge raises the axial surface stress to ${f(s.peakAxial / s.hoop, 2)} × the hoop stress.`]);
      notes.push(['', 'Under external pressure or axial compression a thin shell buckles long before it yields — see <a href="../../verify/shell-buckling/">Shell buckling</a>.']);
      return () => {
        const xmax = 3 * s.decayLength, xs = Array.from({ length: 121 }, (_, i) => (xmax * i) / 120);
        const hoop = xs.map(s.hoopAt), inner = xs.map(s.innerAt), outer = xs.map(s.outerAt);
        const [lo, hi] = span([...hoop, ...inner, ...outer, 0], 0.08);
        const c = frame({ x0: 0, x1: xmax, y0: lo, y1: hi, xl: 'distance from the clamped edge (mm)', yl: 'stress (MPa)' });
        el('rect', { x: c.X(0), y: c.T, width: c.X(s.decayLength) - c.X(0), height: c.H - c.T - c.B, fill: 'var(--rd-warn)', 'fill-opacity': 0.07 });
        poly(xs.map((x, i) => [c.X(x), c.Y(hoop[i])]), 'var(--rd-blue)');
        poly(xs.map((x, i) => [c.X(x), c.Y(inner[i])]), 'var(--rd-accent)');
        poly(xs.map((x, i) => [c.X(x), c.Y(outer[i])]), 'var(--rd-accent)', 1.6, '5 3');
        el('text', { x: c.X(s.decayLength) - 4, y: c.H - c.B - 6, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-warn)', ...halo }, 'edge zone');
        legend([['hoop', 'var(--rd-blue)'], ['axial in', 'var(--rd-accent)'], ['out', 'var(--rd-accent)', '5 3']]);
      };
    }

    function runLug(rows: Row[], notes: [string, string][]) {
      const L = { P: num('l_P'), t: num('l_t'), W: num('l_W'), e: num('l_e'), D: num('l_D'), d: num('l_d'), t2: num('l_t2'), g: num('l_g'), Ftu: num('l_ftu'), Fsu: num('l_fsu'), Fbru: num('l_fbru'), pinFtu: num('l_pftu'), pinFsu: num('l_pfsu') };
      if (!(L.P >= 0 && L.t > 0 && L.W > L.D && L.e > L.D / 2 && L.d > 0 && L.d <= L.D && L.t2 >= 0 && L.g >= 0)) { notes.push(['bad', 'Check the lug geometry: wider than the hole, the hole clear of the end, the pin no bigger than the hole.']); return null; }
      const { fu } = factors(), checks = lugChecks(L);
      const worst = checks.reduce((a, b) => (b.stress / b.allow > a.stress / a.allow ? b : a));
      for (const c of checks) {
        const use = c.stress / c.allow;
        if (fu === null) rows.push({ dt: c.name, dd: `${g3(c.stress)} MPa <small>${f(100 * use, 0)}% of ${g3(c.allow)} MPa at the applied load</small>`, primary: c === worst });
        else { const ms = c.allow / (fu * c.stress) - 1; rows.push({ dt: c.name, dd: `MS ${sgn(ms)} <small>${g3(fu * c.stress)} MPa at ${f(fu, 2)} × load, against ${g3(c.allow)} MPa</small>`, cls: ms < 0 ? 'bad' : 'ok', primary: c === worst }); }
      }
      if (fu === null) rows.push({ dt: 'Margins', dd: `<small>${awaitingMessage(['ultimate factor'], 'the margins')}</small>` });
      notes.push(['', `${worst.name} governs. ${worst.key === 'pinB' ? 'Pin bending usually does: close the gap, use thicker clevis plates closer to the lug, or a bigger or stronger pin.' : 'Pin bending is next to check whenever the gap or the clevis plates grow.'}`]);
      if (L.e / L.D < 1.5) notes.push(['warn', `Edge distance e/D = ${f(L.e / L.D, 2)}: below about 1.5 shear-out and bearing allowables fall quickly.`]);
      notes.push(['', 'These are first-cut checks for an axial load. Oblique or transverse loads, lug fatigue (the hole is a stress concentration) and the full Melcon–Hoblit or ASME BTH-1 methods come next.']);
      return () => {
        const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 250, Lx = 98, R = 20, T = 30, B = 34, k = fu ?? 1;
        svg.replaceChildren(); svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const top = Math.max(1.2, ...checks.map((c) => (k * c.stress) / c.allow)) * 1.05, X = (u: number) => Lx + (u / top) * (W - Lx - R);
        const row = (H - T - B) / checks.length;
        for (let u = 0; u <= top + 1e-9; u += top > 2.5 ? 0.5 : 0.25) {
          el('line', { x1: X(u), x2: X(u), y1: T, y2: H - B, stroke: u === 1 ? 'var(--rd-ink)' : 'var(--rd-line)', 'stroke-opacity': u === 1 ? 0.7 : 1 });
          el('text', { x: X(u), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, `${f(100 * u, 0)}%`);
        }
        checks.forEach((c, i) => {
          const u = (k * c.stress) / c.allow, y = T + i * row + row * 0.2;
          el('rect', { x: Lx, y, width: Math.max(1, X(u) - Lx), height: row * 0.6, rx: 2, fill: u > 1 ? 'var(--rd-accent)' : c === worst ? 'var(--rd-warn)' : 'var(--rd-blue)', 'fill-opacity': 0.8 });
          el('text', { x: Lx - 6, y: y + row * 0.3 + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)' }, c.name);
        });
        el('text', { x: W / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, fu === null ? 'stress / allowable, applied load' : `stress / allowable at ${f(fu, 2)} × load`);
        el('text', { x: 8, y: 17, 'font-size': 12, fill: 'var(--rd-ink)' }, 'each check against its allowable');
      };
    }

    function runColumn(rows: Row[], notes: [string, string][]) {
      const P = num('c_P'), L = num('c_L'), K = num('c_K'), E = num('c_E'), Fty = num('c_fty'), e = num('c_e') || 0;
      const s = dims('c');
      if (!s || !(P >= 0 && L > 0 && K > 0 && E > 0 && Fty > 0)) { notes.push(['bad', 'Check the section, length, K and material.']); return null; }
      const c = column(s, L, K, E, Fty), { fy, fu } = factors();
      rows.push(
        { dt: 'Buckling load', dd: `${g3(c.Pcr / 1000)} kN <small>${c.mode}${c.mode === 'Johnson' ? ` · Euler alone would say ${g3(c.PcrEuler / 1000)} kN` : ''}</small>`, primary: true },
        { dt: 'Slenderness', dd: `${f(c.slender, 1)} <small>KL/r · transition π√(2E/F<sub>ty</sub>) = ${f(c.transition, 1)}</small>` },
        { dt: 'Axial stress', dd: `${g3(P / s.A)} MPa <small>P/A at the applied load</small>` },
      );
      if (fu === null) rows.push({ dt: 'Buckling margin', dd: `<small>${awaitingMessage(['ultimate factor'], 'this margin')}</small>` });
      else { const ms = c.Pcr / (fu * P) - 1; rows.push({ dt: 'Buckling margin', dd: `MS ${sgn(ms)} <small>${g3(c.Pcr / 1000)} kN against ${f(fu, 2)} × ${g3(P / 1000)} kN</small>`, cls: ms < 0 ? 'bad' : 'ok' }); }
      if (e > 0) {
        if (fy === null) rows.push({ dt: 'First yield', dd: `${g3(secantStress(P, s, L, K, E, e))} MPa <small>peak at the applied load, secant formula · ${awaitingMessage(['yield factor'], 'the margin', false)}</small>` });
        else { const sm = secantStress(fy * P, s, L, K, E, e), ms = Fty / sm - 1; rows.push({ dt: 'First yield', dd: `MS ${Number.isFinite(sm) ? sgn(ms) : '< −1'} <small>${Number.isFinite(sm) ? `${g3(sm)} MPa` : 'beyond the Euler load'} at ${f(fy, 2)} × load with ${g3(e)} mm eccentricity</small>`, cls: ms < 0 ? 'bad' : 'ok' }); }
      }
      if (c.mode === 'Johnson') notes.push(['warn', `A short column (KL/r ${f(c.slender, 0)} below ${f(c.transition, 0)}): it yields as it buckles, and the Euler load of ${g3(c.PcrEuler / 1000)} kN would be ${f(100 * (c.PcrEuler / c.Pcr - 1), 0)}% unconservative.`]);
      if (field('c_kind').value === 'tube' && num('c_d1') / num('c_d2') > 40) notes.push(['', 'A thin-walled tube can also fail by local buckling of its wall before the column buckles — see Shell buckling.']);
      notes.push(['', 'K is a judgement about the ends. Real "fixed" ends rotate, so design values (2.1, 0.8, 0.65) are larger than the theoretical ones (2, 0.7, 0.5).']);
      return () => {
        const smax = Math.max(160, c.slender * 1.25, c.transition * 1.3), sl = Array.from({ length: 121 }, (_, i) => 1 + ((smax - 1) * i) / 120);
        const ch = frame({ x0: 0, x1: smax, y0: 0, y1: Fty * 1.15, xl: 'slenderness KL/r', yl: 'critical stress (MPa)' });
        poly(sl.filter((x) => (Math.PI ** 2 * E) / x ** 2 < Fty * 1.15).map((x) => [ch.X(x), ch.Y((Math.PI ** 2 * E) / x ** 2)]), 'var(--rd-muted)', 1.6, '5 3');
        poly(sl.map((x) => [ch.X(x), ch.Y(x < c.transition ? Fty - (Fty ** 2 / (4 * Math.PI ** 2 * E)) * x * x : (Math.PI ** 2 * E) / x ** 2)]), 'var(--rd-blue)');
        el('line', { x1: ch.X(c.transition), x2: ch.X(c.transition), y1: ch.T, y2: ch.H - ch.B, stroke: 'var(--rd-warn)', 'stroke-dasharray': '2 3' });
        el('circle', { cx: ch.X(c.slender), cy: ch.Y(c.sigmaCr), r: 5, fill: 'var(--rd-ink)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
        const sa = (P * (fu ?? 1)) / s.A;
        if (sa < Fty * 1.15) el('circle', { cx: ch.X(c.slender), cy: ch.Y(sa), r: 4.5, fill: 'var(--rd-accent)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
        el('text', { x: ch.X(c.transition) + 4, y: ch.T + 14, 'font-size': 12, fill: 'var(--rd-warn)', ...halo }, 'transition');
        legend([['Johnson / Euler', 'var(--rd-blue)'], ['Euler', 'var(--rd-muted)', '5 3']]);
      };
    }

    const RUN: Record<string, typeof runBeam> = { beam: runBeam, plate: runPlate, shell: runShell, lug: runLug, column: runColumn };
    const CAPS: Record<string, string> = {
      beam: 'Bending moment along the span, and the deflected shape (not to scale).',
      plate: 'Surface stresses across a circular plate, or the stress coefficient of a rectangular plate against its aspect ratio — the dot is this plate.',
      shell: 'Stresses near a clamped edge. The hoop stress is suppressed at the edge, and bending adds and subtracts from the axial stress on the two surfaces; both settle to membrane values beyond the edge zone.',
      lug: 'Each check as a share of its allowable. The longest bar governs.',
      column: 'Critical stress against slenderness: Johnson\'s parabola below the transition, Euler above it. The dot on the curve is this column\'s buckling stress; the red dot is its stress under the load (factored once the ultimate factor is entered).',
    };

    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });

    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    wireWorkedExample({
      root, onLoad: run, factorFields: ['fy', 'fu'],
      note: 'Worked-example factors loaded: yield 1.10, ultimate 1.25',
      values: {
        b_case: 'ss-udl', b_W: '4054', b_L: '1000', b_kind: 'tube', b_d1: '302.754', b_d2: '1.377', b_E: '205000', b_fty: '1450', b_ftu: '1520',
        p_shape: 'circ', p_edge: 'ss', p_q: '11', p_a: '142.5', p_t: '25', p_E: '205000', p_nu: '0.29', p_fty: '655', p_ftu: '860',
        s_p: '10', s_r: '150.69', s_t: '1.377', s_end: 'closed', s_E: '205000', s_nu: '0.29', s_fty: '1450', s_ftu: '1520',
        l_P: '29452', l_t: '10', l_W: '36', l_e: '18', l_D: '12.2', l_d: '12', l_t2: '6', l_g: '0.5', l_ftu: '470', l_fsu: '282', l_fbru: '705', l_pftu: '1000', l_pfsu: '600',
        c_P: '29452', c_L: '600', c_K: '1', c_e: '0.6', c_kind: 'tube', c_d1: '25', c_d2: '2.5', c_E: '205000', c_fty: '355',
        fy: '1.1', fu: '1.25',
      },
    });
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 120); });
    form.addEventListener('change', run);
    run();
  });
</script>
