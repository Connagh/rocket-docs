---
// Random vibration of a single-degree-of-freedom part: input PSD → Grms, Miles vs exact response, 3σ load and
// margin, 3σ displacement against a clearance, and Steinberg three-band fatigue.
// Maths in src/lib/vibration.ts (unit-tested); this file is UI only.
const BP = [
  { f: 20, v: '+3 dB' },
  { f: 80, v: '0.04' },
  { f: 500, v: '0.04' },
  { f: 2000, v: '-3 dB' },
  { f: '', v: '' },
  { f: '', v: '' },
];
---

<div class="calc vbcalc" data-vbcalc>
  <div class="calc-head"><span>Random vibration: one mode</span><span class="head-btns"><span>Miles · exact · 3-sigma · Steinberg</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset>
        <legend>Input PSD at the mount</legend>
        <div class="vb-bp vb-bp-head" aria-hidden="true"><span>Hz</span><span>ASD g²/Hz, or slope dB/oct</span><span></span></div>
        {BP.map((b, k) => (
          <div class="vb-bp">
            <input name={`f${k}`} type="number" min="0" step="any" value={b.f} aria-label={`breakpoint ${k + 1} frequency, Hz`} />
            <input name={`v${k}`} type="text" value={b.v} aria-label={`breakpoint ${k + 1} ASD in g²/Hz, or slope in dB per octave`} autocomplete="off" spellcheck="false" />
            <span class="vb-bp-note" data-bp={k}></span>
          </div>
        ))}
        <p class="hint">Enter an ASD such as 0.04, or a slope such as +3 dB, for the segment joining that row to its neighbour, as test specifications are written. Leave a row blank to drop it.</p>
      </fieldset>
      <fieldset>
        <legend>The part: one mode</legend>
        <div class="row2">
          <label>Natural frequency f<sub>n</sub> (Hz)<input name="fn" type="number" min="1" step="any" value="150" /></label>
          <label>Amplification Q<input name="q" type="number" min="1" step="any" value="10" /></label>
          <label>Mass (kg)<input name="m" type="number" min="0" step="any" value="4" /></label>
          <label>Duration (s)<input name="t" type="number" min="0" step="any" value="120" /></label>
          <label>Clearance (mm)<input name="cl" type="number" min="0" step="any" value="2" placeholder="optional" /></label>
        </div>
        <p class="hint">Q is the peak amplification at resonance; damping ratio ζ = 1/(2Q). Measure it in test where you can: about 10 is a common starting assumption for bolted metal structures.</p>
      </fieldset>
      <fieldset>
        <legend>Strength margin</legend>
        <div class="row2">
          <label>Factor of safety<input name="fs" type="number" min="1" step="0.01" placeholder="your value" autocomplete="off" /></label>
          <label>Allowable at the mount (N)<input name="al" type="number" min="0" step="any" value="2000" /></label>
        </div>
        <p class="hint">The 3σ load is taken as the limit load. The factor applied to random-vibration loads, and how they combine with quasi-static loads, come from your programme's requirements.</p>
        <p class="hint example-note" data-example-note hidden></p>
      </fieldset>
      <fieldset>
        <legend>Fatigue: Steinberg three-band</legend>
        <div class="row2">
          <label>Stress per g of response (MPa/g)<input name="spg" type="number" min="0" step="any" value="4" /></label>
          <label>UTS (MPa)<input name="uts" type="number" min="1" step="any" value="310" /></label>
          <label>S<sub>e</sub> at the part (MPa)<input name="se" type="number" min="1" step="any" value="96" /></label>
          <label>at N<sub>e</sub> cycles<input name="ne" type="number" min="1000" step="any" value="500000000" /></label>
        </div>
        <label>S-N below S<sub>e</sub>
          <select name="lim">
            <option value="no">Keeps falling: aluminium, most non-ferrous</option>
            <option value="yes">Endurance limit: most steels, titanium</option>
          </select>
        </label>
        <p class="hint">Stress per g at the critical point with the notch included; S<sub>e</sub> after surface, size and reliability factors: both from the <a href="../../fundamentals/fatigue/">Fatigue</a> page. Leave the stress blank to skip.</p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts">
        <div class="readout"><dt>Input</dt><dd data-r="in">—</dd></div>
        <div class="readout"><dt>Response</dt><dd data-r="resp">—</dd></div>
        <div class="readout primary" data-cls="load"><dt>3<span class="nc">σ</span> load</dt><dd data-r="load">—</dd></div>
        <div class="readout" data-cls="ms"><dt>Strength margin</dt><dd data-r="ms">—</dd></div>
        <div class="readout" data-cls="disp"><dt>3<span class="nc">σ</span> displacement</dt><dd data-r="disp">—</dd></div>
        <div class="readout" data-cls="fat"><dt>Fatigue damage</dt><dd data-r="fat">—</dd></div>
      </dl>
      <figure class="vb-fig">
        <svg viewBox="0 0 420 270" data-chart role="img" aria-label="Input and response acceleration spectral density against frequency, log-log"></svg>
        <figcaption>Input ASD (shaded) and the part's response ASD (line) = input × transmissibility². The area under each is its mean square; Grms is the square root.</figcaption>
      </figure>
      <div class="vb-table" data-table></div>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    One mode on a rigid base: Miles' equation G<sub>rms</sub> = √(π/2 · f<sub>n</sub> · Q · ASD(f<sub>n</sub>)), checked
    against the full integral of the input times the transmissibility. Gaussian response, narrow-band; Steinberg's bands
    at 1σ, 2σ and 3σ with f<sub>n</sub> · duration cycles.
  </div>
</div>

<style is:global>
  .vbcalc .vb-bp { margin: 0 !important; display: grid; grid-template-columns: 5.2rem minmax(0, 1fr) minmax(0, 0.9fr); gap: 0.4rem; align-items: center; }
  .vbcalc .vb-bp > * { margin: 0 !important; }
  .vbcalc .vb-bp-head { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .vbcalc .vb-bp-note { font-size: var(--sl-text-xs); color: var(--rd-muted); font-family: var(--sl-font-mono); }
  .vbcalc .vb-bp-note.bad { color: var(--rd-accent); }
  .vbcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .vbcalc .nc { text-transform: none; } /* uppercase would turn σ into Σ */
  .vb-fig { margin: 0.9rem 0 0 !important; }
  .vb-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .vb-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .vbcalc .vb-table { overflow-x: auto; margin-top: 0.75rem !important; }
  .vbcalc .vb-table table { width: 100%; font-size: var(--sl-text-xs); font-family: var(--sl-font-mono); border-collapse: collapse; display: table; }
  .vbcalc .vb-table th, .vbcalc .vb-table td { padding: 0.3rem 0.3rem; border-bottom: 1px solid var(--rd-line); text-align: right; white-space: nowrap; }
  .vbcalc .vb-table th:first-child, .vbcalc .vb-table td:first-child { text-align: left; }
  .vbcalc .vb-table caption { caption-side: top; text-align: left; font-size: var(--sl-text-xs); color: var(--rd-muted); padding-bottom: 0.3rem; }
  .vbcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { resolveProfile, grms, miles, asdAt, trans2, sdofResponse, peaksAbove, steinbergDamage, dbPerOct, G0, type RawRow } from '../lib/vibration';
  import { snCurve } from '../lib/fatigue';
  import { readFactor, awaitingMessage, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const sup = (s: string) => s.replace(/[-0-9]/g, (c) => '⁻⁰¹²³⁴⁵⁶⁷⁸⁹'['-0123456789'.indexOf(c)]);
  const sci = (v: number, d = 1) => {
    if (!Number.isFinite(v)) return '—';
    if (v === 0) return '0';
    if (v >= 0.01 && v < 1e4) return f(v, v < 1 ? 3 : 1);
    const [m, e] = v.toExponential(d).split('e');
    return `${m} × 10${sup(String(+e))}`;
  };
  const sgn = (v: number) => `${v >= 0 ? '+' : ''}${f(v, 2)}`;

  /** "0.04" → ASD; "+3 dB", "−6 dB/oct" → slope. */
  function parseVal(raw: string): { value: number; kind: 'asd' | 'slope' } | null {
    const s = raw.trim().replace(/[−–]/g, '-').replace(',', '.');
    if (!s) return null;
    const m = s.match(/^([+-]?(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?)\s*(db(?:\s*\/\s*oct(?:ave)?)?)?$/i);
    if (!m) return { value: NaN, kind: 'asd' };
    return { value: +m[1], kind: m[2] ? 'slope' : 'asd' };
  }

  document.querySelectorAll<HTMLElement>('[data-vbcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const cls = (k: string, c: string) => (root.querySelector(`[data-cls="${k}"]`)!.className = `readout${k === 'load' ? ' primary' : ''} ${c}`);
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      return e;
    };
    const clear = () => {
      for (const k of ['in', 'resp', 'load', 'ms', 'disp', 'fat']) r(k).textContent = '—';
      root.querySelector('[data-table]')!.innerHTML = '';
      root.querySelector<SVGSVGElement>('[data-chart]')!.replaceChildren();
    };

    function run() {
      const notes: [string, string][] = [];
      const say = () => (root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, t]) => `<li class="${c}">${t}</li>`).join(''));

      // breakpoints
      const raw: (RawRow & { k: number })[] = [];
      let unreadable = false;
      for (let k = 0; k < 6; k++) {
        const note = root.querySelector<HTMLElement>(`[data-bp="${k}"]`)!;
        note.textContent = ''; note.className = 'vb-bp-note';
        const fk = num(`f${k}`), v = parseVal(field(`v${k}`).value);
        if (!Number.isFinite(fk) && !v) continue;
        if (!v || !Number.isFinite(fk) || !Number.isFinite(v.value)) { note.textContent = 'can’t read this row'; note.className = 'vb-bp-note bad'; unreadable = true; continue; }
        raw.push({ f: fk, value: v.value, kind: v.kind, k });
      }
      const { points, error } = resolveProfile(raw);
      if (error || unreadable) {
        clear(); notes.push(['bad', `Input PSD: ${error ?? 'a row could not be read: use a number such as 0.04, or a slope such as +3 dB'}.`]); say(); return;
      }
      raw.forEach((x) => {
        const i = points.findIndex((p) => p.f === x.f);
        const note = root.querySelector<HTMLElement>(`[data-bp="${x.k}"]`)!;
        if (x.kind === 'slope') note.textContent = `= ${sci(points[i].a, 2)}`;
        else if (i < points.length - 1) { const s = dbPerOct(points[i], points[i + 1]); note.textContent = Math.abs(s) < 0.05 ? 'then flat' : `then ${s > 0 ? '+' : ''}${f(s, 1)} dB/oct`; }
      });

      const gIn = grms(points);
      const fn = num('fn'), Q = num('q'), m = num('m'), T = num('t');
      r('in').innerHTML = `${f(gIn, 2)} <small>g rms, ${f(points[0].f, 0)}–${f(points[points.length - 1].f, 0)} Hz</small>`;
      if (!(fn > 0) || !(Q >= 1)) { clear(); r('in').innerHTML = `${f(gIn, 2)} <small>g rms</small>`; notes.push(['warn', 'Enter the natural frequency and a Q of at least 1.']); say(); chart(points, NaN, NaN); return; }

      const ex = sdofResponse(points, fn, Q);
      const asdN = asdAt(points, fn);
      const gM = asdN > 0 ? miles(fn, Q, asdN) : NaN;
      const diff = gM / ex.grms - 1;
      r('resp').innerHTML = `${f(ex.grms, 2)} <small>g rms exact · Miles ${f(gM, 2)}${Number.isFinite(diff) ? ` (${diff >= 0 ? '+' : ''}${f(100 * diff, 1)}%)` : ''}</small>`;

      const g3 = 3 * ex.grms, load = m > 0 ? m * g3 * G0 : NaN;
      r('load').innerHTML = `${f(load, 0)} N <small>3σ = ${f(g3, 1)} g${m > 0 ? ` on ${f(m, Number.isInteger(m) ? 0 : 1)} kg` : ''}</small>`;

      // strength margin
      const fs = readFactor(field('fs').value), al = num('al');
      if (fs === null) {
        r('ms').innerHTML = '<small>needs your factor</small>'; cls('ms', '');
        notes.push(['warn', awaitingMessage(['factor of safety'], 'the strength margin')]);
      } else if (al > 0 && load > 0) {
        const ms = al / (fs * load) - 1;
        r('ms').innerHTML = `${sgn(ms)} <small>${f(fs * load, 0)} N design vs ${f(al, 0)} N</small>`;
        cls('ms', ms < 0 ? 'bad' : 'ok');
        if (ms < 0) notes.push(['bad', `The mount fails: design load ${f(fs * load, 0)} N exceeds the ${f(al, 0)} N allowable (MS ${sgn(ms)}).`]);
        else if (ms > 0.5) notes.push(['', `MS ${sgn(ms)}: on a mass-driven part a large margin is a finding (the mount may be heavier than it needs to be). See <a href="../margin-policy/">Margin policy</a>.`]);
      } else { r('ms').innerHTML = '<small>enter mass and allowable</small>'; cls('ms', ''); }

      // displacement
      const z3 = 3 * ex.zrms, cl = num('cl');
      r('disp').innerHTML = `${f(z3, z3 < 1 ? 2 : 1)} mm <small>relative to the base · rms ${f(ex.zrms, 3)}</small>`;
      cls('disp', cl > 0 ? (z3 >= cl ? 'bad' : 'ok') : '');
      if (cl > 0 && z3 >= cl) notes.push(['bad', `3σ displacement ${f(z3, 2)} mm reaches the ${f(cl, 1)} mm clearance: expect contact. Stiffen the mount, add clearance or snub it.`]);

      // cycles, peaks and fatigue
      // Steinberg's cycle count and the Rayleigh peaks assume a resonant, narrow-band response
      const resonant = fn >= points[0].f && fn <= points[points.length - 1].f;
      const cycles = T > 0 && resonant ? fn * T : NaN;
      const spg = num('spg'), uts = num('uts'), se = num('se'), ne = num('ne');
      let table = '';
      if (cycles > 0 && spg > 0 && uts > 0 && se > 0 && se < 0.9 * uts && ne > 1e3) {
        const curve = snCurve(uts, se, ne, field('lim').value === 'yes');
        const d = steinbergDamage(spg * ex.grms, cycles, curve.N);
        const top = d.D > 0 ? d.bands[2].d / d.D : NaN;
        r('fat').innerHTML = `${sci(d.D)} <small>per exposure${d.D > 0 ? ` · life × ${sci(1 / d.D, 1)}` : ' · below S<sub>e</sub>'}</small>`;
        cls('fat', d.D >= 1 ? 'bad' : d.D > 0.1 ? 'warn' : 'ok');
        table = `<table><caption>Steinberg bands: ${f(cycles, 0)} cycles at f<sub>n</sub>; stress amplitude, life in cycles, share of the damage</caption><thead><tr><th>Band</th><th>Cycles</th><th>MPa</th><th>Life</th><th>Share</th></tr></thead><tbody>${d.bands.map((b) =>
          `<tr><td>${b.k}σ</td><td>${f(b.n, 0)}</td><td>${f(b.s, 1)}</td><td>${sci(b.N).replace(/ /g, '')}</td><td>${d.D > 0 ? `${f((100 * b.d) / d.D, 1)}%` : '—'}</td></tr>`).join('')}</tbody></table>`;
        if (3 * spg * ex.grms >= uts) notes.push(['bad', `The 3σ stress (${f(3 * spg * ex.grms, 0)} MPa) reaches the UTS: a strength problem before a fatigue one.`]);
        if (d.D >= 1) notes.push(['bad', `Fatigue damage ${sci(d.D)} ≥ 1: the part is predicted to fail within this exposure.`]);
        else if (top > 0.5) notes.push(['', `${f(100 * top, 0)}% of the damage comes from the 3σ band: 4.3% of the cycles. The rare large cycles do the damage, so a few dB on the input matters far more than the duration.`]);
      } else if (!resonant) {
        r('fat').innerHTML = '<small>not resonant in this band</small>'; cls('fat', '');
      } else if (spg > 0 && se >= 0.9 * uts) {
        r('fat').innerHTML = '<small>S<sub>e</sub> must be below 0.9 × UTS</small>'; cls('fat', 'warn');
      } else { r('fat').innerHTML = '<small>not calculated</small>'; cls('fat', ''); }
      root.querySelector('[data-table]')!.innerHTML = table;

      // where the simple model stops
      if (!resonant) notes.push(['warn', `f<sub>n</sub> = ${f(fn, 0)} Hz is outside the input band (${f(points[0].f, 0)}–${f(points[points.length - 1].f, 0)} Hz): the part isn't resonating in this environment, so ${fn > points[points.length - 1].f ? 'it moves with the base and the load is close to the input level' : 'it is isolated from the input'}; the fatigue cycle count doesn't apply. Check the band covers the part, and that nothing outside it (sine, transient) excites the mode.`]);
      else if (Math.abs(diff) > 0.1) notes.push(['warn', `Miles' equation is ${f(100 * Math.abs(diff), 0)}% ${diff > 0 ? 'high' : 'low'} here because the input isn't flat around f<sub>n</sub>. Use the exact value.`]);
      if (Q < 5) notes.push(['warn', 'Q below 5 is heavy damping for a structure; Miles assumes light damping. Rely on the exact value.']);
      if (cycles > 0) notes.push(['', `In ${f(cycles, 0)} cycles about ${f(peaksAbove(3, cycles), 0)} peaks exceed 3σ and ${f(peaksAbove(4, cycles), peaksAbove(4, cycles) < 1 ? 1 : 0)} exceed 4σ. If a single overload breaks the part (a brittle material, a bond, a ceramic) size it beyond 3σ.`]);
      say();
      chart(points, fn, Q);
    }

    function chart(points: { f: number; a: number }[], fn: number, Q: number) {
      const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
      svg.replaceChildren();
      last = [points, fn, Q];
      // draw at close to the rendered width, so the text stays readable on a phone
      const W = Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420))), H = 270, L = 62, R = 12, T = 30, B = 42;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const fa = points[0].f / 1.3, fb = points[points.length - 1].f * 1.3;
      const ok = Number.isFinite(fn) && Number.isFinite(Q);
      const fs = Array.from({ length: 500 }, (_, i) => fa * Math.pow(fb / fa, i / 499));
      const resp = ok ? fs.map((x) => asdAt(points, x) * trans2(x, fn, Q)) : [];
      const amin = Math.min(...points.map((p) => p.a));
      const ymax = Math.pow(10, Math.ceil(Math.log10(Math.max(...points.map((p) => p.a), ...resp) * 1.05)));
      const ymin = Math.pow(10, Math.floor(Math.log10(amin)) - 1);
      const X = (x: number) => L + (Math.log(x / fa) / Math.log(fb / fa)) * (W - L - R);
      const Y = (y: number) => T + (Math.log(ymax / Math.max(y, ymin)) / Math.log(ymax / ymin)) * (H - T - B);
      let lastX = -Infinity;
      for (let e = Math.floor(Math.log10(fa)); e <= Math.ceil(Math.log10(fb)); e++) for (const m of [1, 2, 5]) {
        const x = m * 10 ** e;
        if (x < fa || x > fb) continue;
        svg.append(el('line', { x1: X(x), x2: X(x), y1: T, y2: H - B, stroke: 'var(--rd-line)' }));
        if (X(x) - lastX < String(x).length * 7.5 + 8) continue; // skip a label that would touch its neighbour
        lastX = X(x);
        svg.append(el('text', { x: X(x), y: H - B + 16, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, String(x)));
      }
      for (let e = Math.log10(ymin); e <= Math.log10(ymax) + 1e-9; e++) {
        svg.append(el('line', { x1: L, x2: W - R, y1: Y(10 ** e), y2: Y(10 ** e), stroke: 'var(--rd-line)' }));
        svg.append(el('text', { x: L - 6, y: Y(10 ** e) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, e >= -2 && e <= 2 ? String(10 ** e) : `10${sup(String(Math.round(e)))}`));
      }
      svg.append(el('text', { x: (L + W - R) / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'Frequency (Hz)'));
      svg.append(el('text', { x: 13, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 13 ${(T + H - B) / 2})` }, 'ASD (g²/Hz)'));
      const inPts = points.map((p) => `${X(p.f).toFixed(1)},${Y(p.a).toFixed(1)}`);
      svg.append(el('path', { d: `M${X(points[0].f)},${Y(ymin)} L${inPts.join(' L')} L${X(points[points.length - 1].f)},${Y(ymin)} Z`, fill: 'var(--rd-blue)', 'fill-opacity': 0.25, stroke: 'var(--rd-blue)', 'stroke-width': 1.8 }));
      if (ok) {
        svg.append(el('path', { d: fs.map((x, i) => `${i ? 'L' : 'M'}${X(x).toFixed(1)},${Y(resp[i]).toFixed(1)}`).join(''), fill: 'none', stroke: 'var(--rd-accent)', 'stroke-width': 2 }));
        if (fn > fa && fn < fb) {
          svg.append(el('line', { x1: X(fn), x2: X(fn), y1: T, y2: H - B, stroke: 'var(--rd-accent)', 'stroke-dasharray': '3 3' }));
          const right = X(fn) < W * 0.7;
          svg.append(el('text', { x: X(fn) + (right ? 6 : -6), y: T + 14, 'text-anchor': right ? 'start' : 'end', 'font-size': 12, fill: 'var(--rd-accent)' }, `fₙ ${f(fn, 0)} Hz`));
        }
      }
      // legend, above the plot
      svg.append(el('rect', { x: L, y: 7, width: 12, height: 9, fill: 'var(--rd-blue)', 'fill-opacity': 0.5, stroke: 'var(--rd-blue)' }));
      svg.append(el('text', { x: L + 17, y: 16, 'font-size': 12, fill: 'var(--rd-ink)' }, 'input'));
      if (ok) {
        svg.append(el('line', { x1: L + 72, x2: L + 86, y1: 12, y2: 12, stroke: 'var(--rd-accent)', 'stroke-width': 2 }));
        svg.append(el('text', { x: L + 91, y: 16, 'font-size': 12, fill: 'var(--rd-ink)' }, 'response'));
      }
    }

    let last: Parameters<typeof chart> | null = null;
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => {
        const nw = Math.round(e.contentRect.width);
        if (last && Math.abs(nw - w) > 8) { w = nw; chart(...last); }
      }).observe(root.querySelector('[data-chart]')!);
    }
    wireWorkedExample({
      root, onLoad: run, factorFields: ['fs'],
      note: 'Worked-example factor loaded: factor of safety 1.25',
      values: { fs: '1.25' },
    });
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    run();
  });
</script>
