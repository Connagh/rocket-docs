---
// Gauging in three tabs: an uncertainty budget with the decision rule and the false accept and false reject risk for a
// process; a gauge R&R study by the average and range method; and limit gauge sizes. The required TUR and the %GRR
// limit are the user's programme criteria and start blank. Maths in src/lib/gauging.ts (unit-tested); UI only here.
import { CONTRIBUTIONS, makeStudy } from '../lib/gauging';

const TABS = [{ key: 'unc', name: 'Uncertainty & decision' }, { key: 'grr', name: 'Gauge R&R' }, { key: 'gauge', name: 'Limit gauges' }];
// the worked example: the ⌀150 H8 seal bore measured with a two-point bore gauge set on a ring
const BUDGET = [
  { name: 'Setting ring (certificate)', value: '1.5', kind: 'k2' },
  { name: 'Repeatability', value: '1.2', kind: 'std' },
  { name: 'Display resolution', value: '1', kind: 'res' },
  { name: 'Temperature, part to ring', value: '3.69', kind: 'rect' },
  { name: 'Alignment and centring', value: '1', kind: 'rect' },
  { name: '', value: '', kind: 'std' },
];
const STUDY = makeStudy({ parts: 10, trials: 3, partSd: 12, repSd: 1.2, bias: [0, 1.5, -1], centre: 32, seed: 1 })
  .map((o, i) => o.map((t) => `${'ABC'[i]}: ${t.join(' ')}`).join('\n')).join('\n');
---

<div class="calc gacalc" data-gacalc>
  <div class="calc-head"><span>Gauging</span><span class="head-btns"><span>uncertainty · R&amp;R · limit gauges</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Gauging check">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="unc">
        <legend>Tolerance and uncertainty budget</legend>
        <div class="row2">
          <label>Lower limit (µm from nominal)<input name="u_lsl" type="number" step="any" value="0" /></label>
          <label>Upper limit (µm from nominal)<input name="u_usl" type="number" step="any" value="63" /></label>
        </div>
        <div class="ga-budget">
          {BUDGET.map((b, i) => (
            <div class="ga-row">
              <input name={`b_n${i}`} type="text" value={b.name} placeholder="add a contribution" aria-label={`Contribution ${i + 1}`} />
              <input name={`b_v${i}`} type="number" min="0" step="any" value={b.value} placeholder="µm" aria-label={`Value ${i + 1} (µm)`} />
              <select name={`b_k${i}`} aria-label={`Contribution ${i + 1} given as`}>{CONTRIBUTIONS.map((c) => <option value={c.key} selected={c.key === b.kind}>{c.name}</option>)}</select>
            </div>
          ))}
        </div>
        <div class="row2">
          <label>Coverage factor k<input name="u_k" type="number" min="1" step="any" value="2" /></label>
          <label>Decision rule<select name="u_rule"><option value="guard" selected>Guarded (ISO 14253-1)</option><option value="simple">Simple</option></select></label>
          <label>Process mean (µm)<input name="u_mean" type="number" step="any" value="31.5" /></label>
          <label>Process standard deviation (µm)<input name="u_sd" type="number" min="0" step="any" value="9" /></label>
          <label>Required TUR<input name="u_req" type="number" min="1" step="any" placeholder="your programme" autocomplete="off" /></label>
        </div>
        <p class="hint">Give each contribution in µm, in the form that you have: 1σ (a standard deviation), U at k = 2 (a calibration certificate), ± limit (rectangular: a temperature range or an instrument specification) or a display resolution. A temperature limit is L × α × ΔT.</p>
      </fieldset>

      <fieldset data-panel="grr" hidden>
        <legend>Study: operators × trials × parts</legend>
        <label>Readings (µm from nominal)<textarea name="r_data" rows="9" spellcheck="false">{STUDY}</textarea></label>
        <div class="row2">
          <label>Tolerance width (µm)<input name="r_tol" type="number" min="0" step="any" value="63" /></label>
          <label>Your %GRR limit (of tolerance)<input name="r_lim" type="number" min="0" step="any" placeholder="your programme" autocomplete="off" /></label>
        </div>
        <p class="hint">One line for each operator and trial: the operator letter, then one reading for each part, in the same part order on each line. Two or three operators, two or three trials, two to ten parts. Select parts that cover the process range.</p>
      </fieldset>

      <fieldset data-panel="gauge" hidden>
        <legend>Plain limit gauges</legend>
        <div class="row2">
          <label>Feature<select name="g_feat"><option value="hole" selected>Hole: plug gauges</option><option value="shaft">Shaft: ring or snap gauges</option></select></label>
          <label>Lower size limit (mm)<input name="g_lsl" type="number" step="any" value="150.000" /></label>
          <label>Upper size limit (mm)<input name="g_usl" type="number" step="any" value="150.063" /></label>
          <label>Gauge-maker's tolerance (% of work)<input name="g_t" type="number" min="0" max="25" step="any" value="10" /></label>
          <label>GO wear allowance (% of work)<input name="g_w" type="number" min="0" max="25" step="any" value="5" /></label>
          <label data-hole>Position tolerance at MMC (mm)<input name="g_pos" type="number" min="0" step="any" placeholder="optional" /></label>
        </div>
        <p class="hint">Gauges inside the work tolerance: a gauge in tolerance never accepts a bad part. The percentages are a common simplification. ISO 1938-1 and ASME B89.1.5 give the gauge tolerances by size and class.</p>
      </fieldset>
      <p class="hint example-note" data-example-note hidden></p>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected gauging check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Uncertainty: uncorrelated contributions combined by root sum of squares (GUM), U = k·u<sub>c</sub>. Decision rules after
    ISO 14253-1. Risk: normal process and normal measurement error. Gauge R&amp;R: average and range method with the AIAG
    MSA constants, 6σ against the tolerance. Limit gauges: gauge tolerance and wear allowance inside the work tolerance.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .gacalc .readout dd small { display: block; margin-top: 0.15rem; }
  .gacalc textarea { width: 100%; font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); background: var(--rd-panel2, var(--rd-panel)); color: var(--rd-ink); border: 1px solid var(--rd-line); border-radius: 4px; padding: 0.4rem; resize: vertical; white-space: pre; overflow-wrap: normal; overflow-x: auto; }
  .ga-budget { margin: 0.6rem 0 !important; }
  .ga-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 0.3rem; padding: 0.35rem 0; border-top: 1px solid var(--rd-line); margin: 0 !important; }
  .ga-row > * { margin: 0 !important; min-width: 0; }
  .ga-row > input[type='text'] { grid-column: 1 / -1; }
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .gacalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { budget, tur, acceptanceLimits, decisionRisk, gaugeRR, grrBand, parseStudy, limitGauges, functionalPin, type Contribution, type Rule } from '../lib/gauging';
  import { readFactor, wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '–');
  const g3 = (v: number) => (Math.abs(v) >= 100 ? f(v, 0) : Math.abs(v) >= 10 ? f(v, 1) : f(v, 2));
  const ppm = (p: number) => (p * 1e6 >= 1000 ? `${f(p * 100, 2)}%` : `${f(p * 1e6, p * 1e6 < 10 ? 1 : 0)} ppm`);
  const mm = (v: number) => f(v, 4);
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-gacalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const size = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    const txt = (x: number, y: number, s: string, c = 'var(--rd-ink)', anchor = 'middle', fs = 12) => el('text', { x, y, 'text-anchor': anchor, 'font-size': fs, fill: c }, s);
    let mode = 'unc';
    let draw: (() => void) | null = null;

    // ---- uncertainty and decision ----
    function runUnc(rows: Row[], notes: [string, string][]) {
      const lsl = num('u_lsl'), usl = num('u_usl'), k = num('u_k') || 2, rule = field('u_rule').value as Rule, mean = num('u_mean'), sd = Math.max(0, num('u_sd') || 0);
      const req = readFactor(field('u_req').value, 1);
      const list = Array.from({ length: 6 }, (_, i) => ({ name: field(`b_n${i}`).value.trim() || `item ${i + 1}`, value: num(`b_v${i}`), kind: field(`b_k${i}`).value as Contribution }));
      if (!(usl > lsl)) { notes.push(['bad', 'Enter an upper limit above the lower limit.']); return null; }
      const b = budget(list, k);
      if (!(b.uc > 0)) { notes.push(['bad', 'Enter at least one contribution.']); return null; }
      const t = tur(lsl, usl, b.U), a = acceptanceLimits(lsl, usl, b.U, rule);
      const big = b.parts.slice().sort((x, y) => y.share - x.share)[0];
      rows.push(
        { dt: 'Expanded uncertainty U', dd: `±${g3(b.U)} µm <small>u<sub>c</sub> ${g3(b.uc)} µm × k ${f(k, 1)} · largest: ${big.name}, ${f(100 * big.share, 0)}% of the variance</small>`, primary: true },
        { dt: 'TUR', dd: `${f(t, 1)} <small>tolerance ÷ 2U${req ? ` · required ${f(req, 1)}` : ''}</small>`, cls: req ? (t >= req ? 'ok' : 'bad') : '' },
        { dt: 'Acceptance limits', dd: a.ok ? `${g3(a.lo)} to ${g3(a.hi)} µm <small>${rule === 'guard' ? `${f((100 * (a.hi - a.lo)) / (usl - lsl), 0)}% of the tolerance is left to manufacture` : 'the tolerance limits: the customer carries the risk at the limits'}</small>` : 'none <small>the guard bands are wider than the tolerance</small>', cls: a.ok ? '' : 'bad' },
      );
      if (!req) rows.push({ dt: 'TUR check', dd: '<small>Enter the TUR that your programme or quality system requires, or push “Load worked example”.</small>' });
      let r: ReturnType<typeof decisionRisk> | null = null;
      if (a.ok && Number.isFinite(mean)) {
        r = decisionRisk({ lsl, usl, lo: a.lo, hi: a.hi, mean, sd, uc: b.uc });
        const other = rule === 'guard' ? acceptanceLimits(lsl, usl, b.U, 'simple') : acceptanceLimits(lsl, usl, b.U, 'guard');
        const ro = other.ok ? decisionRisk({ lsl, usl, lo: other.lo, hi: other.hi, mean, sd, uc: b.uc }) : null;
        rows.push(
          { dt: 'False accept', dd: `${ppm(r.pfa)} <small>bad parts that pass · ${ppm(r.pOut)} of the parts are out of tolerance${ro ? ` · ${rule === 'guard' ? 'simple' : 'guarded'}: ${ppm(ro.pfa)}` : ''}</small>`, cls: r.pfa > 1e-3 ? 'warn' : 'ok' },
          { dt: 'False reject', dd: `${ppm(r.pfr)} <small>good parts that fail${ro ? ` · ${rule === 'guard' ? 'simple' : 'guarded'}: ${ppm(ro.pfr)}` : ''}</small>`, cls: r.pfr > 0.02 ? 'warn' : '' },
        );
        if (sd > 0) rows.push({ dt: 'Process capability', dd: `C<sub>p</sub> ${f((usl - lsl) / (6 * sd), 2)} <small>C<sub>pk</sub> ${f(Math.min(usl - mean, mean - lsl) / (3 * sd), 2)}</small>` });
      }
      if (big.share > 0.5) notes.push(['warn', `One contribution (${big.name}) is ${f(100 * big.share, 0)}% of the variance. Improve that one first: a smaller change to the others has almost no effect.`]);
      if (t < 4) notes.push(['warn', `A TUR of ${f(t, 1)} is low. Guard bands then take a large part of the tolerance, or the risk at the limits is high. Use a better instrument, control the temperature, or measure the part in a different way.`]);
      notes.push(['', 'ISO 14253-1: the supplier proves conformance with the limits moved in by U, and the customer proves non-conformance with the limits moved out by U. Write the decision rule in the contract or on the drawing (ISO/TR 14253-6, ASME B89.7.3.1).']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, L = 16, R = 16, T = 50, B = 40;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const span = usl - lsl, x0 = Math.min(lsl - 0.25 * span, Number.isFinite(mean) ? mean - 4 * sd : lsl), x1 = Math.max(usl + 0.25 * span, Number.isFinite(mean) ? mean + 4 * sd : usl);
        const X = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
        if (sd > 0 && Number.isFinite(mean)) {
          const ys = Array.from({ length: 201 }, (_, i) => x0 + ((x1 - x0) * i) / 200), pk = 1 / (sd * Math.sqrt(2 * Math.PI)), Y = (p: number) => H - B - (p / pk) * (H - B - T - 8);
          const p = (x: number) => Math.exp(-0.5 * ((x - mean) / sd) ** 2) / (sd * Math.sqrt(2 * Math.PI));
          el('path', { d: `M${X(x0)},${H - B} ${ys.map((x) => `L${X(x).toFixed(1)},${Y(p(x)).toFixed(1)}`).join(' ')} L${X(x1)},${H - B} Z`, fill: 'var(--rd-blue)', 'fill-opacity': 0.18, stroke: 'var(--rd-blue)', 'stroke-width': 1.5 });
        }
        el('rect', { x: X(lsl), y: H - B + 4, width: X(usl) - X(lsl), height: 8, fill: 'var(--rd-ok)', 'fill-opacity': 0.5 });
        for (const v of [lsl, usl]) {
          el('rect', { x: X(v - b.U), y: T, width: X(v + b.U) - X(v - b.U), height: H - B - T, fill: 'var(--rd-warn)', 'fill-opacity': 0.14 });
          el('line', { x1: X(v), x2: X(v), y1: T - 8, y2: H - B + 12, stroke: 'var(--rd-ink)', 'stroke-width': 2 });
        }
        if (a.ok && rule === 'guard') for (const v of [a.lo, a.hi]) el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: 'var(--rd-accent)', 'stroke-width': 2, 'stroke-dasharray': '5 3' });
        txt(X(lsl), T - 14, 'LSL'); txt(X(usl), T - 14, 'USL');
        txt(W / 2, 14, rule === 'guard' ? 'dashed: acceptance limits · amber: ±U' : 'amber: ±U at each limit', 'var(--rd-muted)', 'middle', 11);
        txt(X(lsl), H - B + 26, g3(lsl), 'var(--rd-muted)', 'middle', 11); txt(X(usl), H - B + 26, g3(usl), 'var(--rd-muted)', 'middle', 11);
        txt(W / 2, H - 2, 'size (µm from nominal) · blue: the process', 'var(--rd-ink)', 'middle', 11);
      };
    }

    // ---- gauge R&R ----
    function runGrr(rows: Row[], notes: [string, string][]) {
      const s = parseStudy(field('r_data').value), tol = num('r_tol'), lim = readFactor(field('r_lim').value, 0.01);
      const r = s.data.length ? gaugeRR(s.data, tol) : null;
      if (!r) { notes.push(['bad', 'The study needs two or three operators, each with two or three lines (trials) of the same number of readings (two to ten parts).']); return null; }
      const pt = Number.isFinite(r.pctTol);
      rows.push(
        { dt: '%GRR of tolerance', dd: pt ? `${f(r.pctTol, 1)}% <small>6 × GRR ÷ tolerance · AIAG guidance: ${grrBand(r.pctTol)}${lim ? ` · your limit ${f(lim, 0)}%` : ''}</small>` : '<small>enter the tolerance</small>', primary: true, cls: lim && pt ? (r.pctTol <= lim ? 'ok' : 'bad') : '' },
        { dt: '%GRR of total variation', dd: `${f(r.pctGRR, 1)}% <small>AIAG guidance: ${grrBand(r.pctGRR)} · for process control</small>` },
        { dt: 'Repeatability EV', dd: `${g3(r.EV)} µm <small>the gauge: same operator, same part · ${f(r.pctEV, 1)}% of TV</small>` },
        { dt: 'Reproducibility AV', dd: `${g3(r.AV)} µm <small>between operators · ${f(r.pctAV, 1)}% of TV · operator means ${r.opMeans.map((m) => g3(m)).join(', ')}</small>` },
        { dt: 'Part variation PV', dd: `${g3(r.PV)} µm <small>${r.parts} parts · ${r.ops} operators × ${r.trials} trials</small>` },
        { dt: 'Distinct categories', dd: `${r.ndc} <small>1.41 PV ÷ GRR: at least 5 for process control</small>`, cls: r.ndc >= 5 ? 'ok' : 'warn' },
      );
      if (!lim) rows.push({ dt: 'Your limit', dd: '<small>Enter the %GRR limit of your programme or customer, or push “Load worked example”.</small>' });
      if (r.AV > r.EV) notes.push(['warn', 'Reproducibility is larger than repeatability: the operators do not measure in the same way. Look at the method, the training and the fixture before you buy a better gauge.']);
      else notes.push(['', 'Repeatability is the larger part: the gauge, the fixture or the part itself (form error, roughness, temperature) causes the scatter.']);
      if (r.ndc < 5) notes.push(['warn', 'Fewer than 5 distinct categories: the gauge cannot separate the parts well enough for SPC. The parts in the study may also cover too small a range.']);
      notes.push(['', 'GRR of tolerance tells if the gauge can accept parts. GRR of total variation tells if it can control the process. AIAG guidance: under 10% is acceptable, 10 to 30% can be acceptable for the application, over 30% is not acceptable.']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, L = 96, R = 18, T = 26, B = 34;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const items = [['repeatability', r.pctEV], ['reproducibility', r.pctAV], ['GRR', r.pctGRR], ['part', r.pctPV]] as [string, number][];
        const top = 100, X = (v: number) => L + (Math.min(v, top) / top) * (W - L - R), row = (H - T - B) / items.length;
        for (const v of [0, 10, 30, 50, 100]) {
          el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: v === 10 || v === 30 ? 'var(--rd-warn)' : 'var(--rd-line)', 'stroke-dasharray': v === 10 || v === 30 ? '4 3' : '' });
          txt(X(v), H - B + 14, `${v}%`, 'var(--rd-muted)', 'middle', 11);
        }
        items.forEach(([n, v], i) => {
          const y = T + i * row + row * 0.2;
          el('rect', { x: L, y, width: Math.max(1, X(v) - L), height: row * 0.6, rx: 2, fill: n === 'part' ? 'var(--rd-blue)' : n === 'GRR' ? 'var(--rd-accent)' : 'var(--rd-steel)', 'fill-opacity': 0.8 });
          txt(L - 6, y + row * 0.3 + 4, n, 'var(--rd-ink)', 'end');
        });
        txt((L + W - R) / 2, H - 4, 'share of total variation (σ ÷ TV)', 'var(--rd-ink)', 'middle', 11);
      };
    }

    // ---- limit gauges ----
    function runGauge(rows: Row[], notes: [string, string][]) {
      const feature = field('g_feat').value as 'hole' | 'shaft', lsl = num('g_lsl'), usl = num('g_usl'), gt = num('g_t'), gw = num('g_w'), pos = num('g_pos');
      root.querySelectorAll<HTMLElement>('[data-hole]').forEach((e) => (e.hidden = feature !== 'hole'));
      if (!(usl > lsl) || !(gt >= 0) || !(gw >= 0)) { notes.push(['bad', 'Enter the two size limits and the two percentages.']); return null; }
      const g = limitGauges({ feature, lsl, usl, gaugePct: gt, wearPct: gw });
      const hole = feature === 'hole', kind = hole ? 'plug' : 'ring';
      rows.push(
        { dt: `GO ${kind}, new`, dd: `${mm(g.go.lo)} to ${mm(g.go.hi)} mm <small>scrap at ${mm(g.go.wornAt)} mm (worn to the ${hole ? 'lower' : 'upper'} limit)</small>`, primary: true },
        { dt: `NOGO ${kind}`, dd: `${mm(g.nogo.lo)} to ${mm(g.nogo.hi)} mm <small>no wear allowance: a NOGO gauge seldom enters</small>` },
        { dt: 'Always accepted', dd: g.sure.hi > g.sure.lo ? `${mm(g.sure.lo)} to ${mm(g.sure.hi)} mm <small>${f(g.usablePct, 0)}% of the work tolerance · a part outside this band can be rejected by a gauge that is still in tolerance</small>` : 'none <small>the gauge tolerances are larger than the work tolerance</small>', cls: g.usablePct < 60 ? 'warn' : '' },
        { dt: 'Gauge tolerance', dd: `${f(g.T * 1000, 1)} µm <small>wear allowance ${f(g.W * 1000, 1)} µm · work tolerance ${f(g.tol * 1000, 1)} µm</small>` },
      );
      if (hole && pos > 0) {
        const p = functionalPin(lsl, pos, (gt / 100) * pos);
        rows.push({ dt: 'Functional gauge pin', dd: `${mm(p.lo)} to ${mm(p.hi)} mm <small>virtual condition ${mm(lsl)} − ${mm(pos)} at MMC, gauge tolerance on the product side</small>` });
        notes.push(['', 'A functional gauge checks the position of the holes at MMC and their form together. It does not check the size: use the GO and NOGO plugs for that.']);
      }
      if (g.usablePct < 60) notes.push(['warn', 'The gauges use a large part of the tolerance. For a fine tolerance, measure with a variable gauge and an uncertainty budget instead.']);
      notes.push(['', `Taylor's principle: the GO ${kind} has the full form and length of the mating part. The NOGO gauge checks one size at a time, in more than one direction.`]);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, L = 70, R = 16, T = 30, B = 40;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const pad = 0.12 * g.tol, x0 = lsl - pad, x1 = usl + pad, X = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R);
        const bar = (y: number, a: number, b: number, c: string, label: string, op = 0.8) => {
          el('rect', { x: X(a), y, width: Math.max(2, X(b) - X(a)), height: 26, rx: 2, fill: c, 'fill-opacity': op });
          txt(L - 6, y + 17, label, 'var(--rd-ink)', 'end');
        };
        bar(T, lsl, usl, 'var(--rd-steel)', 'work', 0.45);
        bar(T + 44, g.go.lo, g.go.hi, 'var(--rd-blue)', 'GO');
        const [wa, wb] = hole ? [g.go.wornAt, g.go.lo] : [g.go.hi, g.go.wornAt]; // the wear allowance, from new to scrap
        if (wb > wa) el('rect', { x: X(wa), y: T + 44, width: X(wb) - X(wa), height: 26, fill: 'none', stroke: 'var(--rd-blue)', 'stroke-dasharray': '4 3' });
        bar(T + 88, g.nogo.lo, g.nogo.hi, 'var(--rd-accent)', 'NOGO');
        if (g.sure.hi > g.sure.lo) bar(T + 132, g.sure.lo, g.sure.hi, 'var(--rd-ok)', 'accepted', 0.6);
        for (const v of [lsl, usl]) { el('line', { x1: X(v), x2: X(v), y1: T - 6, y2: H - B, stroke: 'var(--rd-ink)', 'stroke-opacity': 0.6 }); txt(X(v), H - B + 14, f(v, 3), 'var(--rd-muted)', 'middle', 11); }
        txt(W / 2, 16, 'dashed: GO wear allowance', 'var(--rd-muted)', 'middle', 11);
        txt((L + W - R) / 2, H - 4, 'size (mm)', 'var(--rd-ink)', 'middle', 11);
      };
    }

    const RUN: Record<string, typeof runUnc> = { unc: runUnc, grr: runGrr, gauge: runGauge };
    const CAPS: Record<string, string> = {
      unc: 'The process (blue) against the tolerance, the uncertainty band ±U at each limit (amber) and, for the guarded rule, the acceptance limits (dashed).',
      grr: 'Each source as a share of the total variation. The dashed lines are the 10% and 30% guidance values of AIAG.',
      gauge: 'The work tolerance, the GO gauge with its wear allowance, the NOGO gauge, and the band of sizes that every gauge in tolerance accepts.',
    };

    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    wireWorkedExample({
      root, onLoad: run, factorFields: ['u_req', 'r_lim'],
      note: 'Worked-example criteria loaded: TUR at least 4, %GRR at most 20% of the tolerance',
      values: { u_req: '4', r_lim: '20' },
    });
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 200); });
    form.addEventListener('change', run);
    run();
  });
</script>
