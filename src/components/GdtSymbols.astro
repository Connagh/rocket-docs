---
// The geometric characteristics, grouped as ASME Y14.5 groups them: what each controls, whether it needs a datum, and
// where it earns its place on motor hardware. Glyphs from src/lib/gdtglyphs.ts.
import { GLYPHS } from '../lib/gdtglyphs';

const GROUPS: { name: string; datum: string; items: { key: string; name: string; controls: string; motor: string; gone?: boolean }[] }[] = [
  { name: 'Form', datum: 'never uses a datum', items: [
    { key: 'straightness', name: 'Straightness', controls: 'A line on a surface, or an axis, within a zone.', motor: 'The axis of a long case cylinder.' },
    { key: 'flatness', name: 'Flatness', controls: 'A surface between two parallel planes.', motor: 'A face-seal land on a closure.' },
    { key: 'circularity', name: 'Circularity', controls: 'Each cross-section between two concentric circles.', motor: 'A case bore at a seal: often in the restrained condition.' },
    { key: 'cylindricity', name: 'Cylindricity', controls: 'The whole surface between two coaxial cylinders.', motor: 'A pilot that fits the case bore.' },
  ] },
  { name: 'Orientation', datum: 'needs a datum', items: [
    { key: 'perpendicularity', name: 'Perpendicularity', controls: 'A surface or axis at 90° to a datum.', motor: 'The aft flange face to the case axis.' },
    { key: 'angularity', name: 'Angularity', controls: 'A surface or axis at a basic angle to a datum.', motor: 'A canted port or nozzle seat.' },
    { key: 'parallelism', name: 'Parallelism', controls: 'A surface or axis parallel to a datum.', motor: 'The two walls of a face-seal groove.' },
  ] },
  { name: 'Location', datum: 'needs datums', items: [
    { key: 'position', name: 'Position', controls: 'An axis or centre plane within a zone around its true position, set by basic dimensions.', motor: 'Bolt holes, bosses, ports, dowels.' },
    { key: 'concentricity', name: 'Concentricity', controls: 'Median points about a datum axis.', motor: 'Removed from ASME Y14.5 in 2018: use position, runout or profile.', gone: true },
    { key: 'symmetry', name: 'Symmetry', controls: 'Median points about a datum centre plane.', motor: 'Removed from ASME Y14.5 in 2018; still in ISO.', gone: true },
  ] },
  { name: 'Profile', datum: 'with or without datums', items: [
    { key: 'profileLine', name: 'Profile of a line', controls: 'Each line element of a surface within a zone about its true profile.', motor: 'A groove section, a contour checked by sections.' },
    { key: 'profileSurface', name: 'Profile of a surface', controls: 'Every point of a surface within a zone about its true profile: size, form, orientation and location at once.', motor: 'Dome and nozzle contours, any complex surface.' },
  ] },
  { name: 'Runout', datum: 'needs a datum axis', items: [
    { key: 'runout', name: 'Circular runout', controls: 'Each circular element as the part turns about the datum axis.', motor: 'A seal-groove root relative to its pilot.' },
    { key: 'totalRunout', name: 'Total runout', controls: 'The whole surface as the part turns and the indicator travels.', motor: 'A pilot or seal land that must run true along its length.' },
  ] },
];
---

<figure class="viz gsy">
  <p class="viz-title">The geometric characteristics</p>
  {GROUPS.map((g) => (
    <section class="gsy-group">
      <h4>{g.name} <span>{g.datum}</span></h4>
      <div class="gsy-grid">
        {g.items.map((it) => (
          <div class:list={['gsy-card', { gone: it.gone }]}>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d={GLYPHS[it.key].d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"></path>
              {GLYPHS[it.key].fill && <path d={GLYPHS[it.key].fill} fill="currentColor"></path>}
            </svg>
            <div>
              <b>{it.name}</b>
              <p>{it.controls}</p>
              <p class="gsy-motor">{it.motor}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
  <figcaption>
    Form controls a feature on its own; orientation, location and runout control it relative to datums; profile can do
    either. Each has a tolerance zone of a particular shape: the frame says which.
  </figcaption>
</figure>

<style>
  .gsy-group { margin: 0.6rem 0 0 !important; }
  .gsy-group h4 { margin: 0 0 0.4rem !important; font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--rd-ink); }
  .gsy-group h4 span { color: var(--rd-muted); letter-spacing: 0.04em; text-transform: none; margin-left: 0.4rem; }
  .gsy-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 0.5rem; }
  .gsy-grid > * { margin: 0 !important; }
  .gsy-card { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.5rem 0.6rem; border: 1px solid var(--rd-line); border-radius: 6px; }
  .gsy-card svg { flex: 0 0 auto; width: 1.9rem; height: 1.9rem; color: var(--rd-accent); }
  .gsy-card.gone svg { color: var(--rd-muted); }
  .gsy-card b { font-size: var(--sl-text-sm); }
  .gsy-card p { margin: 0.15rem 0 0 !important; font-size: var(--sl-text-xs); line-height: 1.45; }
  .gsy-card .gsy-motor { color: var(--rd-muted); }
</style>
