---
// Test correlation in four tabs: strain gauges against the model, the uncertainty of one gauge reading, modal
// correlation by frequency and MAC, and which physical parameter could plausibly close a frequency gap. Acceptance
// criteria are the programme's and start blank. Maths in src/lib/correlation.ts (unit-tested); UI only here.
const TABS = [{ key: 'gauges', name: 'Strain gauges' }, { key: 'uncert', name: 'Gauge uncertainty' }, { key: 'modes', name: 'Modes & MAC' }, { key: 'explain', name: 'What could explain it' }];
const GAUGES = `G1 hoop, mid-cylinder, 4990, 5021
G2 axial, mid-cylinder, 1245, 1233
G3 hoop, 100 mm from aft flange, 4950, 5021
G4 axial, 100 mm from aft flange, 1260, 1233
G5 hoop, 250 mm from fwd dome, 4680, 5021
G6 axial, 250 mm from fwd dome, 1150, 1233
G7 meridional, aft dome, 4230, 4169
G8 hoop, aft dome, 4120, 4169`;
const TEST_MODES = `0.07 -0.19 0.45
0.20 -0.55 0.70
0.37 -0.69 0.06
0.57 -0.42 -0.60
0.78 0.20 -0.25
1.00 1.00 1.00`;
const MODEL_MODES = `0.045 -0.225 0.489
0.166 -0.590 0.722
0.340 -0.714 0.020
0.547 -0.423 -0.644
0.771 0.216 -0.218
1.000 1.000 1.000`;
const PARAMS = `Young's modulus, 0.5, 3
Density, -0.5, 2
Bracket thickness, 1.0, 4
Root joint stiffness, 0.35, 50`;
---

<div class="calc cocalc" data-cocalc>
  <div class="calc-head"><span>Test correlation</span><span class="head-btns"><span>model against test</span><button type="button" class="chip" data-load-example>Load worked example</button></span></div>
  <div class="hc-tabs" role="tablist" aria-label="Correlation check">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="gauges">
        <legend>Gauges: name, test, model (µε)</legend>
        <textarea name="s_rows" rows="9" spellcheck="false">{GAUGES}</textarea>
        <div class="row2">
          <label>Acceptance band ± (%)<input name="s_band" type="number" min="0" step="any" placeholder="your criterion" autocomplete="off" /></label>
        </div>
        <p class="hint">One gauge per line. Compare the model's strain averaged over the gauge length, on the gauged surface, in the gauge's direction — and preferably slopes of strain against load, which remove zero offsets.</p>
      </fieldset>

      <fieldset data-panel="uncert" hidden>
        <legend>One gauge</legend>
        <div class="row2">
          <label>Principal strain ε<sub>1</sub> (µε)<input name="u_e1" type="number" step="any" value="4950" /></label>
          <label>Principal strain ε<sub>2</sub> (µε)<input name="u_e2" type="number" step="any" value="1260" /></label>
          <label>Gauge angle from ε<sub>1</sub> (°)<input name="u_ang" type="number" step="any" value="90" /></label>
          <label>Gauge factor tolerance ± (%)<input name="u_gf" type="number" min="0" step="any" value="1" /></label>
          <label>Transverse sensitivity (%)<input name="u_kt" type="number" step="any" value="0.5" /></label>
          <label>Its calibration ν<sub>0</sub><input name="u_nu0" type="number" step="any" value="0.285" /></label>
          <label>Misalignment (°)<input name="u_mis" type="number" min="0" step="any" value="2" /></label>
          <label>Position error (mm)<input name="u_pos" type="number" min="0" step="any" value="1" /></label>
          <label>Strain gradient there (µε/mm)<input name="u_grad" type="number" min="0" step="any" value="0" /></label>
          <label>Instrumentation ± (µε)<input name="u_ins" type="number" min="0" step="any" value="5" /></label>
        </div>
        <p class="hint">Gauge-factor tolerance and transverse sensitivity from the gauge data sheet. The gradient comes from the model at the gauge site.</p>
      </fieldset>

      <fieldset data-panel="modes" hidden>
        <legend>Modal survey against modal analysis</legend>
        <div class="row2">
          <label>Test frequencies (Hz)<input name="m_ft" type="text" value="138, 905, 2590" /></label>
          <label>Model frequencies (Hz)<input name="m_fm" type="text" value="150, 940, 2632" /></label>
        </div>
        <div class="row2">
          <label>Test shapes<textarea name="m_st" rows="6" spellcheck="false">{TEST_MODES}</textarea></label>
          <label>Model shapes<textarea name="m_sm" rows="6" spellcheck="false">{MODEL_MODES}</textarea></label>
        </div>
        <div class="row2">
          <label>Frequency criterion ± (%)<input name="m_df" type="number" min="0" step="any" placeholder="your criterion" autocomplete="off" /></label>
          <label>MAC at least<input name="m_mac" type="number" min="0" max="1" step="any" placeholder="your criterion" autocomplete="off" /></label>
        </div>
        <p class="hint">Shapes: one row per measured point, one column per mode, at the same points and directions in both. The model's shapes are read at the accelerometer locations.</p>
      </fieldset>

      <fieldset data-panel="explain" hidden>
        <legend>One frequency, several suspects</legend>
        <div class="row2">
          <label>Test frequency (Hz)<input name="e_ft" type="number" min="0" step="any" value="138" /></label>
          <label>Model frequency (Hz)<input name="e_fm" type="number" min="0" step="any" value="150" /></label>
        </div>
        <label>Parameters: name, sensitivity ∂ln f/∂ln p, plausible ± (%)<textarea name="e_rows" rows="5" spellcheck="false">{PARAMS}</textarea></label>
        <p class="hint">Sensitivity 0.5 for a modulus or a spring that carries the whole mode, −0.5 for a density; others from the model's own sensitivity analysis. Plausible ranges from what you actually know about each parameter.</p>
      </fieldset>
      <p class="hint example-note" data-example-note hidden></p>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected correlation check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Ratios and least-squares statistics on paired readings. Gauge errors after Vishay TN-509 and TN-511, combined by root
    sum of squares. MAC after Allemang and Brown — not mass-weighted, so not a cross-orthogonality check. Single-parameter
    sensitivities only.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .cocalc .readout dd small { display: block; margin-top: 0.15rem; }
  .cocalc .nc { text-transform: none; }
  .cocalc textarea { width: 100%; font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); background: var(--rd-panel2, var(--rd-panel)); color: var(--rd-ink); border: 1px solid var(--rd-line); border-radius: 4px; padding: 0.4rem; resize: vertical; }
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .cocalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { gaugeStats, parseGauges, gaugeUncertainty, macMatrix, parseModes, pairModes, requiredChange } from '../lib/correlation';
  import { wireWorkedExample } from '../lib/factors';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '—');
  const g3 = (v: number) => (Math.abs(v) >= 100 ? f(v, 0) : Math.abs(v) >= 10 ? f(v, 1) : Math.abs(v) >= 1 ? f(v, 2) : f(v, 3));
  const pc = (v: number, d = 1) => (Math.abs(v) < 5e-5 ? '0.0%' : `${v >= 0 ? '+' : '−'}${f(Math.abs(100 * v), d)}%`);
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-cocalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const list = (n: string) => field(n).value.split(/[,;\s]+/).filter((s) => s !== '').map(Number).filter(Number.isFinite);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    let mode = 'gauges';
    let draw: (() => void) | null = null;
    const size = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    const criterion = (name: string, what: string) => `<small>Enter your programme's ${name} to ${what}. Criteria come from your governing requirement, not from this site. Or press “Load worked example”.</small>`;

    // ---- strain gauges ----
    function runGauges(rows: Row[], notes: [string, string][]) {
      const g = parseGauges(field('s_rows').value), bandPct = num('s_band'), band = bandPct > 0 ? bandPct / 100 : undefined;
      if (g.length < 2) { notes.push(['bad', 'Enter at least two gauges as "name, test, model".']); return null; }
      const s = gaugeStats(g, band);
      rows.push(
        { dt: 'Mean test / model', dd: `${f(s.mean, 3)} <small>${s.n} gauges · scatter ${f(100 * s.sd, 1)}% (one standard deviation)</small>`, primary: true },
        { dt: 'Slope through the origin', dd: `${f(s.slope, 3)} <small>least squares, test on model · R² ${f(s.r2, 4)}</small>` },
        band !== undefined
          ? { dt: `Outside ±${f(bandPct, Number.isInteger(bandPct) ? 0 : 1)}%`, dd: `${s.outside} of ${s.n} <small>${s.each.filter((x) => x.out).map((x) => esc(x.name.split(/\s/)[0])).join(', ') || 'none'}</small>`, cls: s.outside ? 'bad' : 'ok' }
          : { dt: 'Acceptance', dd: criterion('acceptance band', 'mark the gauges outside it') },
        { dt: 'Furthest from the model', dd: (() => { const w = s.each.reduce((a, b) => (Math.abs(b.ratio - 1) > Math.abs(a.ratio - 1) ? b : a)); return `${pc(w.ratio - 1)} <small>${esc(w.name)}</small>`; })() },
      );
      // patterns that point to causes
      // outliers against the median, which a couple of bad gauges cannot drag the way they drag the mean
      const med = (v: number[]) => { const a = [...v].sort((x, y) => x - y), m = a.length >> 1; return a.length % 2 ? a[m] : (a[m - 1] + a[m]) / 2; };
      const mid = med(s.each.map((x) => x.ratio)), mad = med(s.each.map((x) => Math.abs(x.ratio - mid)));
      const off = s.each.filter((x) => Math.abs(x.ratio - mid) > Math.max(2 * mad, 0.03));
      if (Math.abs(s.mean - 1) > 0.05 && s.sd < 0.03) notes.push(['warn', 'Every gauge is off by about the same ratio: look for something global — the applied load or pressure calibration, the modulus, the wall thickness everywhere — before anything local.']);
      if (off.length >= 2) notes.push(['warn', `${off.map((x) => esc(x.name.split(/\s/)[0])).join(' and ')} stand apart from the rest. If they share a location and are off by the same ratio in both directions, suspect the local wall or material; if only one direction is off, suspect the gauge, its orientation or local bending.`]);
      notes.push(['', 'An acceptance band must be wider than the gauges can resolve — see the Gauge uncertainty tab — and is set by your programme, not chosen after seeing the data.']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, L = 64, R = 20, T = 30, B = 46;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const lim = Math.max(0.1, ...s.each.map((x) => Math.abs(x.ratio - 1))) * 1.15;
        const X = (i: number) => L + 10 + (i / Math.max(1, s.n - 1)) * (W - L - R - 20), Y = (d: number) => T + ((lim - d) / (2 * lim)) * (H - T - B);
        if (band !== undefined) el('rect', { x: L, y: Y(band), width: W - L - R, height: Y(-band) - Y(band), fill: 'var(--rd-ok)', 'fill-opacity': 0.1 });
        const step = lim > 0.2 ? 0.1 : 0.05;
        for (let d = -Math.floor(lim / step) * step; d <= lim + 1e-9; d += step) {
          el('line', { x1: L, x2: W - R, y1: Y(d), y2: Y(d), stroke: Math.abs(d) < 1e-9 ? 'var(--rd-ink)' : 'var(--rd-line)', 'stroke-opacity': Math.abs(d) < 1e-9 ? 0.6 : 1 });
          el('text', { x: L - 6, y: Y(d) + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-muted)' }, `${d > 1e-9 ? '+' : ''}${f(100 * d, 0)}`);
        }
        s.each.forEach((x, i) => {
          el('circle', { cx: X(i), cy: Y(x.ratio - 1), r: 5, fill: x.out ? 'var(--rd-accent)' : 'var(--rd-blue)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
          if (s.n <= 12) el('text', { x: X(i), y: H - B + 15, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, esc(x.name.split(/\s/)[0]).slice(0, 4));
        });
        el('text', { x: (L + W - R) / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'gauge');
        el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, 'test / model − 1 (%)');
      };
    }

    // ---- gauge uncertainty ----
    function runUncert(rows: Row[], notes: [string, string][]) {
      const u = { e1: num('u_e1'), e2: num('u_e2'), angle: num('u_ang') || 0, gfTol: (num('u_gf') || 0) / 100, kt: (num('u_kt') || 0) / 100, nu0: num('u_nu0') || 0.285, misalign: num('u_mis') || 0, posErr: num('u_pos') || 0, gradient: num('u_grad') || 0, instr: num('u_ins') || 0 };
      if (!Number.isFinite(u.e1) || !Number.isFinite(u.e2)) { notes.push(['bad', 'Enter the two principal strains at the gauge site.']); return null; }
      const r = gaugeUncertainty(u);
      const names: Record<string, string> = { gaugeFactor: 'Gauge factor', transverse: 'Transverse sensitivity', misalignment: 'Misalignment', position: 'Position × gradient', instrument: 'Instrumentation' };
      rows.push({ dt: 'Reading', dd: `${f(r.reading, 0)} µε <small>± ${f(r.total, 0)} µε, ${pc(r.fraction).replace('+', '')} — root sum of squares</small>`, primary: true });
      const biggest = Object.entries(r.parts).reduce((a, b) => (b[1] > a[1] ? b : a));
      Object.entries(r.parts).forEach(([k, v]) => rows.push({ dt: names[k], dd: `${f(v, 1)} µε <small>${f((100 * v * v) / (r.total * r.total || 1), 0)}% of the variance</small>`, cls: k === biggest[0] && v > 0 ? 'warn' : '' }));
      if (biggest[0] === 'transverse') notes.push(['warn', `Transverse sensitivity dominates: the transverse strain (${f(r.trans, 0)} µε) is large against the reading. It is systematic, so correct for it with the rosette's own transverse reading rather than carrying it as uncertainty.`]);
      if (biggest[0] === 'misalignment') notes.push(['warn', 'Misalignment dominates: the gauge is far from a principal direction, where angle errors matter at first order. Along a principal direction they barely matter.']);
      if (biggest[0] === 'position') notes.push(['warn', 'The gauge sits in a steep gradient: its reading depends on exactly where it is. Move it to a gentler region, or compare with the model averaged over the gauge.']);
      notes.push(['', 'An acceptance band tighter than this uncertainty cannot be met, however good the model.']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, Lx = 120, R = 20, T = 30, B = 34, items = Object.entries(r.parts);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const top = Math.max(...items.map(([, v]) => v), r.total) * 1.1 || 1, X = (v: number) => Lx + (v / top) * (W - Lx - R), row = (H - T - B) / (items.length + 1);
        [...items, ['total (RSS)', r.total] as [string, number]].forEach(([k, v], i) => {
          const y = T + i * row + row * 0.2;
          el('rect', { x: Lx, y, width: Math.max(1, X(v) - Lx), height: row * 0.6, rx: 2, fill: k === 'total (RSS)' ? 'var(--rd-ink)' : k === biggest[0] ? 'var(--rd-warn)' : 'var(--rd-blue)', 'fill-opacity': 0.8 });
          el('text', { x: Lx - 6, y: y + row * 0.3 + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)' }, k === 'total (RSS)' ? 'total' : (names[k] ?? k).split(' ')[0].toLowerCase());
        });
        el('text', { x: W / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'error (µε)');
      };
    }

    // ---- modes and MAC ----
    function runModes(rows: Row[], notes: [string, string][]) {
      const ft = list('m_ft'), fm = list('m_fm'), st = parseModes(field('m_st').value), sm = parseModes(field('m_sm').value);
      if (!st.length || !sm.length || st[0].length !== sm[0].length) { notes.push(['bad', 'Enter test and model shapes at the same measured points — the same number of rows in both.']); return null; }
      if (ft.length < st.length || fm.length < sm.length) { notes.push(['bad', 'Give a frequency for every mode shape (one per column).']); return null; }
      const M = macMatrix(st, sm), pairs = pairModes(ft, fm, M), auto = macMatrix(st, st);
      const dfc = num('m_df') > 0 ? num('m_df') / 100 : NaN, macc = num('m_mac') > 0 ? num('m_mac') : NaN;
      const offAuto = Math.max(0, ...auto.flatMap((r, i) => r.filter((_, j) => j !== i)));
      pairs.forEach((p, k) => {
        const okF = !Number.isFinite(dfc) || Math.abs(p.df) <= dfc, okM = !Number.isFinite(macc) || p.mac >= macc;
        rows.push({ dt: `Test mode ${p.test + 1}`, dd: `${g3(p.fTest)} Hz ↔ model ${p.model + 1}, ${g3(p.fModel)} Hz <small>model ${pc(p.df)} · MAC ${f(p.mac, 3)}</small>`, primary: k === 0, cls: Number.isFinite(dfc) || Number.isFinite(macc) ? (okF && okM ? 'ok' : 'bad') : '' });
      });
      if (!Number.isFinite(dfc) && !Number.isFinite(macc)) rows.push({ dt: 'Criteria', dd: criterion('frequency and MAC criteria', 'judge each pair') });
      rows.push({ dt: 'Test AutoMAC, off-diagonal', dd: `${f(offAuto, 3)} <small>the best separation these measurement points can give</small>`, cls: offAuto > 0.25 ? 'warn' : '' });
      const dup = new Set(pairs.map((p) => p.model)).size < pairs.length;
      if (dup) notes.push(['bad', 'Two test modes pair with the same model mode: the model is missing a mode, or the measurement points cannot tell two shapes apart.']);
      if (offAuto > 0.25) notes.push(['warn', 'The test modes look alike at these points (high off-diagonal AutoMAC): add measurement points, or the MAC cannot distinguish the shapes.']);
      const trend = pairs.length >= 2 && Math.abs(pairs[0].df) > 2 * Math.abs(pairs[pairs.length - 1].df);
      if (trend) notes.push(['warn', 'The first mode is furthest off and higher ones closer: the classic signature of a boundary or joint that is softer (or stiffer) than modelled, since the lowest modes depend most on their supports.']);
      notes.push(['', 'MAC compares shapes, not frequencies, and ignores mass. Where mass-normalised modes and a test-analysis mass matrix exist, cross-orthogonality is the stronger check.']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, nT = M.length, nM = M[0].length, Lx = 72, T = 34, B = 40;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const cell = Math.min((W - Lx - 20) / nM, (H - T - B) / nT), x0 = Lx + (W - Lx - 20 - cell * nM) / 2;
        M.forEach((row, i) => row.forEach((v, j) => {
          el('rect', { x: x0 + j * cell, y: T + i * cell, width: cell - 2, height: cell - 2, rx: 3, fill: 'var(--rd-blue)', 'fill-opacity': 0.08 + 0.85 * v });
          el('text', { x: x0 + j * cell + cell / 2 - 1, y: T + i * cell + cell / 2 + 4, 'text-anchor': 'middle', 'font-size': 12, fill: v > 0.5 ? 'var(--rd-panel)' : 'var(--rd-ink)' }, f(v, 2));
        }));
        for (let i = 0; i < nT; i++) el('text', { x: x0 - 6, y: T + i * cell + cell / 2 + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)' }, `test ${i + 1}`);
        for (let j = 0; j < nM; j++) el('text', { x: x0 + j * cell + cell / 2 - 1, y: T - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, `model ${j + 1}`);
        el('text', { x: W / 2, y: H - 8, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-muted)' }, 'MAC: 1 = same shape, 0 = unrelated');
      };
    }

    // ---- what could explain it ----
    function runExplain(rows: Row[], notes: [string, string][]) {
      const ft = num('e_ft'), fm = num('e_fm');
      const params = field('e_rows').value.split(/\r?\n/).map((l) => l.split(',').map((s) => s.trim())).filter((p) => p.length >= 3 && Number.isFinite(+p[1]) && +p[1] !== 0 && Number.isFinite(+p[2]))
        .map(([name, S, pl]) => ({ name, S: +S, plaus: +pl / 100 }));
      if (!(ft > 0 && fm > 0) || !params.length) { notes.push(['bad', 'Enter both frequencies and at least one parameter as "name, sensitivity, plausible ±%".']); return null; }
      const res = params.map((p) => ({ ...p, need: requiredChange(ft, fm, p.S) })).map((p) => ({ ...p, ok: Math.abs(p.need) <= p.plaus }));
      rows.push({ dt: 'Gap', dd: `${pc(fm / ft - 1)} <small>model ${g3(fm)} Hz against test ${g3(ft)} Hz</small>`, primary: true });
      res.forEach((p) => rows.push({ dt: esc(p.name), dd: `${pc(p.need)} <small>needed alone, against ±${f(100 * p.plaus, 0)}% plausible — ${p.ok ? 'could explain it' : 'cannot, on its own'}</small>`, cls: p.ok ? 'ok' : 'bad' }));
      const plausible = res.filter((p) => p.ok);
      if (!plausible.length) notes.push(['bad', 'No single parameter can close the gap within what is known about it: the model is missing something — a joint, a mass, a boundary condition, a piece of physics. Find it rather than stretching a parameter.']);
      else if (plausible.length === 1) notes.push(['ok', `Only ${esc(plausible[0].name.toLowerCase())} can close the gap within its uncertainty. Change it — once, with the reason recorded — then check the modes and gauges that were not used to make the change.`]);
      else notes.push(['warn', 'Several parameters could each close the gap: one frequency cannot tell them apart. Use other modes, other tests or direct measurement to decide.']);
      notes.push(['', 'A change that fits one result is a hypothesis; one that also predicts results it was not fitted to is a correlation.']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, Lx = 120, R = 20, T = 30, B = 34;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const lim = Math.max(...res.map((p) => Math.max(Math.abs(p.need), p.plaus))) * 1.1, X = (v: number) => Lx + ((v + lim) / (2 * lim)) * (W - Lx - R), row = (H - T - B) / res.length;
        el('line', { x1: X(0), x2: X(0), y1: T, y2: H - B, stroke: 'var(--rd-ink)', 'stroke-opacity': 0.6 });
        res.forEach((p, i) => {
          const y = T + i * row + row * 0.2;
          el('rect', { x: X(-p.plaus), y, width: X(p.plaus) - X(-p.plaus), height: row * 0.6, rx: 2, fill: 'var(--rd-ok)', 'fill-opacity': 0.18 });
          el('circle', { cx: X(Math.max(-lim, Math.min(lim, p.need))), cy: y + row * 0.3, r: 5.5, fill: p.ok ? 'var(--rd-ok)' : 'var(--rd-accent)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
          el('text', { x: Lx - 6, y: y + row * 0.3 + 4, 'text-anchor': 'end', 'font-size': 12, fill: 'var(--rd-ink)' }, p.name.length > 14 ? `${p.name.slice(0, 13)}…` : p.name);
        });
        el('text', { x: W / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 12, fill: 'var(--rd-ink)' }, 'change needed · band: plausible');
      };
    }

    const RUN: Record<string, typeof runGauges> = { gauges: runGauges, uncert: runUncert, modes: runModes, explain: runExplain };
    const CAPS: Record<string, string> = {
      gauges: 'Each gauge as test ÷ model − 1. The shaded band is the acceptance criterion, once entered; red points are outside it.',
      uncert: 'The contributions to one reading\'s uncertainty and their root sum of squares.',
      modes: 'MAC between every test mode (rows) and every model mode (columns). A good correlation has a strong diagonal and a weak rest.',
      explain: 'The change each parameter would need to close the gap on its own (dot), against how far it could plausibly be off (band).',
    };

    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    wireWorkedExample({
      root, onLoad: run, factorFields: ['s_band', 'm_df', 'm_mac'],
      note: 'Worked-example criteria loaded: ±5% on gauges, ±5% on frequencies, MAC at least 0.9',
      values: { s_band: '5', m_df: '5', m_mac: '0.9' },
    });
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
    form.addEventListener('change', run);
    run();
  });
</script>
