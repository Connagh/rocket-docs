---
// The two load paths in a firing motor, on the page's worked example: the pressure end loads, which balance inside the
// case, and the thrust, which runs forward through the case wall and skirt into the payload. Values from
// src/lib/loadpath.ts; schematic proportions.
import { pressureLoads, flightLoads } from '../lib/loadpath';

const pl = pressureLoads(10, 300, 1.5, 50, 110, 260);
const ig = flightLoads(pl.F, 137.81, 50), bo = flightLoads(pl.F, 26.61, 50);
const kN = (v: number) => (v / 1000).toFixed(1);
const kN0 = (v: number) => (v / 1000).toFixed(0);

const R = 26, X0 = 88, X1 = 232, RX = 18, OPEN = 8, MID = (X0 + X1) / 2;
const xo = X1 + RX * Math.sqrt(1 - (OPEN / R) ** 2);
const domeF = (dy: number) => X0 - RX * Math.sqrt(1 - (dy / R) ** 2);
const domeA = (dy: number) => X1 + RX * Math.sqrt(1 - (dy / R) ** 2);
const fill = (cy: number) =>
  `M${X0},${cy - R} L${X1},${cy - R} A${RX},${R} 0 0 1 ${xo},${cy - OPEN} L${xo},${cy + OPEN} A${RX},${R} 0 0 1 ${X1},${cy + R} L${X0},${cy + R} A${RX},${R} 0 0 1 ${X0},${cy - R} Z`;
const shell = (cy: number) =>
  `M${xo},${cy - OPEN} A${RX},${R} 0 0 0 ${X1},${cy - R} L${X0},${cy - R} A${RX},${R} 0 0 0 ${X0},${cy + R} L${X1},${cy + R} A${RX},${R} 0 0 0 ${xo},${cy + OPEN}` +
  ` M${xo},${cy - OPEN} L260,${cy - 3.5} L304,${cy - 17} M${xo},${cy + OPEN} L260,${cy + 3.5} L304,${cy + 17}` +
  ` M${X0},${cy - R} L56,${cy - R} M${X0},${cy + R} L56,${cy + R} M${X1},${cy - R} L258,${cy - R} M${X1},${cy + R} L258,${cy + R}`;
// a tapered band along a wall, pointing forward into the payload: thick where the thrust enters, thin where it leaves
const band = (y: number) => `M${X1},${y - 4} L64,${y - 1.6} L64,${y - 5.5} L52,${y} L64,${y + 5.5} L64,${y + 1.6} L${X1},${y + 4} Z`;
const arrow = (x1: number, y: number, x2: number) => `M${x1},${y} L${x2},${y} M${x2 + Math.sign(x1 - x2) * 6},${y - 3.5} L${x2},${y} L${x2 + Math.sign(x1 - x2) * 6},${y + 3.5}`;

const A = 78, B = 234; // panel centre lines
const blue = 'var(--rd-blue)', hot = 'var(--rd-accent)', ink = 'var(--rd-ink)', muted = 'var(--rd-muted)';
---

<figure class="viz lpd">
  <p class="viz-title">Two load paths in a firing motor</p>
  <svg viewBox="0 0 320 304" role="img" aria-labelledby="lpd-desc" style="max-width: 380px; margin: 0 auto;">
    <desc id="lpd-desc">
      Two side views of the worked-example motor. Top: chamber pressure pushes the forward dome forward with {kN0(pl.fwd)} kN
      and the aft end back with {kN0(pl.aft)} kN; the case wall holds them together in tension, and the {kN(pl.F)} kN
      difference is the thrust. Bottom: the thrust runs forward through the case wall and forward skirt into the payload,
      which receives {kN(ig.skirt)} kN at ignition and {kN(bo.skirt)} kN at burnout; the rest accelerates the motor itself.
    </desc>

    <text x="10" y="14" font-size="12" font-weight="600" fill={blue}>Pressure — balanced inside the case</text>
    <path d={fill(A)} fill={blue} fill-opacity="0.13"></path>
    <rect x="10" y={A - R} width="46" height={2 * R} rx="3" fill="none" stroke={muted} stroke-dasharray="4 3"></rect>
    <text x="33" y={A + 4} text-anchor="middle" font-size="12" fill={muted}>payload</text>
    <path d={shell(A)} fill="none" stroke="var(--rd-steel)" stroke-width="2.4" stroke-linejoin="round"></path>
    {[-12, 0, 12].map((dy) => <path d={arrow(98, A + dy, domeF(dy) + 2)} fill="none" stroke={blue} stroke-width="1.8"></path>)}
    {[-16, 16].map((dy) => <path d={arrow(222, A + dy, domeA(dy) - 2)} fill="none" stroke={blue} stroke-width="1.8"></path>)}
    <text x={MID} y={A + 4} text-anchor="middle" font-size="12" fill={blue}>p = 10 MPa</text>
    <path d={arrow(MID - 72, 34, MID - 94) + ' ' + arrow(MID + 72, 34, MID + 94)} fill="none" stroke={blue} stroke-width="1.6"></path>
    <text x={MID} y="38" text-anchor="middle" font-size="12" fill={ink}>wall tension {kN0(pl.fwd)} kN</text>
    <text x="10" y="124" font-size="12" fill={ink}>forward dome {kN0(pl.fwd)} kN</text>
    <text x="310" y="124" text-anchor="end" font-size="12" fill={ink}>aft end {kN0(pl.aft)} kN</text>
    <text x="160" y="141" text-anchor="middle" font-size="12" fill={blue}>the {kN(pl.F)} kN difference is the thrust</text>

    <line x1="10" x2="310" y1="153" y2="153" stroke="var(--rd-line)"></line>

    <text x="10" y="170" font-size="12" font-weight="600" fill={hot}>Thrust — out through the forward skirt</text>
    <rect x="10" y={B - R} width="46" height={2 * R} rx="3" fill="none" stroke={muted} stroke-dasharray="4 3"></rect>
    <text x="33" y={B + 4} text-anchor="middle" font-size="12" fill={muted}>payload</text>
    {[-1, 1].map((s) => <rect x={X0 + 4} y={s < 0 ? B - R + 2 : B + 9} width={X1 - X0 - 8} height={R - 11} fill="var(--rd-propellant)" fill-opacity="0.45"></rect>)}
    <path d={shell(B)} fill="none" stroke="var(--rd-steel)" stroke-width="2.4" stroke-linejoin="round"></path>
    {[MID - 36, MID, MID + 36].flatMap((x) => [-16.5, 16.5].map((dy) => <path d={arrow(x - 8, B + dy, x + 8)} fill="none" stroke={ink} stroke-opacity="0.75" stroke-width="1.4"></path>))}
    <path d={band(B - R) + ' ' + band(B + R)} fill={hot} fill-opacity="0.85"></path>
    <text x="10" y="194" font-size="12" fill={hot}>payload {kN(ig.skirt)} → {kN(bo.skirt)} kN</text>
    <text x="310" y="194" text-anchor="end" font-size="12" fill={hot}>thrust {kN(pl.F)} kN</text>
    <text x="10" y="280" font-size="12" fill={ink}>the motor's own inertia: {kN(ig.motor)} → {kN(bo.motor)} kN</text>
    <text x="10" y="297" font-size="12" fill={muted}>ignition → burnout, thrust at MEOP</text>
  </svg>
  <figcaption>
    Pressure pushes on every inside surface, and nearly all of it balances: the case wall holds the two ends together.
    Only the throat has no wall facing it, so the forward dome is pushed harder than the aft end — the difference is the
    thrust, {pl.ratio.toFixed(0)} times smaller than the end loads. It runs forward through the case wall and skirt,
    shedding the motor's own inertia (the grain's through its bond) on the way, and what is left pushes the payload.
  </figcaption>
</figure>
