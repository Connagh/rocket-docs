---
// Three classic grain cross-sections and the thrust–time shape each tends to give.
const R = 62, cx = 80, cy = 80;
const star = (n: number, rt: number, rv: number) =>
  Array.from({ length: 2 * n }, (_, k) => {
    const r = k % 2 ? rv : rt, a = (k * Math.PI) / n - Math.PI / 2;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const slots = Array.from({ length: 6 }, (_, k) => (k * 360) / 6);
const panels = [
  { x: 0, title: 'Progressive', sub: 'Tube: the port only grows', curve: 'M30,250 C90,238 150,215 210,196 L222,280' },
  { x: 250, title: 'Neutral', sub: 'Star: points shrink, bore grows', curve: 'M30,212 C70,205 160,205 200,210 Q215,214 222,280' },
  { x: 500, title: 'Regressive', sub: 'Slots: area falls as they open', curve: 'M30,192 C80,200 150,232 200,250 L222,280' },
];
---

<figure class="viz">
  <p class="viz-title">Port shape sets the thrust–time curve</p>
  <svg viewBox="0 0 750 330" role="img" aria-labelledby="gp-desc">
    <desc id="gp-desc">
      Three grain cross-sections with sketched thrust histories. A circular tube port gives rising, progressive thrust. A
      star port gives roughly flat, neutral thrust. A core with long radial slots gives falling, regressive thrust.
    </desc>
    {panels.map((p, i) => (
      <g transform={`translate(${p.x} 0)`}>
        <text x="125" y="18" text-anchor="middle" font-size="14" font-weight="600" fill="var(--rd-ink)">{p.title}</text>
        <g transform="translate(45 22)">
          <circle cx={cx} cy={cy} r={R + 3} fill="var(--rd-steel)"></circle>
          <circle cx={cx} cy={cy} r={R} fill="var(--rd-propellant)"></circle>
          {i === 0 && <circle cx={cx} cy={cy} r="30" fill="var(--rd-hot)" fill-opacity="0.55"></circle>}
          {i === 1 && <polygon points={star(7, 46, 20)} fill="var(--rd-hot)" fill-opacity="0.55"></polygon>}
          {i === 2 && (
            <g fill="var(--rd-hot)" fill-opacity="0.55">
              <circle cx={cx} cy={cy} r="18"></circle>
              {slots.map((a) => <rect x={cx} y={cy - 4} width="52" height="8" transform={`rotate(${a} ${cx} ${cy})`}></rect>)}
            </g>
          )}
        </g>
        <line x1="30" y1="280" x2="230" y2="280" stroke="var(--rd-muted)"></line>
        <line x1="30" y1="180" x2="30" y2="280" stroke="var(--rd-muted)"></line>
        <path d={p.curve} fill="none" stroke="var(--rd-accent)" stroke-width="3"></path>
        <text x="130" y="298" text-anchor="middle" font-size="11" fill="var(--rd-muted)">time →</text>
        <text x="22" y="230" text-anchor="middle" font-size="11" fill="var(--rd-muted)" transform="rotate(-90 22 230)">thrust</text>
        <text x="125" y="320" text-anchor="middle" font-size="12" fill="var(--rd-muted)">{p.sub}</text>
      </g>
    ))}
  </svg>
  <figcaption>
    Sketches, not results: proportions matter as much as the family. A star can be tuned progressive, neutral or
    regressive by its point count, depth and angle. Use the simulator below to see real numbers.
  </figcaption>
</figure>
