---
// The pressure "ladder" every motor case is judged against. Schematic: the bars show order, not
// size, and no factor values are given — those come from the programme's governing requirement.
const rows = [
  { label: 'Nominal operating', note: 'typical day, nominal grain', f: 0.78, color: 'var(--rd-muted)', tag: 'below MEOP' },
  { label: 'MEOP', note: 'hot day + worst tolerances + spikes', f: 1.0, color: 'var(--rd-ink)', tag: 'reference' },
  { label: 'Proof', note: 'every case: no yield, no leak', f: 1.14, color: 'var(--rd-blue)', tag: 'MEOP × k', sub: 'proof' },
  { label: 'Design burst', note: 'minimum ultimate capability', f: 1.28, color: 'var(--rd-accent)', tag: 'MEOP × k', sub: 'burst' },
  { label: 'Demonstrated burst', note: 'qualification test to failure', f: 1.42, color: 'var(--rd-accent)', tag: '≥ design burst', dashed: true },
];
const X0 = 250, S = 300, H = 46;
---

<figure class="viz">
  <p class="viz-title">The pressure ladder: schematic, not to scale</p>
  <svg viewBox={`0 0 800 ${rows.length * H + 40}`} role="img" aria-labelledby="ladder-desc">
    <desc id="ladder-desc">
      Bar chart of the pressures a motor case is designed against, in increasing order: nominal operating pressure, maximum
      expected operating pressure (MEOP), proof pressure (MEOP times the proof factor), design burst pressure (MEOP times
      the burst factor), and the burst pressure demonstrated by qualification testing. Not to scale.
    </desc>
    <line x1={X0 + S} y1="6" x2={X0 + S} y2={rows.length * H + 10} stroke="var(--rd-line)" stroke-dasharray="4 4"></line>
    <text x={X0 + S} y={rows.length * H + 28} text-anchor="middle" font-size="11" fill="var(--rd-muted)">MEOP</text>
    {rows.map((r, i) => {
      const y = 14 + i * H;
      return (
        <g>
          <text x={X0 - 14} y={y + 12} text-anchor="end" font-size="13" font-weight="600" fill="var(--rd-ink)">{r.label}</text>
          <text x={X0 - 14} y={y + 28} text-anchor="end" font-size="11" fill="var(--rd-muted)">{r.note}</text>
          <rect x={X0} y={y} width={r.f * S} height="24" rx="3"
            fill={r.dashed ? 'none' : r.color} fill-opacity={r.dashed ? 0 : 0.85}
            stroke={r.color} stroke-width="2" stroke-dasharray={r.dashed ? '6 4' : undefined}></rect>
          <text x={X0 + r.f * S + 8} y={y + 17} font-size="12" fill="var(--rd-ink)">{r.tag}{r.sub && <tspan dy="4" font-size="9">{r.sub}</tspan>}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>
    Everything is referenced to MEOP. The proof and burst factors, k<sub>proof</sub> and k<sub>burst</sub>, come from your
    governing requirement, not from this chart, a textbook, or a previous programme. Bar lengths show order only.
  </figcaption>
</figure>
