---
// One sampling length of a ground surface, filtered, with the parameters drawn on it: the mean line, ±Ra, the highest
// peak and deepest valley (Rt), and a cut level c below the highest peak with the material that it cuts (Rmr(c)).
import { makeProfile, gaussianFilter, roughnessParams, materialRatio } from '../lib/surface';

const dx = 0.0005, lc = 0.8;
const r = gaussianFilter(makeProfile({ kind: 'ground', rq: 0.5, length: 5.6, dx, seed: 3 }), dx, lc).roughness;
const p = roughnessParams(r, dx, lc);
const seg = Array.from(r.slice(0, Math.round(lc / dx)));
const top = Math.max(...seg), bot = Math.min(...seg), c = 0.4 * (top - bot), cut = top - c;
const mr = materialRatio(seg, c);
const L = 36, R = 344, T = 34, B = 176, H = Math.max(top, -bot) * 1.1;
const X = (i: number) => L + (i / (seg.length - 1)) * (R - L), Y = (v: number) => (T + B) / 2 - (v / H) * ((B - T) / 2);
const step = Math.ceil(seg.length / 360);
const line = seg.filter((_, i) => i % step === 0).map((v, k) => `${X(k * step).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
// the parts of the profile above the cut level, as horizontal bars at that level
const bars: [number, number][] = [];
let start = -1;
seg.forEach((v, i) => { if (v >= cut && start < 0) start = i; if ((v < cut || i === seg.length - 1) && start >= 0) { bars.push([start, i]); start = -1; } });
const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', blue = 'var(--rd-blue)', hot = 'var(--rd-accent)';
---

<figure class="viz sfp">
  <p class="viz-title">One sampling length of a ground surface</p>
  <svg viewBox="0 0 360 232" role="img" aria-labelledby="sfp-desc" style="max-width: 440px; margin: 0 auto;">
    <desc id="sfp-desc">
      A roughness profile 0.8 mm long, after the filter. The mean line is at zero. Dashed lines at plus and minus Ra show
      the average height. The highest peak and the deepest valley set Rt. A cut level below the highest peak cuts through
      the peaks; the length of material at that level, as a fraction of the profile, is the material ratio.
    </desc>
    <line x1={L} x2={R} y1={Y(0)} y2={Y(0)} stroke={ink} stroke-opacity="0.7"></line>
    <line x1={L} x2={R} y1={Y(p.Ra)} y2={Y(p.Ra)} stroke={blue} stroke-dasharray="5 4"></line>
    <line x1={L} x2={R} y1={Y(-p.Ra)} y2={Y(-p.Ra)} stroke={blue} stroke-dasharray="5 4"></line>
    <line x1={L} x2={R} y1={Y(top)} y2={Y(top)} stroke={muted} stroke-dasharray="2 3"></line>
    <line x1={L} x2={R} y1={Y(bot)} y2={Y(bot)} stroke={muted} stroke-dasharray="2 3"></line>
    <polyline points={line} fill="none" stroke={ink} stroke-width="1.3"></polyline>
    <line x1={L} x2={R} y1={Y(cut)} y2={Y(cut)} stroke={hot} stroke-opacity="0.6"></line>
    {bars.map(([a, b]) => <line x1={X(a)} x2={X(b)} y1={Y(cut)} y2={Y(cut)} stroke={hot} stroke-width="5"></line>)}
    <path d={`M${R + 6},${Y(top)} L${R + 6},${Y(bot)}`} stroke={muted} marker-start="url(#sfp-a)" marker-end="url(#sfp-a)"></path>
    <defs><marker id="sfp-a" viewBox="0 0 8 8" refX="4" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" fill={muted}></path></marker></defs>
    <text x={L} y="16" font-size="13" fill={hot}>cut level c: Rmr(c) = {Math.round(mr * 100)}%</text>
    <text x={R - 2} y={Y(-p.Ra) + 16} text-anchor="end" font-size="13" fill={blue}>±Ra = {p.Ra.toFixed(2)} µm</text>
    <text x={L} y="200" font-size="13" fill={muted}>peak to valley Rt = {(top - bot).toFixed(2)} µm</text>
    <text x={L} y="222" font-size="13" fill={ink}>Rz (mean of 5 lengths) = {p.Rz.toFixed(2)} µm</text>
    <text x="30" y={Y(0) + 4} text-anchor="end" font-size="13" fill={muted}>0</text>
  </svg>
  <figcaption>
    Ra is the mean distance of the profile from its mean line. Rz is the mean peak-to-valley height of five sampling
    lengths. Rmr(c) is the fraction of the length that is solid at a depth c below the highest peak: the red bars. Two
    surfaces with the same Ra can have very different peaks, and the peaks decide how a seal or a fit behaves.
  </figcaption>
</figure>
