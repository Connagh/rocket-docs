---
// Metallic motor case / pressure vessel screening calculator (Cast UI island: src/tools/CaseSizing.tsx).
import CaseSizing from '../tools/CaseSizing';
import { materialGroups } from '../tools/materialOptions';
import { MATERIALS, DEFAULTS as D, type Material } from '../lib/materials';

// Case alloys: the steel, stainless, titanium, aluminium and nickel entries of the material library with yield and
// ultimate, best specific strength first in each family.
const FAMILIES = ['steel', 'ss', 'ti', 'al', 'ni'];
const raw = (m: Material) => ({ key: m.key, name: m.name, family: m.family, spec: m.spec, uts: m.Ftu!, yield: m.Fty!, density: m.rho! / 1000,
  kic: m.kic, kicIsFamilyDefault: m.kicDefault, maxServiceTemp: m.maxT, weldable: m.weldable });
const metals = MATERIALS.filter((m) => FAMILIES.includes(m.family) && m.Ftu! > 0 && m.Fty! > 0 && m.rho)
  .sort((a, b) => b.Ftu! / b.rho! - a.Ftu! / a.rho!).map(raw);
---

<CaseSizing client:visible groups={materialGroups(metals)} mats={Object.fromEntries(metals.map((m) => [m.key, m]))} defaultMat={D.caseSteel} />
