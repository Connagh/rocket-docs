---
// The five idealisations of a hand calc, each with a schematic and the formulas it gives. Not to scale.
const steel = 'var(--rd-blue)', hot = 'var(--rd-accent)', ink = 'var(--rd-ink)', muted = 'var(--rd-muted)';
const head = (x: number, y: number, dx: number, dy: number) => {
  const l = Math.hypot(dx, dy), ux = dx / l, uy = dy / l;
  return `M${x - ux * 6 - uy * 3.5},${y - uy * 6 + ux * 3.5} L${x},${y} L${x - ux * 6 + uy * 3.5},${y - uy * 6 - ux * 3.5}`;
};
const arrow = (x1: number, y1: number, x2: number, y2: number) => `M${x1},${y1} L${x2},${y2} ${head(x2, y2, x2 - x1, y2 - y1)}`;
---

<figure class="viz hcs">
  <p class="viz-title">Five idealisations — schematic</p>
  <div class="hcs-grid">
    <svg viewBox="0 0 200 150" role="img" aria-label="Beam: a simply supported beam with a central load and its deflected shape. Bending stress M over Z, shear VQ over Ib, deflection PL cubed over 48 EI.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Beam</text>
      <rect x="20" y="50" width="160" height="10" fill={steel} fill-opacity="0.35" stroke={steel}></rect>
      <path d="M26,60 L19,72 L33,72 Z M174,60 L167,72 L181,72 Z" fill="none" stroke={muted} stroke-width="1.4"></path>
      <path d={arrow(100, 22, 100, 47)} fill="none" stroke={hot} stroke-width="1.8"></path>
      <text x="106" y="34" font-size="11" fill={hot}>P</text>
      <path d="M26,55 Q100,86 174,55" fill="none" stroke={hot} stroke-dasharray="4 3" stroke-width="1.4"></path>
      <text x="8" y="100" font-size="11" fill={ink}>σ = M/Z · τ = VQ/Ib</text>
      <text x="8" y="117" font-size="11" fill={ink}>δ = PL³/48EI</text>
      <text x="8" y="140" font-size="10" fill={muted}>bound it: pinned and fixed</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label="Flat plate: a plate under uniform pressure on simple supports. Simply supported circular plate, centre stress 1.24 q a squared over t squared; clamped, edge stress 0.75 q a squared over t squared. Valid while deflection is under half the thickness.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Flat plate</text>
      {[30, 50, 70, 90, 110, 130, 150, 170].map((x) => <path d={arrow(x, 30, x, 47)} fill="none" stroke={hot} stroke-width="1.3"></path>)}
      <text x="184" y="40" font-size="11" fill={hot}>q</text>
      <rect x="20" y="50" width="160" height="8" fill={steel} fill-opacity="0.35" stroke={steel}></rect>
      <path d="M24,58 L17,70 L31,70 Z M176,58 L169,70 L183,70 Z" fill="none" stroke={muted} stroke-width="1.4"></path>
      <path d="M24,54 Q100,84 176,54" fill="none" stroke={hot} stroke-dasharray="4 3" stroke-width="1.4"></path>
      <text x="8" y="100" font-size="11" fill={ink}>SS: σ = 1.24 qa²/t²</text>
      <text x="8" y="117" font-size="11" fill={ink}>fixed: σ = 0.75 qa²/t²</text>
      <text x="8" y="140" font-size="10" fill={muted}>valid while w &lt; t/2</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label="Thin shell: a cylinder wall growing outward under pressure, held at a stiff flange, so it bends near the edge over a zone about 2.4 root r t long. Hoop stress pr over t, axial pr over 2t; a clamped edge adds bending of 1.55 pr over t.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Thin shell</text>
      <rect x="14" y="34" width="16" height="54" fill={steel} fill-opacity="0.55" stroke={steel}></rect>
      <line x1="30" y1="70" x2="188" y2="70" stroke={muted} stroke-dasharray="3 3"></line>
      <path d="M30,70 C52,70 62,56 88,56 L188,56" fill="none" stroke={steel} stroke-width="2.6"></path>
      {[120, 150, 180].map((x) => <path d={arrow(x, 84, x, 63)} fill="none" stroke={hot} stroke-width="1.3"></path>)}
      <path d="M30,42 L88,42 M30,38 L30,46 M88,38 L88,46" fill="none" stroke={ink} stroke-width="1"></path>
      <text x="96" y="46" font-size="10" fill={ink}>≈ 2.4√(rt)</text>
      <text x="8" y="106" font-size="11" fill={ink}>σθ = pr/t · σx = pr/2t</text>
      <text x="8" y="123" font-size="11" fill={ink}>clamped edge: +1.55 pr/t</text>
      <text x="8" y="140" font-size="10" fill={muted}>membrane away from edges</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label="Lug and pin: a lug with a pin in its hole, pulled by a load P. Five checks: net tension, shear-out, bearing, pin shear and pin bending.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Lug and pin</text>
      <path d="M36,40 L130,40 A22,22 0 0 1 130,84 L36,84 Z" fill={steel} fill-opacity="0.35" stroke={steel}></path>
      <circle cx="130" cy="62" r="9" fill="var(--rd-panel)" stroke={steel}></circle>
      <circle cx="130" cy="62" r="7.5" fill={hot} fill-opacity="0.85"></circle>
      <path d={arrow(36, 62, 10, 62)} fill="none" stroke={hot} stroke-width="1.8"></path>
      <text x="12" y="56" font-size="11" fill={hot}>P</text>
      <path d="M130,40 L130,52 M130,72 L130,84" stroke={ink} stroke-dasharray="2 2"></path>
      <path d="M139,57 L152,57 M139,67 L152,67" stroke={ink} stroke-dasharray="2 2"></path>
      <text x="8" y="106" font-size="11" fill={ink}>net · shear-out · bearing</text>
      <text x="8" y="123" font-size="11" fill={ink}>pin shear · pin bending</text>
      <text x="8" y="140" font-size="10" fill={muted}>pin bending often governs</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label="Column: a pinned strut under end load, bowing sideways as it buckles. Euler load pi squared EI over KL squared; short columns follow the Johnson parabola below a slenderness of pi root 2E over Fty; a crooked column needs the secant formula.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Column</text>
      <path d={arrow(172, 6, 172, 27)} fill="none" stroke={hot} stroke-width="1.8"></path>
      <line x1="172" y1="32" x2="172" y2="124" stroke={steel} stroke-width="4" stroke-opacity="0.6"></line>
      <path d="M172,32 Q146,78 172,124" fill="none" stroke={hot} stroke-dasharray="4 3" stroke-width="1.4"></path>
      <circle cx="172" cy="32" r="4" fill="var(--rd-panel)" stroke={ink}></circle>
      <circle cx="172" cy="124" r="4" fill="var(--rd-panel)" stroke={ink}></circle>
      <path d="M172,128 L164,140 L180,140 Z" fill="none" stroke={muted} stroke-width="1.4"></path>
      <text x="8" y="44" font-size="11" fill={ink}>Pcr = π²EI/(KL)²</text>
      <text x="8" y="68" font-size="11" fill={ink}>short: Johnson,</text>
      <text x="8" y="85" font-size="11" fill={ink}>KL/r &lt; π√(2E/Fty)</text>
      <text x="8" y="117" font-size="10" fill={muted}>crooked: secant</text>
      <text x="8" y="134" font-size="10" fill={muted}>K = 1 pinned–pinned</text>
    </svg>
  </div>
  <figcaption>
    Every hand calc starts by deciding what the part is. Each idealisation brings its formulas, boundary conditions to
    bound between, and limits beyond which it stops being true.
  </figcaption>
</figure>

<style>
  .hcs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr)); gap: 0.75rem 1rem; }
  .hcs-grid > * { margin: 0 !important; }
  .hcs-grid svg { max-width: 270px; margin: 0 auto !important; }
</style>
