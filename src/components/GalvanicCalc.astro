---
// Galvanic corrosion in three tabs: one couple on the anodic index ladder; every contact of a joint stack; and a
// screening estimate of the attack on the anode from the area ratio. The environment limits are the usual design
// guidance; a programme limit, when entered, replaces them. Maths in src/lib/galvanic.ts (unit-tested); UI only here.
import { METALS, ENVIRONMENTS, ANODES } from '../lib/galvanic';

const TABS = [{ key: 'pair', name: 'Two metals' }, { key: 'joint', name: 'Joint stack' }, { key: 'rate', name: 'Area & attack' }];
const STACK = ['ti', 'ss18', 'al', 'steel', '']; // the worked example: titanium bolt, stainless washer, Al closure, steel flange
const STACK_LABELS = ['Fastener', 'Washer or insert', 'Part 1', 'Part 2', 'Part 3 (optional)'];
const opts = (sel: string, blank = false) => [
  ...(blank ? [{ key: '', name: '(none)', index: NaN }] : []), ...METALS,
].map((m) => ({ ...m, sel: m.key === sel }));
---

<div class="calc gvcalc" data-gvcalc>
  <div class="calc-head"><span>Galvanic corrosion</span><span>anodic index · joint · area ratio</span></div>
  <div class="hc-tabs" role="tablist" aria-label="Galvanic check">
    {TABS.map((t, i) => <button type="button" role="tab" class="chip" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.name}</button>)}
  </div>
  <div class="calc-body">
    <form data-form onsubmit="return false">
      <fieldset data-panel="pair">
        <legend>Two metals in contact</legend>
        <label>Metal or finish A<select name="p_a">{opts('al').map((m) => <option value={m.key} selected={m.sel}>{m.name}</option>)}</select></label>
        <label>Metal or finish B<select name="p_b">{opts('ss18').map((m) => <option value={m.key} selected={m.sel}>{m.name}</option>)}</select></label>
        <div class="row2">
          <label>Environment<select name="p_env">{ENVIRONMENTS.map((e) => <option value={e.key} selected={e.key === 'normal'}>{e.name} ({e.limit.toFixed(2)} V)</option>)}</select></label>
          <label>Programme limit (V)<input name="p_lim" type="number" min="0" step="0.01" placeholder="optional" autocomplete="off" /></label>
        </div>
        <p class="hint">Harsh: salt spray, outdoors, unprotected. Normal: sheltered, humidity not controlled. Controlled: sealed, temperature and humidity controlled. Use the finish that is in contact: a plated bolt is its plating, not its base metal. An anodized or painted surface breaks the contact only while the film is intact.</p>
      </fieldset>

      <fieldset data-panel="joint" hidden>
        <legend>The joint, in the order of contact</legend>
        {STACK.map((k, i) => (
          <label>{STACK_LABELS[i]}<select name={`j_${i}`}>{opts(k, i >= 1).map((m) => <option value={m.key} selected={m.sel}>{m.name}</option>)}</select></label>
        ))}
        <div class="row2">
          <label>Environment<select name="j_env">{ENVIRONMENTS.map((e) => <option value={e.key} selected={e.key === 'normal'}>{e.name} ({e.limit.toFixed(2)} V)</option>)}</select></label>
          <label>Programme limit (V)<input name="j_lim" type="number" min="0" step="0.01" placeholder="optional" autocomplete="off" /></label>
        </div>
        <p class="hint">Each item touches the next one. Leave an item as "(none)" to remove it. An isolating washer or sleeve breaks the contact: leave it out of the stack and check the two sides apart.</p>
      </fieldset>

      <fieldset data-panel="rate" hidden>
        <legend>Area ratio and attack (screening)</legend>
        <div class="row2">
          <label>Anode metal<select name="r_an">{ANODES.map((a) => <option value={a.key} selected={a.key === 'steel'}>{a.name}</option>)}</select></label>
          <label>Wetted cathode area (cm²)<input name="r_ac" type="number" min="0" step="any" value="20" /></label>
          <label>Wetted anode area (cm²)<input name="r_aa" type="number" min="0.001" step="any" value="2" /></label>
          <label>Cathode current density (µA/cm²)<input name="r_ic" type="number" min="0" step="any" value="10" /></label>
          <label>Time of wetness (%)<input name="r_wet" type="number" min="0" max="100" step="any" value="10" /></label>
          <label>Exposure (years)<input name="r_y" type="number" min="0" step="any" value="10" /></label>
          <label>Wall or coating to protect (mm)<input name="r_t" type="number" min="0" step="any" value="1.377" /></label>
        </div>
        <p class="hint">Defaults: the steel case at a damaged bond edge, next to the CFRP skirt. The cathode current density is the oxygen-reduction rate on the cathode: approximately 5 to 30 µA/cm² in aerated water. Wetted areas, not part areas: in a thin film the cell works only a few millimetres from the joint.</p>
      </fieldset>
    </form>
    <div>
      <dl class="readouts" data-out></dl>
      <figure class="hc-fig">
        <svg viewBox="0 0 420 250" data-chart role="img" aria-label="Chart for the selected galvanic check"></svg>
        <figcaption data-cap></figcaption>
      </figure>
      <ul class="pv-notes" data-notes></ul>
    </div>
  </div>
  <div class="calc-foot">
    Anodic index in seawater relative to gold, after MIL-STD-889 and MIL-F-14072. Environment limits: usual design guidance.
    Attack: cathode-limited current, Faraday's law, uniform over the wetted anode area. Local pits and crevices can be
    much deeper. A screen, not a corrosion test.
  </div>
</div>

<style is:global>
  .hc-tabs { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.75rem 1rem 0; }
  .hc-tabs > * { margin: 0 !important; }
  .calc .hc-tabs button.chip[aria-selected='true'] { border-color: var(--rd-accent); color: var(--rd-accent); background: color-mix(in srgb, var(--rd-accent) 12%, transparent); }
  .gvcalc .readout dd small { display: block; margin-top: 0.15rem; }
  .gvcalc fieldset > label { display: block; margin-bottom: 0.5rem; }
  .gvcalc select { max-width: 100%; }
  .hc-fig { margin: 0.9rem 0 0 !important; }
  .hc-fig svg { width: 100%; height: auto; font-family: var(--sl-font-mono); }
  .hc-fig figcaption { font-size: var(--sl-text-xs); color: var(--rd-muted); }
  .gvcalc .pv-notes { font-size: var(--sl-text-sm); margin-top: 0.75rem !important; padding-left: 1.1rem; }
</style>

<script>
  import { METALS, ENVIRONMENTS, ANODES, metal, couple, checkJoint, galvanicAttack } from '../lib/galvanic';

  const NS = 'http://www.w3.org/2000/svg';
  const f = (v: number, d = 2) => (Number.isFinite(v) ? v.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d }) : '–');
  const g3 = (v: number) => (Math.abs(v) >= 100 ? f(v, 0) : Math.abs(v) >= 10 ? f(v, 1) : Math.abs(v) >= 1 ? f(v, 2) : Math.abs(v) >= 0.01 ? f(v, 3) : v.toExponential(1));
  const short = (k: string) => metal(k)?.short ?? k;
  type Row = { dt: string; dd: string; cls?: string; primary?: boolean };

  document.querySelectorAll<HTMLElement>('[data-gvcalc]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
    const num = (n: string) => (field(n).value.trim() === '' ? NaN : +field(n).value);
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(a)) e.setAttribute(k, String(v));
      if (text !== undefined) e.textContent = text;
      svg.append(e);
      return e;
    };
    const size = () => Math.round(Math.min(420, Math.max(300, svg.clientWidth || 420)));
    const txt = (x: number, y: number, s: string, c = 'var(--rd-ink)', anchor = 'start', fs = 12) => el('text', { x, y, 'text-anchor': anchor, 'font-size': fs, fill: c, stroke: 'var(--rd-panel)', 'stroke-width': 3, 'paint-order': 'stroke' }, s);
    const limitOf = (env: string, lim: string) => {
      const own = num(lim), e = ENVIRONMENTS.find((x) => x.key === field(env).value)!;
      return own >= 0 ? { v: own, src: 'your programme limit' } : { v: e.limit, src: `usual guidance, ${e.name.toLowerCase()} environment (${e.desc})` };
    };
    let mode = 'pair';
    let draw: (() => void) | null = null;

    // the anodic index ladder, with the selected metals marked and a band of ± the limit around the cathode
    function ladder(marks: string[], limit: number, cathode?: number) {
      svg.replaceChildren();
      const W = size(), H = 250, L = 40, R = 12, T = 24, B = 34;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const X = (v: number) => L + (v / 1.8) * (W - L - R), y0 = H - B;
      for (const v of [0, 0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75]) {
        el('line', { x1: X(v), x2: X(v), y1: T, y2: y0, stroke: 'var(--rd-line)' });
        el('text', { x: X(v), y: y0 + 14, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, f(v, 2));
      }
      if (cathode !== undefined) el('rect', { x: X(cathode), y: T, width: Math.max(1, X(Math.min(1.8, cathode + limit)) - X(cathode)), height: y0 - T, fill: 'var(--rd-ok)', 'fill-opacity': 0.14 });
      METALS.forEach((m, i) => el('circle', { cx: X(m.index), cy: T + 8 + (i % 4) * 6, r: 2.5, fill: 'var(--rd-muted)' }));
      const seen = new Map<number, number>();
      marks.forEach((k, i) => {
        const m = metal(k); if (!m) return;
        const lvl = seen.get(m.index) ?? 0; seen.set(m.index, lvl + 1);
        const x = X(m.index), y = T + 52 + i * 34 + lvl * 4;
        el('line', { x1: x, x2: x, y1: T, y2: y0, stroke: 'var(--rd-blue)', 'stroke-width': 2 });
        txt(x > W * 0.6 ? x - 6 : x + 6, y, short(k), 'var(--rd-ink)', x > W * 0.6 ? 'end' : 'start');
      });
      el('text', { x: L, y: 14, 'font-size': 11, fill: 'var(--rd-ok)' }, `green: up to ${f(limit, 2)} V from the most noble`);
      el('text', { x: (L + W - R) / 2, y: H - 4, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'anodic index (V): noble ← → anodic');
    }

    function runPair(rows: Row[], notes: [string, string][]) {
      const a = field('p_a').value, b = field('p_b').value, c = couple(a, b)!, lim = limitOf('p_env', 'p_lim'), ok = c.dV <= lim.v + 1e-9;
      rows.push(
        { dt: 'Potential difference', dd: `${f(c.dV, 2)} V <small>limit ${f(lim.v, 2)} V: ${lim.src}</small>`, primary: true, cls: ok ? 'ok' : 'bad' },
        { dt: 'Anode', dd: c.anode ? `${short(c.anode.key)} <small>this side corrodes; ${short(c.cathode!.key)} is protected</small>` : 'none <small>the same index: no galvanic drive</small>' },
      );
      if (!ok) notes.push(['bad', 'Above the limit: break the cell. Keep the water out (sealant, wet installation, drainage), isolate the metals (washer, sleeve, barrier ply), or change a finish to bring the two indices closer.']);
      if (c.anode && ['steel', 'al', 'al2', 'mg'].includes(c.anode.key)) notes.push(['', 'Coat the cathode, or both. Never coat only the anode: a small damage in the coating becomes a small anode next to a large cathode.']);
      if ([a, b].includes('cfrp')) notes.push(['warn', 'Carbon fibre is a good cathode and conducts. Put a glass-fibre ply or an adhesive film between CFRP and aluminium or steel, and use titanium or stainless fasteners with sealant.']);
      if ([a, b].includes('steel')) notes.push(['', 'Bare carbon and low-alloy steel rusts without a second metal. It needs its own protection (plating, primer, oil or a controlled environment) in any case.']);
      const ca = c.cathode ?? metal(a)!;
      return () => ladder([a, b], lim.v, ca.index);
    }

    function runJoint(rows: Row[], notes: [string, string][]) {
      const stack = Array.from({ length: 5 }, (_, i) => field(`j_${i}`).value).filter(Boolean), lim = limitOf('j_env', 'j_lim');
      const j = checkJoint(stack, lim.v);
      if (!j.pairs.length) { notes.push(['bad', 'Select at least two items in contact.']); return null; }
      rows.push({ dt: 'Joint', dd: `${j.ok ? 'every contact passes' : 'a contact fails'} <small>limit ${f(lim.v, 2)} V: ${lim.src}</small>`, primary: true, cls: j.ok ? 'ok' : 'bad' });
      j.pairs.forEach((p) => rows.push({ dt: `${short(p.a)} / ${short(p.b)}`, dd: `${f(p.dV, 2)} V <small>${p.anode ? `${short(p.anode.key)} is the anode` : 'no drive'}</small>`, cls: p.ok ? '' : 'bad' }));
      if (!j.ok) notes.push(['bad', `The worst contact is ${short(j.worst!.a)} / ${short(j.worst!.b)}. Change that item, isolate that contact, or keep the water out of it.`]);
      notes.push(['', 'The fastener is in the faying surfaces, the hole and the head. Install it wet with sealant, and seal the edges of the joint, so that no electrolyte can bridge two metals.']);
      return () => ladder(stack, lim.v, Math.min(...stack.map((k) => metal(k)!.index)));
    }

    function runRate(rows: Row[], notes: [string, string][]) {
      const an = field('r_an').value, wet = (num('r_wet') || 0) / 100, t = num('r_t');
      const r = galvanicAttack({ anode: an, cathodeArea: num('r_ac'), anodeArea: num('r_aa'), ic: num('r_ic'), wet, years: num('r_y') || 0 });
      if (!r || !Number.isFinite(r.rate)) { notes.push(['bad', 'Enter the two wetted areas, the current density and the time of wetness.']); return null; }
      const share = t > 0 ? r.depth / t : NaN;
      rows.push(
        { dt: 'Attack on the anode', dd: `${g3(r.depth)} mm <small>in ${f(num('r_y') || 0, 0)} years · ${g3(r.rate)} mm/year</small>`, primary: true, cls: share >= 0.5 ? 'bad' : share >= 0.1 ? 'warn' : 'ok' },
        { dt: 'Area ratio', dd: `${g3(r.ratio)} <small>cathode ÷ anode · anode current ${g3(r.ia)} µA/cm² while wet</small>` },
        { dt: 'Faraday', dd: `${f(r.perUnit, 4)} mm/year <small>for each µA/cm² on ${ANODES.find((a) => a.key === an)!.name.toLowerCase()}</small>` },
      );
      if (t > 0) rows.push({ dt: 'Share of the wall or coating', dd: `${f(100 * share, 0)}% <small>of ${g3(t)} mm</small>`, cls: share >= 0.5 ? 'bad' : '' });
      if (r.ratio > 10) notes.push(['warn', 'A large cathode next to a small anode: the attack concentrates. Make the anode the large part, or coat the cathode.']);
      if (r.ratio < 0.1) notes.push(['', 'A small cathode in a large anode: the current spreads, and the galvanic attack is small. A steel or titanium fastener in an aluminium part is usually this case.']);
      notes.push(['', 'A uniform estimate. Real attack concentrates at the edge of the contact, in crevices and at coating damage, and can be several times deeper. Confirm with a corrosion test (for example salt spray to ASTM B117 or a cyclic test) on the real joint.']);
      return () => {
        svg.replaceChildren();
        const W = size(), H = 250, L = 52, R = 14, T = 26, B = 40;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const lo = -2, hi = 3, X = (v: number) => L + ((Math.log10(v) - lo) / (hi - lo)) * (W - L - R);
        const per = r.rate / Math.max(r.ratio, 1e-12), dmax = Math.max(r.depth * 2, t || 0, 1e-6) * 1.1;
        const Y = (d: number) => H - B - (Math.min(d, dmax) / dmax) * (H - B - T);
        for (const v of [0.01, 0.1, 1, 10, 100, 1000]) { el('line', { x1: X(v), x2: X(v), y1: T, y2: H - B, stroke: 'var(--rd-line)' }); el('text', { x: X(v), y: H - B + 14, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-muted)' }, String(v)); }
        const pts = Array.from({ length: 101 }, (_, i) => 10 ** (lo + ((hi - lo) * i) / 100)).map((q) => `${X(q).toFixed(1)},${Y(per * q * (num('r_y') || 0)).toFixed(1)}`);
        el('polyline', { points: pts.join(' '), fill: 'none', stroke: 'var(--rd-blue)', 'stroke-width': 2.2 });
        if (t > 0) { el('line', { x1: L, x2: W - R, y1: Y(t), y2: Y(t), stroke: 'var(--rd-accent)', 'stroke-dasharray': '5 3' }); txt(L + 4, Y(t) - 5, `${g3(t)} mm to protect`, 'var(--rd-accent)'); }
        el('circle', { cx: X(Math.max(0.01, Math.min(1000, r.ratio))), cy: Y(r.depth), r: 5, fill: 'var(--rd-accent)', stroke: 'var(--rd-panel)', 'stroke-width': 1.5 });
        el('text', { x: 12, y: (T + H - B) / 2, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)', transform: `rotate(-90 12 ${(T + H - B) / 2})` }, 'attack (mm)');
        el('text', { x: L - 4, y: T + 4, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--rd-muted)' }, g3(dmax));
        el('text', { x: L - 4, y: H - B, 'text-anchor': 'end', 'font-size': 11, fill: 'var(--rd-muted)' }, '0');
        el('text', { x: (L + W - R) / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 11, fill: 'var(--rd-ink)' }, 'area ratio, cathode ÷ anode (log)');
      };
    }

    const RUN: Record<string, typeof runPair> = { pair: runPair, joint: runJoint, rate: runRate };
    const CAPS: Record<string, string> = {
      pair: 'The anodic index of each metal (grey dots) and the two selected ones. A metal in the green band is close enough to the cathode for the selected limit.',
      joint: 'The metals of the joint on the anodic index scale. Each contact must stay within the limit; the green band starts at the most noble item.',
      rate: 'Attack on the anode after the exposure time against the area ratio, for the same current density. The dot is your case.',
    };

    function run() {
      const rows: Row[] = [], notes: [string, string][] = [];
      draw = RUN[mode](rows, notes);
      root.querySelector('[data-out]')!.innerHTML = rows.map((r) => `<div class="readout${r.primary ? ' primary' : ''}${r.cls ? ` ${r.cls}` : ''}"><dt>${r.dt}</dt><dd>${r.dd}</dd></div>`).join('');
      root.querySelector('[data-notes]')!.innerHTML = notes.map(([c, x]) => `<li class="${c}">${x}</li>`).join('');
      root.querySelector('[data-cap]')!.textContent = CAPS[mode];
      if (draw) draw(); else svg.replaceChildren();
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      mode = key;
      tabs.forEach((b) => { const on = b.dataset.tab === key; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== key));
      run();
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.tab!));
      b.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
        if (d) { ev.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
    if ('ResizeObserver' in window) {
      let w = 0;
      new ResizeObserver(([e]) => { const nw = Math.round(e.contentRect.width); if (draw && Math.abs(nw - w) > 8) { w = nw; draw(); } }).observe(svg);
    }
    let timer = 0;
    form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 200); });
    form.addEventListener('change', run);
    run();
  });
</script>
