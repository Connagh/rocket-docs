---
// Four typical residual-stress profiles, schematic: across a weld (Masubuchi–Martin shape), below a shot-peened surface,
// through a quenched plate of a non-transforming alloy, and through the wall of an autofrettaged tube (computed with
// src/lib/residual.ts for the page's worked example). Shapes, not values for any particular part.
import { autofrettage } from '../lib/residual';

const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', hot = 'var(--rd-accent)', cold = 'var(--rd-blue)';
const X0 = 16, X1 = 190, TOP = 30, BOT = 108;
type Panel = { title: string; fn: (x: number) => number; x0: number; x1: number; y0: number; y1: number; notes: [string, string]; marks: { x: number; label: string; anchor?: string; dy?: number; color: string }[]; band?: [number, number]; aria: string };

const af = autofrettage(5, 12.5, 1000, 650);
const panels: Panel[] = [
  { title: 'Weld', fn: (x) => (1 - x * x) * Math.exp(-(x * x) / 2), x0: -4.5, x1: 4.5, y0: -0.6, y1: 1.15, band: [-0.6, 0.6],
    notes: ['stress along the weld', 'compression either side'],
    marks: [{ x: 0.85, label: '≈ yield', anchor: 'start', dy: -26, color: hot }],
    aria: 'Across a weld: longitudinal tension near yield in the weld and heat-affected zone, falling to compression on either side and to zero far away.' },
  { title: 'Shot-peened surface', fn: (z) => -0.62 * (1 + 3 * z) * Math.exp(-((z / 0.2) ** 2)) + 0.07 * (1 - Math.exp(-((z / 0.25) ** 2))), x0: 0, x1: 1, y0: -0.8, y1: 0.3,
    notes: ['depth: 0 to about 1 mm', 'small tension below'],
    marks: [{ x: 0.06, label: 'compression', anchor: 'start', dy: 0, color: cold }],
    aria: 'Below a shot-peened surface: compression of a large fraction of yield in the first few tenths of a millimetre, peaking just below the surface, balanced by a small tension underneath.' },
  { title: 'Quenched plate', fn: (s) => 1 - 3 * s * s, x0: -1, x1: 1, y0: -2.3, y1: 1.4,
    notes: ['through the thickness', 'surface cooled first'],
    marks: [{ x: 0, label: 'core tension', anchor: 'middle', dy: -10, color: hot }],
    aria: 'Through a quenched plate of a non-transforming alloy such as aluminium: compression at both surfaces and tension in the core.' },
  { title: 'Autofrettaged tube', fn: (r) => af.residual(r).st, x0: 5, x1: 12.5, y0: -650, y1: 250,
    notes: ['hoop stress, bore to outside', 'yielded once, then unloaded'],
    marks: [{ x: 8.2, label: `bore: ${Math.round(af.boreHoop)} MPa`, anchor: 'start', dy: 36, color: cold }],
    aria: `Through the wall of an autofrettaged tube: hoop compression of ${Math.round(-af.boreHoop)} MPa at the bore, rising to a small tension towards the outside.` },
];
const path = (p: Panel) => {
  const X = (x: number) => X0 + ((x - p.x0) / (p.x1 - p.x0)) * (X1 - X0), Y = (v: number) => TOP + ((p.y1 - v) / (p.y1 - p.y0)) * (BOT - TOP);
  const pts = Array.from({ length: 121 }, (_, i) => p.x0 + ((p.x1 - p.x0) * i) / 120).map((x) => `${X(x).toFixed(1)},${Y(p.fn(x)).toFixed(1)}`);
  return { d: `M${pts.join(' L')}`, X, Y };
};
---

<figure class="viz rsp">
  <p class="viz-title">Four residual-stress profiles — schematic</p>
  <div class="rsp-grid">
    {panels.map((p) => {
      const { d, X, Y } = path(p);
      const zero = Y(0);
      return (
        <svg viewBox="0 0 200 150" role="img" aria-label={p.aria}>
          <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>{p.title}</text>
          {p.band && <rect x={X(p.band[0])} y={TOP} width={X(p.band[1]) - X(p.band[0])} height={BOT - TOP} fill={hot} fill-opacity="0.08"></rect>}
          <rect x={X0} y={TOP} width={X1 - X0} height={zero - TOP} fill={hot} fill-opacity="0.05"></rect>
          <rect x={X0} y={zero} width={X1 - X0} height={BOT - zero} fill={cold} fill-opacity="0.06"></rect>
          <line x1={X0} x2={X1} y1={zero} y2={zero} stroke={ink} stroke-opacity="0.5"></line>
          <path d={d} fill="none" stroke={ink} stroke-width="2"></path>
          <text x="8" y={TOP + 10} text-anchor="middle" font-size="12" font-weight="600" fill={hot}>+</text>
          <text x="8" y={BOT - 2} text-anchor="middle" font-size="12" font-weight="600" fill={cold}>−</text>
          {p.marks.map((m) => {
            const y = Y(p.fn(m.x));
            return <text x={X(m.x) + (m.anchor === 'start' ? 6 : 0)} y={y + (m.dy ?? 0) + (y < zero ? 2 : 12)} text-anchor={m.anchor ?? 'middle'} font-size="11" fill={m.color} stroke="var(--rd-panel)" stroke-width="3" paint-order="stroke">{m.label}</text>;
          })}
          <text x="8" y="127" font-size="11" fill={ink}>{p.notes[0]}</text>
          <text x="8" y="143" font-size="10" fill={muted}>{p.notes[1]}</text>
        </svg>
      );
    })}
  </div>
  <figcaption>
    Typical shapes, not values for your part: tension above the line, compression below. Every profile balances itself: with no load on the part, the force and
    moment across any cut add up to zero, so tension in one place always means compression somewhere else.
  </figcaption>
</figure>

<style>
  .rsp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr)); gap: 0.75rem 1rem; }
  .rsp-grid > * { margin: 0 !important; }
  .rsp-grid svg { max-width: 270px; margin: 0 auto !important; }
</style>
