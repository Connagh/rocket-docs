---
// Four ways a material card goes wrong, as small schematic charts: engineering data entered as true, a temperature table
// that stops short of the model, Poisson's ratio for a nearly incompressible material, and instantaneous expansion
// coefficients entered as secant ones. The last two use src/lib/feacards.ts with the page's worked-example values.
import { expansion, poissonFromEK } from '../lib/feacards';

const ink = 'var(--rd-ink)', muted = 'var(--rd-muted)', hot = 'var(--rd-accent)', cold = 'var(--rd-blue)';
const X0 = 16, X1 = 190, TOP = 30, BOT = 108;
const map = (x0: number, x1: number, y0: number, y1: number) => ({
  X: (x: number) => X0 + ((x - x0) / (x1 - x0)) * (X1 - X0),
  Y: (y: number) => TOP + ((y1 - y) / (y1 - y0)) * (BOT - TOP),
});
const line = (m: ReturnType<typeof map>, fn: (x: number) => number, a: number, b: number, n = 80) =>
  'M' + Array.from({ length: n + 1 }, (_, i) => a + ((b - a) * i) / n).map((x) => `${m.X(x).toFixed(1)},${m.Y(fn(x)).toFixed(1)}`).join(' L');

// A: a normalised steel curve — engineering stress peaks at necking, true stress keeps rising
const engA = (e: number) => (e < 0.0042 ? (0.85 * e) / 0.0042 : e <= 0.05 ? 0.85 + 0.15 * (1 - (1 - (e - 0.0042) / 0.0458) ** 2) : 1 - 60 * (e - 0.05) ** 2);
const truA = (e: number) => (e <= 0.05 ? engA(e) * (1 + e) : 1.05 + 2.4 * (e - 0.05));
const mA = map(0, 0.1, 0, 1.25);
// B: yield strength against temperature — data to 100 °C, model to 300 °C
const yB = (T: number) => 1 - 0.0009 * (T - 20) - 0.0000035 * Math.max(0, T - 100) ** 2;
const mB = map(-50, 300, 0.5, 1.15);
// C: K/G against ν, on a log scale
const kg = (nu: number) => (2 * (1 + nu)) / (3 * (1 - 2 * nu));
const mC = map(0.4, 0.5, 0, 4);
const nuP = poissonFromEK(3.6, 3500);
// D: thermal strain of the worked example's aluminium, 20 → 150 °C
const al = expansion(-50, 21e-6, 150, 25e-6);
const mD = map(20, 150, 0, 3.4);
const sD = (T: number) => al.strain(20, T) * 1000, iD = (T: number) => al.inst(T) * (T - 20) * 1000;
---

<figure class="viz ctr">
  <p class="viz-title">Four ways a card goes wrong: schematic</p>
  <div class="ctr-grid">
    <svg viewBox="0 0 200 150" role="img" aria-label="Engineering and true stress–strain curves: engineering stress peaks at necking and falls; true stress keeps rising. A card's table ends at necking and the solver holds the last stress flat beyond it.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Engineering or true?</text>
      <path d={line(mA, engA, 0, 0.1)} fill="none" stroke={cold} stroke-width="2"></path>
      <path d={line(mA, truA, 0, 0.1)} fill="none" stroke={hot} stroke-width="2"></path>
      <path d={`M${mA.X(0.05)},${mA.Y(1.05)} L${mA.X(0.1)},${mA.Y(1.05)}`} fill="none" stroke={ink} stroke-dasharray="3 3"></path>
      <circle cx={mA.X(0.05)} cy={mA.Y(1.05)} r="3" fill={ink}></circle>
      <text x={mA.X(0.1)} y={mA.Y(1.2) - 2} text-anchor="end" font-size="11" fill={hot}>true</text>
      <text x={mA.X(0.1)} y={mA.Y(0.82) + 12} text-anchor="end" font-size="11" fill={cold}>engineering</text>
      <text x="8" y="127" font-size="11" fill={ink}>enter true stress</text>
      <text x="8" y="143" font-size="10" fill={muted}>beyond the table: held flat</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label="Yield strength against temperature: the card has data from minus 50 to 100 degrees; the model reaches 300 degrees and the solver holds the 100 degree value, while the real strength keeps falling.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Outside the table</text>
      <rect x={mB.X(100)} y={TOP} width={X1 - mB.X(100)} height={BOT - TOP} fill={hot} fill-opacity="0.06"></rect>
      <path d={line(mB, yB, 100, 300)} fill="none" stroke={muted} stroke-width="1.6" stroke-dasharray="2 3"></path>
      <path d={`M${mB.X(100)},${mB.Y(yB(100))} L${mB.X(300)},${mB.Y(yB(100))}`} fill="none" stroke={hot} stroke-width="2" stroke-dasharray="5 3"></path>
      <path d={line(mB, yB, -50, 100)} fill="none" stroke={cold} stroke-width="2"></path>
      {[-50, 20, 100].map((T) => <circle cx={mB.X(T)} cy={mB.Y(yB(T))} r="3.2" fill={cold}></circle>)}
      <text x={mB.X(300)} y={mB.Y(yB(100)) - 6} text-anchor="end" font-size="11" fill={hot}>solver</text>
      <text x={mB.X(300)} y={mB.Y(yB(300)) + 13} text-anchor="end" font-size="11" fill={muted}>real</text>
      <text x={mB.X(-50) + 2} y={mB.Y(yB(-50)) - 7} font-size="11" fill={cold}>card data</text>
      <text x="8" y="127" font-size="11" fill={ink}>cover the model's range</text>
      <text x="8" y="143" font-size="10" fill={muted}>ends are held, not extended</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label={`Bulk-to-shear modulus ratio against Poisson's ratio, on a log scale: about 50 at 0.49, rising steeply to about ${Math.round(kg(nuP) / 100) * 100} for propellant at ${nuP.toFixed(4)}.`}>
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Nearly incompressible</text>
      {[1, 2, 3].map((d) => <line x1={X0} x2={X1} y1={mC.Y(d)} y2={mC.Y(d)} stroke="var(--rd-line)"></line>)}
      {[1, 2, 3].map((d) => <text x={X0 + 2} y={mC.Y(d) - 3} font-size="10" fill={muted}>{`10${'¹²³'[d - 1]}`}</text>)}
      <path d={line(mC, (nu) => Math.log10(kg(nu)), 0.4, 0.49985, 120)} fill="none" stroke={ink} stroke-width="2"></path>
      <circle cx={mC.X(0.49)} cy={mC.Y(Math.log10(kg(0.49)))} r="3.5" fill={hot}></circle>
      <circle cx={mC.X(nuP)} cy={mC.Y(Math.log10(kg(nuP)))} r="3.5" fill={cold}></circle>
      <text x={mC.X(0.49) - 6} y={mC.Y(Math.log10(kg(0.49))) - 12} text-anchor="end" font-size="11" fill={hot}>ν 0.49: K/G 50</text>
      <text x={mC.X(nuP) - 8} y={mC.Y(Math.log10(kg(nuP))) + 4} text-anchor="end" font-size="11" fill={cold}>propellant</text>
      <text x="8" y="127" font-size="11" fill={ink}>K/G against ν</text>
      <text x="8" y="143" font-size="10" fill={muted}>set ν from a measured K</text>
    </svg>

    <svg viewBox="0 0 200 150" role="img" aria-label="Thermal strain of an aluminium part from 20 to 150 degrees: the correct curve from secant coefficients, and a steeper one when instantaneous coefficients are entered as secant, about 5 per cent high at 150 degrees.">
      <text x="8" y="16" font-size="12" font-weight="600" fill={ink}>Secant or instantaneous?</text>
      <path d={line(mD, iD, 20, 150)} fill="none" stroke={hot} stroke-width="2" stroke-dasharray="5 3"></path>
      <path d={line(mD, sD, 20, 150)} fill="none" stroke={cold} stroke-width="2"></path>
      <text x={mD.X(20) + 4} y={TOP + 10} font-size="11" fill={hot}>instantaneous</text>
      <text x={mD.X(20) + 4} y={TOP + 27} font-size="11" fill={hot}>as secant</text>
      <text x={mD.X(150)} y={BOT - 28} text-anchor="end" font-size="11" fill={cold}>correct</text>
      <text x="8" y="127" font-size="11" fill={ink}>thermal strain, 20→150 °C</text>
      <text x="8" y="143" font-size="10" fill={muted}>secant, from a stated reference</text>
    </svg>
  </div>
  <figcaption>
    None of these stops the solver: each runs, converges and gives a plausible-looking answer. The checks on this page are
    how they get caught.
  </figcaption>
</figure>

<style>
  .ctr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr)); gap: 0.75rem 1rem; }
  .ctr-grid > * { margin: 0 !important; }
  .ctr-grid svg { max-width: 270px; margin: 0 auto !important; }
</style>
